---
---

<!-- Estilos del Asistente Interactivo y Efecto Spotlight -->
<style is:global>
	/* Botón flotante de Don Terra con Paleta Aero-Agrícola */
	.ts-assistant-fab {
		position: fixed;
		bottom: 20px;
		right: 20px;
		z-index: 1060;
		display: flex;
		align-items: center;
		gap: 10px;
		background: linear-gradient(135deg, #071428 0%, #123562 100%);
		color: #ffffff;
		border: 2px solid #f5b041;
		border-radius: 999px;
		padding: 10px 18px;
		box-shadow: 0 8px 24px rgba(7, 20, 40, 0.48);
		cursor: pointer;
		font-weight: 700;
		font-size: 0.9rem;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.ts-assistant-fab:hover {
		transform: translateY(-3px) scale(1.02);
		box-shadow: 0 12px 28px rgba(245, 176, 65, 0.45);
	}
	.ts-assistant-avatar {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: #f5b041;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 1.25rem;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
	}

	/* Resaltado Spotlight sobre el elemento activo del DOM */
	@keyframes tsSpotlightPulse {
		0% {
			box-shadow: 0 0 0 4px #f5b041, 0 0 0 10px rgba(56, 189, 248, 0.35), 0 12px 32px rgba(0, 0, 0, 0.35);
		}
		50% {
			box-shadow: 0 0 0 5px #38bdf8, 0 0 0 16px rgba(245, 176, 65, 0.25), 0 12px 32px rgba(0, 0, 0, 0.35);
		}
		100% {
			box-shadow: 0 0 0 4px #f5b041, 0 0 0 10px rgba(56, 189, 248, 0.35), 0 12px 32px rgba(0, 0, 0, 0.35);
		}
	}
	.ts-spotlight-target {
		position: relative !important;
		z-index: 1055 !important;
		border-radius: 0.65rem;
		animation: tsSpotlightPulse 1.8s infinite ease-in-out !important;
		background-color: #ffffff;
	}

	/* Panel flotante del Asistente */
	.ts-assistant-card {
		position: fixed;
		bottom: 82px;
		right: 20px;
		width: 410px;
		max-width: calc(100vw - 28px);
		z-index: 1065;
		border-radius: 1rem;
		border: 2px solid #0d2647;
		background: #ffffff;
		box-shadow: 0 16px 40px rgba(7, 20, 40, 0.35);
		overflow: hidden;
		transition: all 0.22s ease;
	}
	.ts-assistant-header {
		background: linear-gradient(135deg, #071428 0%, #123562 100%);
		border-bottom: 2px solid #f5b041;
		color: #ffffff;
		padding: 12px 16px;
	}
	.ts-mission-box {
		background: #fff8e6;
		border: 1px solid #ffecb5;
		border-left: 4px solid #ffc107;
		border-radius: 0.5rem;
		padding: 8px 12px;
		font-size: 0.82rem;
		color: #664d03;
	}
	.ts-mission-box.completed {
		background: #d1e7dd;
		border-color: #a3cfbb;
		border-left: 4px solid #198754;
		color: #0f5132;
	}
	@keyframes tsAutoAdvanceBar {
		from {
			width: 0%;
		}
		to {
			width: 100%;
		}
	}
	.ts-auto-advance-progress {
		height: 4px;
		background: rgba(25, 135, 84, 0.2);
		border-radius: 99px;
		overflow: hidden;
		margin-top: 8px;
	}
	.ts-auto-advance-fill {
		height: 100%;
		background: linear-gradient(90deg, #198754, #0284c7);
		animation: tsAutoAdvanceBar 2.2s linear forwards;
	}
	.ts-step-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.35);
		display: inline-block;
		transition: all 0.2s ease;
	}
	.ts-step-dot.active {
		width: 24px;
		border-radius: 99px;
		background: #ffffff;
	}
	.ts-step-dot.done {
		background: #a3cfbb;
	}
	.ts-faq-btn {
		text-align: left;
		font-size: 0.8rem;
		font-weight: 600;
		border-radius: 0.5rem;
		transition: background 0.15s ease;
	}
	.ts-header-ctrl-btn {
		background: rgba(255, 255, 255, 0.14);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 0.45rem;
		padding: 2px 8px;
		font-size: 0.74rem;
		font-weight: 700;
		line-height: 1.2;
		cursor: pointer;
		transition: background 0.15s ease;
	}
	.ts-header-ctrl-btn:hover {
		background: rgba(245, 176, 65, 0.3);
		border-color: #f5b041;
	}
	.ts-why-toggle-btn {
		background: #eef4fb;
		color: #0d2647;
		border: 1px solid #93c5fd;
		border-radius: 999px;
		padding: 1px 8px;
		font-size: 0.7rem;
		font-weight: 700;
		cursor: pointer;
		flex-shrink: 0;
	}

	/* Estado Plegado / Minimizado (Barra mínima de ~42px en la base) */
	.ts-assistant-card.ts-minimized #asistente-subbarra,
	.ts-assistant-card.ts-minimized #vista-tour,
	.ts-assistant-card.ts-minimized #vista-capsulas {
		display: none !important;
	}

	/* OPTIMIZACIÓN COMPACTA PARA MÓVIL (<= 767.98px: Mini-Dock Inferior ~20% de pantalla) */
	@media (max-width: 767.98px) {
		.ts-assistant-fab {
			bottom: 10px;
			right: 10px;
			padding: 7px 12px;
			font-size: 0.78rem;
			gap: 6px;
		}
		.ts-assistant-fab .ts-assistant-avatar {
			width: 26px;
			height: 26px;
			font-size: 0.95rem;
		}
		.ts-assistant-card {
			bottom: 8px;
			left: 8px;
			right: 8px;
			width: auto;
			max-width: none;
			border-radius: 0.85rem;
			box-shadow: 0 10px 28px rgba(7, 20, 40, 0.42);
		}
		.ts-assistant-header {
			padding: 7px 10px;
		}
		.ts-assistant-header .ts-assistant-avatar {
			width: 26px;
			height: 26px;
			font-size: 0.95rem;
		}
		#asistente-subtitulo {
			display: none !important;
		}
		#asistente-subbarra {
			padding: 4px 10px !important;
		}
		#asistente-subbarra .btn {
			font-size: 0.72rem !important;
			padding: 2px 7px !important;
		}
		#vista-tour {
			padding: 8px 10px !important;
		}
		#tour-step-title {
			font-size: 0.84rem !important;
			margin-bottom: 0 !important;
		}
		/* En móvil ocultamos el párrafo largo por defecto y se muestra solo al tocar "ℹ️ ¿Por qué?" */
		#tour-step-desc {
			display: none;
			font-size: 0.74rem !important;
			margin-top: 4px;
			margin-bottom: 6px !important;
		}
		#tour-step-desc.ts-desc-expanded {
			display: block !important;
		}
		.ts-mission-box {
			padding: 6px 9px;
			font-size: 0.75rem;
			margin-bottom: 6px !important;
		}
		#vista-capsulas {
			padding: 8px 10px !important;
			max-height: 35vh;
			overflow-y: auto;
		}
	}
	@media (min-width: 768px) {
		.ts-why-toggle-btn {
			display: none !important;
		}
	}
</style>

<!-- Botón Flotante (FAB) accesible cuando el panel está cerrado -->
<button
	type="button"
	id="btn-assistant-fab"
	class="ts-assistant-fab"
	title="Abrir asistente interactivo Don Terra"
>
	<span class="ts-assistant-avatar">🧑‍🌾</span>
	<span>Guía Interactiva</span>
	<span class="badge bg-warning text-dark rounded-pill" id="badge-fab-paso">Aprende fácil</span>
</button>

<!-- Ventana Flotante / Mini-Dock del Asistente "Don Terra" -->
<div id="panel-asistente" class="ts-assistant-card d-none" role="dialog" aria-label="Asistente Don Terra">
	<!-- Encabezado del Asistente con botón de Plegar/Minimizar y Cerrar -->
	<div class="ts-assistant-header d-flex justify-content-between align-items-center gap-2">
		<div class="d-flex align-items-center gap-2" style="min-width: 0;">
			<span class="ts-assistant-avatar flex-shrink-0">🧑‍🌾</span>
			<div class="text-truncate">
				<div class="fw-bold text-truncate" style="font-size: 0.88rem; line-height: 1.15;" id="asistente-titulo-header">
					Don Terra — Tu Agrónomo Guía
				</div>
				<small class="text-white-50" style="font-size: 0.72rem;" id="asistente-subtitulo">
					Aprende a planificar tu siembra paso a paso
				</small>
			</div>
		</div>
		<div class="d-flex align-items-center gap-1 flex-shrink-0">
			<span class="badge border d-md-none" style="background: rgba(245,176,65,0.2); color: #f5b041; border-color: rgba(245,176,65,0.5) !important; font-size: 0.68rem;" id="badge-progreso-movil">
				1/6
			</span>
			<button
				type="button"
				id="btn-minimizar-asistente"
				class="ts-header-ctrl-btn"
				title="Plegar o expandir panel para ver mejor el mapa"
			>
				🔽 Plegar
			</button>
			<button
				type="button"
				id="btn-cerrar-asistente"
				class="btn-close btn-close-white ms-1"
				style="font-size: 0.75rem;"
				aria-label="Cerrar asistente"
			></button>
		</div>
	</div>

	<!-- Pestañas internas del Asistente: [1] Tour Paso a Paso | [2] Cápsulas Didácticas -->
	<div id="asistente-subbarra" class="bg-light border-bottom px-3 py-1 d-flex justify-content-between align-items-center">
		<div class="btn-group btn-group-sm" role="group">
			<button type="button" id="btn-modo-tour" class="btn ts-btn-space btn-sm fw-semibold py-1">
				🎯 Tour Paso a Paso (6)
			</button>
			<button type="button" id="btn-modo-capsulas" class="btn btn-outline-secondary btn-sm fw-semibold py-1">
				💡 Cápsulas Agronómicas
			</button>
		</div>
		<span class="badge border d-none d-md-inline-block" style="background: #eef4fb; color: #0d2647; border-color: #93c5fd !important;" id="badge-progreso-tour">
			Paso 1 / 6
		</span>
	</div>

	<!-- CONTENIDO MODO 1: TOUR GUIADO INTERACTIVO -->
	<div id="vista-tour" class="p-3">
		<div class="d-flex justify-content-between align-items-center gap-2 mb-1">
			<h3 class="h6 fw-bold mb-0" style="color: #0d2647;" id="tour-step-title">
				📍 Paso 1: Elige tu Lote en el Mapa Satelital
			</h3>
			<button type="button" id="btn-toggle-explicacion" class="ts-why-toggle-btn">
				ℹ️ ¿Por qué?
			</button>
		</div>

		<p class="small text-secondary mb-2" id="tour-step-desc" style="line-height: 1.4;">
			El mapa muestra imágenes satelitales reales. Cuando haces clic en un punto, TerraSoft verifica si es tierra cultivable y consulta el clima histórico de la NASA.
		</p>

		<!-- Caja de Micro-Misión Interactiva ("Aprende Haciendo") -->
		<div id="tour-mission-box" class="ts-mission-box mb-3">
			<div class="fw-bold mb-1" id="tour-mission-title">🎯 Tu Misión Interactiva:</div>
			<div id="tour-mission-text">
				Haz clic sobre un lote verde o de tierra arada en el mapa (o pincha sobre una carretera para ver cómo te alerta).
			</div>
		</div>

		<!-- Indicador de progreso y controles de navegación (avance automático por misión) -->
		<div class="d-flex justify-content-between align-items-center pt-2 border-top">
			<button type="button" id="btn-tour-prev" class="btn btn-outline-secondary btn-sm fw-semibold" disabled>
				⬅ Anterior
			</button>

			<div class="d-flex gap-1 align-items-center" id="tour-dots-container"></div>

			<span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">
				⚡ Avance automático
			</span>
		</div>
	</div>

	<!-- CONTENIDO MODO 2: CÁPSULAS DIDÁCTICAS ("PREGÚNTALE A DON TERRA") -->
	<div id="vista-capsulas" class="p-3 d-none">
		<p class="small text-muted mb-2">
			Selecciona una pregunta para entender cómo la ciencia agronómica y los satélites te ayudan a tomar mejores decisiones:
		</p>

		<div class="d-grid gap-2 mb-3">
			<button type="button" class="btn btn-outline-primary ts-faq-btn p-2" style="color: #0d2647; border-color: #93c5fd;" data-capsule="nitrogeno">
				🌱 ¿Cómo me ahorra dinero sembrar Frijol, Arveja o Soya?
			</button>
			<button type="button" class="btn btn-outline-primary ts-faq-btn p-2" style="color: #0d2647; border-color: #93c5fd;" data-capsule="monocultivo">
				🧬 ¿Por qué es peligroso repetir el mismo cultivo (Monocultivo)?
			</button>
			<button type="button" class="btn btn-outline-primary ts-faq-btn p-2" style="color: #0d2647; border-color: #93c5fd;" data-capsule="satelite">
				🛰️ ¿Cómo detecta TerraSoft carreteras, glaciares y clima NASA?
			</button>
			<button type="button" class="btn btn-outline-primary ts-faq-btn p-2" style="color: #0d2647; border-color: #93c5fd;" data-capsule="calendario">
				📅 ¿Cómo leer el semáforo de fecha actual y el calendario?
			</button>
		</div>

		<div id="caja-respuesta-capsula" class="p-2 px-3 rounded border small text-dark" style="background: #eef4fb; border-color: #93c5fd !important;">
			<strong>💡 Consejo de Don Terra:</strong> Haz clic en cualquiera de las preguntas de arriba para ver una explicación clara y aplicada a tu parcela.
		</div>
	</div>
</div>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const fabBtn = document.getElementById('btn-assistant-fab');
		const navTourBtn = document.getElementById('btn-abrir-tutorial-nav');
		const panelAsistente = document.getElementById('panel-asistente');
		const cerrarBtn = document.getElementById('btn-cerrar-asistente');
		const minimizarBtn = document.getElementById('btn-minimizar-asistente');
		const toggleExplicacionBtn = document.getElementById('btn-toggle-explicacion');

		const btnModoTour = document.getElementById('btn-modo-tour');
		const btnModoCapsulas = document.getElementById('btn-modo-capsulas');
		const vistaTour = document.getElementById('vista-tour');
		const vistaCapsulas = document.getElementById('vista-capsulas');
		const badgeProgreso = document.getElementById('badge-progreso-tour');
		const badgeProgresoMovil = document.getElementById('badge-progreso-movil');
		const badgeFabPaso = document.getElementById('badge-fab-paso');
		const tituloHeader = document.getElementById('asistente-titulo-header');

		const stepTitle = document.getElementById('tour-step-title');
		const stepDesc = document.getElementById('tour-step-desc');
		const missionBox = document.getElementById('tour-mission-box');
		const missionTitle = document.getElementById('tour-mission-title');
		const missionText = document.getElementById('tour-mission-text');
		const btnPrev = document.getElementById('btn-tour-prev');
		const dotsContainer = document.getElementById('tour-dots-container');
		const cajaCapsula = document.getElementById('caja-respuesta-capsula');

		// Definición de las 6 Estaciones Didácticas del Tour en el Dashboard Principal de Control Unificado
		const ESTACIONES_TOUR = [
			{
				id: 'mapa',
				selector: '#terrasync-map',
				titulo: '📍 Estación 1: Elige tu Lote en el Mapa Satelital',
				descripcion:
