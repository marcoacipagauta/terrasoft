---

<!-- Estilos del Asistente Interactivo y Efecto Spotlight -->
<style is:global>
	/* Botón flotante de Don Terra con Paleta Aero-Agrícola */
	.ts-assistant-fab {
		position: fixed;
		bottom: 20px;
		right: 20px;
		z-index: 1060;
		display: flex;
		align-items: center;
		gap: 10px;
		background: linear-gradient(135deg, #071428 0%, #123562 100%);
		color: #ffffff;
		border: 2px solid #f5b041;
		border-radius: 999px;
		padding: 10px 18px;
		box-shadow: 0 8px 24px rgba(7, 20, 40, 0.48);
		cursor: pointer;
		font-weight: 700;
		font-size: 0.9rem;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.ts-assistant-fab:hover {
		transform: translateY(-3px) scale(1.02);
		box-shadow: 0 12px 28px rgba(245, 176, 65, 0.45);
	}
	.ts-assistant-avatar {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: #f5b041;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 1.25rem;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
	}

	/* Resaltado Spotlight sobre el elemento activo del DOM */
	@keyframes tsSpotlightPulse {
		0% {
			box-shadow: 0 0 0 4px #f5b041, 0 0 0 10px rgba(56, 189, 248, 0.35), 0 12px 32px rgba(0, 0, 0, 0.35);
		}
		50% {
			box-shadow: 0 0 0 5px #38bdf8, 0 0 0 16px rgba(245, 176, 65, 0.25), 0 12px 32px rgba(0, 0, 0, 0.35);
		}
		100% {
			box-shadow: 0 0 0 4px #f5b041, 0 0 0 10px rgba(56, 189, 248, 0.35), 0 12px 32px rgba(0, 0, 0, 0.35);
		}
	}
	.ts-spotlight-target {
		position: relative !important;
		z-index: 1055 !important;
		border-radius: 0.65rem;
		animation: tsSpotlightPulse 1.8s infinite ease-in-out !important;
	}

	/* Panel flotante del Asistente */
	.ts-assistant-card {
		position: fixed;
		bottom: 82px;
		right: 20px;
		width: 410px;
		max-width: calc(100vw - 28px);
		z-index: 1065;
		border-radius: 1rem;
		border: 2px solid #0d2647;
		background: #ffffff;
		box-shadow: 0 16px 40px rgba(7, 20, 40, 0.35);
		overflow: hidden;
		transition: all 0.22s ease;
	}
	.ts-assistant-header {
		background: linear-gradient(135deg, #071428 0%, #123562 100%);
		border-bottom: 2px solid #f5b041;
		color: #ffffff;
		padding: 12px 16px;
	}
	.ts-mission-box {
		background: #fff8e6;
		border: 1px solid #ffecb5;
		border-left: 4px solid #ffc107;
		border-radius: 0.5rem;
		padding: 8px 12px;
		font-size: 0.82rem;
		color: #664d03;
	}
	.ts-mission-box.completed {
		background: #d1e7dd;
		border-color: #a3cfbb;
		border-left: 4px solid #198754;
		color: #0f5132;
	}
	@keyframes tsAutoAdvanceBar {
		from {
			width: 0%;
		}
		to {
			width: 100%;
		}
	}
	.ts-auto-advance-progress {
		height: 4px;
		background: rgba(25, 135, 84, 0.2);
		border-radius: 99px;
		overflow: hidden;
		margin-top: 8px;
	}
	.ts-auto-advance-fill {
		height: 100%;
		background: linear-gradient(90deg, #198754, #0284c7);
		animation: tsAutoAdvanceBar 2.2s linear forwards;
	}
	.ts-step-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.35);
		display: inline-block;
		transition: all 0.2s ease;
	}
	.ts-step-dot.active {
		width: 24px;
		border-radius: 99px;
		background: #ffffff;
	}
	.ts-step-dot.done {
		background: #a3cfbb;
	}
	.ts-faq-btn {
		text-align: left;
		font-size: 0.8rem;
		font-weight: 600;
		border-radius: 0.5rem;
		transition: background 0.15s ease;
	}
	.ts-header-ctrl-btn {
		background: rgba(255, 255, 255, 0.14);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 0.45rem;
		padding: 2px 8px;
		font-size: 0.74rem;
		font-weight: 700;
		line-height: 1.2;
		cursor: pointer;
		transition: background 0.15s ease;
	}
	.ts-header-ctrl-btn:hover {
		background: rgba(245, 176, 65, 0.3);
		border-color: #f5b041;
	}
	.ts-why-toggle-btn {
		background: #eef4fb;
		color: #0d2647;
		border: 1px solid #93c5fd;
		border-radius: 999px;
		padding: 1px 8px;
		font-size: 0.7rem;
		font-weight: 700;
		cursor: pointer;
		flex-shrink: 0;
	}

	/* Estado Plegado / Minimizado (Barra mínima de ~42px en la base) */
	.ts-assistant-card.ts-minimized #asistente-subbarra,
	.ts-assistant-card.ts-minimized #vista-tour,
	.ts-assistant-card.ts-minimized #vista-capsulas {
		display: none !important;
	}

	/* OPTIMIZACIÓN COMPACTA PARA MÓVIL (<= 767.98px: Mini-Dock Inferior sin desborde horizontal en iPhone 16 / SE) */
	@media (max-width: 767.98px) {
		.ts-assistant-fab {
			bottom: 10px;
			right: 10px;
			max-width: calc(100vw - 20px);
			box-sizing: border-box;
			padding: 7px 12px;
			font-size: 0.78rem;
			gap: 6px;
		}
		.ts-assistant-fab .ts-assistant-avatar {
			width: 26px;
			height: 26px;
			font-size: 0.95rem;
			flex-shrink: 0;
		}
		.ts-assistant-card {
			bottom: 8px;
			left: 8px;
			right: 8px;
			width: calc(100vw - 16px) !important;
			max-width: calc(100% - 16px) !important;
			box-sizing: border-box !important;
			border-radius: 0.85rem;
			box-shadow: 0 10px 28px rgba(7, 20, 40, 0.42);
		}
		.ts-assistant-header {
			padding: 6px 10px;
			max-width: 100%;
		}
		.ts-assistant-header .ts-assistant-avatar {
			width: 24px;
			height: 24px;
			font-size: 0.9rem;
		}
		#asistente-titulo-header {
			font-size: 0.8rem !important;
		}
		#asistente-subtitulo {
			display: none !important;
		}
		#asistente-subbarra {
			padding: 4px 8px !important;
			max-width: 100%;
		}
		#asistente-subbarra .btn-group {
			width: 100%;
			display: flex;
		}
		#asistente-subbarra .btn {
			flex: 1 1 0%;
			min-width: 0;
			font-size: 0.71rem !important;
			padding: 3px 6px !important;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		#vista-tour {
			padding: 8px 10px !important;
			max-width: 100%;
			box-sizing: border-box;
		}
		#tour-step-title {
			font-size: 0.81rem !important;
			line-height: 1.25 !important;
			margin-bottom: 0 !important;
			min-width: 0;
			flex: 1 1 0%;
			overflow-wrap: anywhere;
			word-break: break-word;
		}
		/* En móvil ocultamos el párrafo largo por defecto y se muestra solo al tocar "ℹ️ ¿Por qué?" */
		#tour-step-desc {
			display: none;
			font-size: 0.74rem !important;
			margin-top: 4px;
			margin-bottom: 6px !important;
			overflow-wrap: anywhere;
			word-break: break-word;
		}
		#tour-step-desc.ts-desc-expanded {
			display: block !important;
		}
		.ts-mission-box {
			padding: 6px 9px;
			font-size: 0.74rem;
			margin-bottom: 6px !important;
			max-width: 100%;
			overflow-wrap: anywhere;
			word-break: break-word;
		}
		.ts-step-dot {
			width: 8px;
			height: 8px;
		}
		.ts-step-dot.active {
			width: 18px;
		}
		#vista-capsulas {
			padding: 8px 10px !important;
			max-height: 35vh;
			overflow-y: auto;
			max-width: 100%;
			box-sizing: border-box;
		}
		.ts-faq-btn {
			white-space: normal !important;
			overflow-wrap: anywhere;
			word-break: break-word;
			font-size: 0.75rem;
		}
	}
	@media (min-width: 768px) {
		.ts-why-toggle-btn {
			display: none !important;
		}
	}
</style>

<!-- Botón Flotante (FAB) accesible cuando el panel está cerrado -->
<button
	type="button"
	id="btn-assistant-fab"
	class="ts-assistant-fab"
	title="Abrir asistente interactivo Don Terra"
>
	<span class="ts-assistant-avatar">🧑‍🌾</span>
	<span data-i18n="fabGuideLabel">Guía Interactiva</span>
	<span class="badge bg-warning text-dark rounded-pill" id="badge-fab-paso" data-i18n="fabBadgeDefault">Aprende fácil</span>
</button>

<!-- Ventana Flotante / Mini-Dock del Asistente "Don Terra" -->
<div id="panel-asistente" class="ts-assistant-card d-none" role="dialog" aria-label="Asistente Don Terra">
	<!-- Encabezado del Asistente con botón de Plegar/Minimizar y Cerrar -->
	<div class="ts-assistant-header d-flex justify-content-between align-items-center gap-2">
		<div class="d-flex align-items-center gap-2" style="min-width: 0; flex: 1 1 0%; overflow: hidden;">
			<span class="ts-assistant-avatar flex-shrink-0">🧑‍🌾</span>
			<div style="min-width: 0; flex: 1 1 0%; overflow: hidden;">
				<div class="fw-bold text-truncate" style="font-size: 0.88rem; line-height: 1.15;" id="asistente-titulo-header" data-i18n="assistantHeaderTitle">
					Don Terra — Tu Agrónomo Guía
				</div>
				<small class="text-white-50 text-truncate d-block" style="font-size: 0.72rem;" id="asistente-subtitulo" data-i18n="assistantHeaderSub">
					Aprende a planificar tu siembra paso a paso
				</small>
			</div>
		</div>
		<div class="d-flex align-items-center gap-1 flex-shrink-0">
			<span class="badge border d-md-none" style="background: rgba(245,176,65,0.2); color: #f5b041; border-color: rgba(245,176,65,0.5) !important; font-size: 0.66rem;" id="badge-progreso-movil">
				1/6
			</span>
			<button
				type="button"
				id="btn-minimizar-asistente"
				class="ts-header-ctrl-btn"
				title="Plegar o expandir panel para ver mejor el mapa"
				data-i18n="btnFold"
			>
				🔽 Plegar
			</button>
			<button
				type="button"
				id="btn-cerrar-asistente"
				class="btn-close btn-close-white ms-1"
				style="font-size: 0.75rem;"
				aria-label="Cerrar asistente"
			></button>
		</div>
	</div>

	<!-- Pestañas internas del Asistente: [1] Tour Paso a Paso | [2] Cápsulas Didácticas -->
	<div id="asistente-subbarra" class="bg-light border-bottom px-3 py-1 d-flex justify-content-between align-items-center gap-2">
		<div class="btn-group btn-group-sm" role="group">
			<button type="button" id="btn-modo-tour" class="btn ts-btn-space btn-sm fw-semibold py-1" data-i18n="tabTourBtn">
				🎯 Tour Paso a Paso (6)
			</button>
			<button type="button" id="btn-modo-capsulas" class="btn btn-outline-secondary btn-sm fw-semibold py-1" data-i18n="tabCapsulesBtn">
				💡 Cápsulas Agronómicas
			</button>
		</div>
		<span class="badge border d-none d-md-inline-block flex-shrink-0" style="background: #eef4fb; color: #0d2647; border-color: #93c5fd !important;" id="badge-progreso-tour">
			Paso 1 / 6
		</span>
	</div>

	<!-- CONTENIDO MODO 1: TOUR GUIADO INTERACTIVO -->
	<div id="vista-tour" class="p-3">
		<div class="d-flex justify-content-between align-items-start gap-2 mb-1">
			<h3 class="h6 fw-bold mb-0" style="color: #0d2647;" id="tour-step-title">
				📍 Paso 1: Elige tu Lote en el Mapa Satelital
			</h3>
			<button type="button" id="btn-toggle-explicacion" class="ts-why-toggle-btn" data-i18n="btnWhy">
				ℹ️ ¿Por qué?
			</button>
		</div>

		<p class="small text-secondary mb-2" id="tour-step-desc" style="line-height: 1.4;">
			El mapa muestra imágenes satelitales reales. Cuando haces clic en un punto, TerraSoft verifica si es tierra cultivable y consulta el clima histórico de la NASA.
		</p>

		<!-- Caja de Micro-Misión Interactiva ("Aprende Haciendo") -->
		<div id="tour-mission-box" class="ts-mission-box mb-3">
			<div class="fw-bold mb-1" id="tour-mission-title">🎯 Tu Misión Interactiva:</div>
			<div id="tour-mission-text">
				Haz clic sobre un lote verde o de tierra arada en el mapa (o pincha sobre una carretera para ver cómo te alerta).
			</div>
		</div>

		<!-- Indicador de progreso y controles de navegación (avance automático por misión) -->
		<div class="d-flex flex-wrap justify-content-between align-items-center gap-1 pt-2 border-top">
			<button type="button" id="btn-tour-prev" class="btn btn-outline-secondary btn-sm fw-semibold py-0 px-2" style="font-size: 0.74rem;" data-i18n="btnPrevStep" disabled>
				⬅ Anterior
			</button>

			<div class="d-flex gap-1 align-items-center" id="tour-dots-container"></div>

			<span class="badge bg-light text-secondary border" style="font-size: 0.68rem;">
				⚡ <span class="d-none d-sm-inline" data-i18n="badgeAutoAdvance">Avance automático</span><span class="d-inline d-sm-none" data-i18n="badgeAutoShort">Auto</span>
			</span>
		</div>
	</div>

	<!-- CONTENIDO MODO 2: CÁPSULAS DIDÁCTICAS ("PREGÚNTALE A DON TERRA") -->
	<div id="vista-capsulas" class="p-3 d-none">
		<p class="small text-muted mb-2" data-i18n="capsulesIntro">
			Selecciona una pregunta para entender cómo la ciencia agronómica y los satélites te ayudan a tomar mejores decisiones:
		</p>

		<div class="d-grid gap-2 mb-3">
			<button type="button" class="btn btn-outline-primary ts-faq-btn p-2" style="color: #0d2647; border-color: #93c5fd;" data-capsule="nitrogeno" data-i18n="capsuleQ1">
				🌱 ¿Cómo me ahorra dinero sembrar Frijol, Arveja o Soya?
			</button>
			<button type="button" class="btn btn-outline-primary ts-faq-btn p-2" style="color: #0d2647; border-color: #93c5fd;" data-capsule="monocultivo" data-i18n="capsuleQ2">
				🧬 ¿Por qué es peligroso repetir el mismo cultivo (Monocultivo)?
			</button>
			<button type="button" class="btn btn-outline-primary ts-faq-btn p-2" style="color: #0d2647; border-color: #93c5fd;" data-capsule="satelite" data-i18n="capsuleQ3">
				🛰️ ¿Cómo detecta TerraSoft carreteras, glaciares y clima NASA?
			</button>
			<button type="button" class="btn btn-outline-primary ts-faq-btn p-2" style="color: #0d2647; border-color: #93c5fd;" data-capsule="calendario" data-i18n="capsuleQ4">
				📅 ¿Cómo leer el semáforo de fecha actual y el calendario?
			</button>
		</div>

		<div id="caja-respuesta-capsula" class="p-2 px-3 rounded border small text-dark" style="background: #eef4fb; border-color: #93c5fd !important;" data-i18n-html="capsuleDefaultTip">
			<strong>💡 Consejo de Don Terra:</strong> Haz clic en cualquiera de las preguntas de arriba para ver una explicación clara y aplicada a tu parcela.
		</div>
	</div>
</div>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const fabBtn = document.getElementById('btn-assistant-fab');
		const navTourBtn = document.getElementById('btn-abrir-tutorial-nav');
		const panelAsistente = document.getElementById('panel-asistente');
		const cerrarBtn = document.getElementById('btn-cerrar-asistente');
		const minimizarBtn = document.getElementById('btn-minimizar-asistente');
		const toggleExplicacionBtn = document.getElementById('btn-toggle-explicacion');

		const btnModoTour = document.getElementById('btn-modo-tour');
		const btnModoCapsulas = document.getElementById('btn-modo-capsulas');
		const vistaTour = document.getElementById('vista-tour');
		const vistaCapsulas = document.getElementById('vista-capsulas');
		const badgeProgreso = document.getElementById('badge-progreso-tour');
		const badgeProgresoMovil = document.getElementById('badge-progreso-movil');
		const badgeFabPaso = document.getElementById('badge-fab-paso');
		const tituloHeader = document.getElementById('asistente-titulo-header');

		const stepTitle = document.getElementById('tour-step-title');
		const stepDesc = document.getElementById('tour-step-desc');
		const missionBox = document.getElementById('tour-mission-box');
		const missionTitle = document.getElementById('tour-mission-title');
		const missionText = document.getElementById('tour-mission-text');
		const btnPrev = document.getElementById('btn-tour-prev');
		const dotsContainer = document.getElementById('tour-dots-container');
		const cajaCapsula = document.getElementById('caja-respuesta-capsula');

		// Definición de las 6 Estaciones Didácticas del Tour en el Dashboard Principal de Control Unificado
		const ESTACIONES_TOUR = [
			{
				id: 'mapa',
				selector: '#terrasync-map',
				titulo: '📍 Estación 1: Elige tu Lote en el Mapa Satelital',
				descripcion:
					'En la columna izquierda del Dashboard ves tu terreno desde el espacio y los KPIs de NASA POWER. Al hacer clic en un punto, TerraSoft verifica si hay tierra fértil o si es una carretera, edificio o glaciar.',
				mision:
					'👉 Haz clic en cualquier lote verde o tierra arada en el mapa (o pincha sobre una carretera para poner a prueba el detector).',
				completadoTexto:
					'✅ ¡Lo lograste! El satélite analizó el suelo de esa coordenada y descargó el clima de la NASA.',
				onEnter: () => {
					window.abrirDashboardTerraSoft?.();
				},
			},
			{
				id: 'cultivo',
				selector: '#grupo-selector-cultivo',
				titulo: '🌾 Estación 2: ¿Qué sembraste por última vez?',
				descripcion:
					'En la barra superior del Dashboard indicas tu cultivo actual. En agricultura nunca debemos repetir la misma familia botánica dos veces seguidas, porque las plagas quedan en el suelo.',
				mision:
					'👉 Abre el selector "🌾 Cultivo Actual" (agrupado por las 6 regiones de Colombia) y elige un cultivo.',
				completadoTexto:
					'✅ ¡Muy bien! Ahora TerraSoft penalizará cultivos de la misma familia y buscará rotaciones que corten las plagas.',
				onEnter: () => {
					window.abrirDashboardTerraSoft?.();
				},
			},
			{
				id: 'area',
				selector: '#grupo-area-lote',
				titulo: '📐 Estación 3: Indica el Tamaño de tu Lote',
				descripcion:
					'Escribe cuántos metros cuadrados (m²), fanegadas o hectáreas tiene tu terreno. TerraSoft calculará automáticamente cuánta semilla, abono y jornales necesitas en Pesos Colombianos ($ COP).',
				mision:
					'👉 Escribe un área diferente en "📐 Área del Lote" o cambia la unidad entre m², Fanegadas o Hectáreas.',
				completadoTexto:
					'✅ ¡Perfecto! Todos los costos de semilla, mano de obra y abonos se acaban de recalcular a la medida de tu lote.',
				onEnter: () => {
					window.abrirDashboardTerraSoft?.();
				},
			},
			{
				id: 'prioridad',
				selector: '[aria-label="Prioridad del próximo ciclo"]',
				titulo: '🎯 Estación 4: Define tu Prioridad para este Ciclo',
				descripcion:
					'¿Tu suelo está cansado y necesita nitrógeno (🌱 Suelo)? ¿Vienen meses secos (💧 Agua)? ¿O buscas el mayor ingreso comercial (💰 Rentabilidad)?',
				mision:
					'👉 Haz clic en cualquiera de los 3 botones (🌱 Suelo, 💧 Agua o 💰 Rentabilidad) y observa cómo cambian las recomendaciones.',
				completadoTexto:
					'✅ ¡Excelente! Viste cómo el ranking y los porcentajes de afinidad se reordenaron al instante.',
				onEnter: () => {
					window.abrirDashboardTerraSoft?.();
				},
			},
			{
				id: 'recomendaciones',
				selector: '#seccion-rotacion',
				titulo: '🏆 Estación 5: Explora el Top 3, Calendario y Desglose de Costos',
				descripcion:
					'Cada tarjeta recomendada muestra la barra de los 12 meses del año (🟦 = mes óptimo, 📍 = mes actual) y el costo estimado con botón para desplegar los 4 rubros.',
				mision:
					'👉 Haz clic en el botón "📋 Ver desglose de costos ▾" dentro de cualquiera de las 3 tarjetas recomendadas.',
				completadoTexto:
					'✅ ¡Genial! Ahí tienes el detalle exacto de Semilla, Mano de Obra, Fertilizantes y Fitosanitarios.',
				onEnter: () => {
					window.abrirDashboardTerraSoft?.();
				},
			},
			{
				id: 'exportar',
				selector: '#btn-exportar-pdf',
				titulo: '📄 Estación 6: Descarga tu Informe Técnico desde el Dashboard',
				descripcion:
					'Exclusivamente dentro del Dashboard de Control tienes los botones "📄 Informe PDF" y "📥 Excel (.CSV)" para llevarte todo el estudio agroclimático, calendario y presupuesto.',
				mision:
					'👉 Haz clic en "📄 Informe PDF" o en "📥 Excel (.CSV)" en la cabecera de resultados para completar tu recorrido.',
				completadoTexto:
					'🎉 ¡Felicitaciones! Ya dominas el Dashboard de Control de TerraSoft como un experto.',
				onEnter: () => {
					window.abrirDashboardTerraSoft?.();
				},
			},
		];

		const CAPSULAS_INFO = {
			nitrogeno: {
				titulo: '🌱 El poder del Nitrógeno Biológico (Ahorro del 18%)',
				texto:
					'Las leguminosas como el <strong>Frijol, Arveja, Haba, Soya y Caupí</strong> tienen bacterias benéficas (<em>Rhizobium</em>) en sus raíces que capturan nitrógeno del aire y lo dejan en la tierra. Cuando siembras Maíz, Papa o Cebolla después de una leguminosa, el suelo ya está abonado naturalmente y <strong>ahorras cerca de un 18% en bultos de fertilizante nitrogenado</strong>.',
			},
			monocultivo: {
				titulo: '🧬 ¿Por qué evitar el Monocultivo y alternar Familias?',
				texto:
					'Cultivos de la misma familia botánica (como <strong>Papa y Tomate</strong>, que son <em>Solanáceas</em>) comparten las mismas plagas y hongos (como la gota). Si cambias a una <em>Leguminosa</em> (Arveja) o una <em>Gramínea</em> (Avena/Maíz), las plagas del cultivo anterior se quedan sin alimento y su ciclo se rompe de forma natural.',
			},
			satelite: {
				titulo: '🛰️ Doble Verificación: Satélite Óptico + NASA POWER',
				texto:
					'TerraSoft combina dos tecnologías espaciales: <strong>1)</strong> Lee los píxeles reales de la foto satelital para medir cuánta vegetación (verde), tierra arada (ocre) o pavimento/hielo hay exactamente bajo el marcador, y <strong>2)</strong> Consulta los satélites agroclimáticos de <strong>NASA POWER</strong> para conocer cuánta lluvia cae mes a mes y qué temperatura máxima alcanza tu lote.',
			},
			calendario: {
				titulo: '📅 Cómo interpretar el Semáforo y los 12 Meses',
				texto:
					'Cada cultivo tiene una ventana óptima de siembra según las temporadas de lluvias en Colombia (Marzo–Mayo y Septiembre–Noviembre). El sistema compara la <strong>fecha de hoy</strong> con esa ventana: <strong>🟢 Verde</strong> significa que puedes sembrar este mes; <strong>🟡 Amarillo</strong> indica que la ventana abre el próximo mes (momento de arar y alistar semilla); y <strong>⏳ Gris</strong> te avisa cuál es el próximo mes seguro.',
			},
		};

		const ESTACIONES_TOUR_EN = {
			mapa: {
				titulo: '📍 Station 1: Select your Lot on the Satellite Map',
				descripcion:
					'In the left column of the Dashboard you see your land from space along with NASA POWER and FAO GAEZ data. Clicking a point verifies whether it is arable land or a road, building, or glacier.',
				mision:
					'👉 Click on any green or plowed lot on the map (or click on a road to test the obstacle detector).',
				completadoTexto:
					'✅ You did it! The satellite analyzed the soil at that coordinate and downloaded NASA & FAO data.',
			},
			cultivo: {
				titulo: '🌾 Station 2: What did you plant last time?',
				descripcion:
					'In the top bar of the Dashboard you select your current crop. In agriculture we should never repeat the same botanical family twice in a row because pests remain in the soil.',
				mision:
					'👉 Open the "🌾 Current Crop" selector (grouped by the 6 macro-regions of Colombia) and choose a crop.',
				completadoTexto:
					'✅ Great! Now TerraSoft will penalize crops from the same family and find rotations that break pest cycles.',
			},
			area: {
				titulo: '📐 Station 3: Enter your Lot Size',
				descripcion:
					'Type how many square meters (m²), fanegadas, or hectares your parcel has. TerraSoft will automatically calculate seed, fertilizer, and labor costs in Colombian Pesos ($ COP).',
				mision:
					'👉 Type a different area in "📐 Lot" or switch the unit between m², Fanegadas, or Hectares.',
				completadoTexto:
					'✅ Perfect! All seed, labor, and fertilizer costs were just recalculated for your lot size.',
			},
			prioridad: {
				titulo: '🎯 Station 4: Choose your Priority for this Cycle',
				descripcion:
					'Is your soil tired and needs nitrogen (🌱 Soil)? Are dry months coming (💧 Water)? Or are you looking for the highest commercial return (💰 Profitability)?',
				mision:
					'👉 Click any of the 3 buttons (🌱 Soil, 💧 Water, or 💰 Profitability) and watch the recommendations reorder.',
				completadoTexto:
					'✅ Excellent! You saw how the ranking and affinity percentages updated instantly.',
			},
			recomendaciones: {
				titulo: '🏆 Station 5: Explore the Top 3, Calendar & Cost Breakdown',
				descripcion:
					'Each recommended card shows the 12-month bar (🟦 = optimal month, 📍 = current month) and the estimated budget with a button to expand the 4 cost items.',
				mision:
					'👉 Click the "📋 View cost breakdown ▾" button inside any of the 3 recommended cards.',
				completadoTexto:
					'✅ Awesome! There you have the exact breakdown for Seed, Labor, Fertilizers, and Crop Protection.',
			},
			exportar: {
				titulo: '📄 Station 6: Download your Technical Report (PDF or Excel)',
				descripcion:
					'Exclusively inside the Control Dashboard you have the "📄 PDF Report" and "📥 Excel (.CSV)" buttons to export your entire study, calendar, and budget.',
				mision:
					'👉 Click "📄 PDF Report" or "📥 Excel (.CSV)" in the results header to complete your tour.',
				completadoTexto:
					'🎉 Congratulations! You now master the TerraSoft Control Dashboard like an expert.',
			},
		};

		const CAPSULAS_INFO_EN = {
			nitrogeno: {
				titulo: '🌱 The Power of Biological Nitrogen (18% Savings)',
				texto:
					'Legumes such as <strong>Beans, Peas, Fava Beans, Soybeans, and Cowpeas</strong> host beneficial bacteria (<em>Rhizobium</em>) in their roots that capture nitrogen from the air and leave it in the soil. Planting Corn, Potato, or Onion after a legume saves <strong>around 18% on nitrogen fertilizers</strong>.',
			},
			monocultivo: {
				titulo: '🧬 Why Avoid Monoculture and Alternate Families?',
				texto:
					'Crops from the same botanical family (such as <strong>Potato and Tomato</strong>, both <em>Solanaceae</em>) share the same pests and fungi (like late blight). Switching to a <em>Legume</em> (Pea/Bean) or a <em>Grass</em> (Oats/Corn) starves the previous pests and breaks their cycle naturally.',
			},
			satelite: {
				titulo: '🛰️ Triple Verification: Optical Satellite + NASA POWER + FAO GAEZ',
				texto:
					'TerraSoft combines three spatial technologies: <strong>1)</strong> Reads the real pixels of the satellite photo to measure vegetation, plowed soil, or pavement under the marker, <strong>2)</strong> Queries <strong>NASA POWER</strong> agroclimatic satellites for monthly rain and temperature, and <strong>3)</strong> Evaluates the <strong>FAO GAEZ v4</strong> 7 soil properties (SQ1–SQ7) and growing period (LGP).',
			},
			calendario: {
				titulo: '📅 How to Read the Traffic Light and the 12 Months',
				texto:
					'Each crop has an optimal planting window based on Colombia’s rainy seasons (March–May and September–November). The system compares <strong>today’s date</strong> with that window: <strong>🟢 Green</strong> means you can plant this month; <strong>🟡 Yellow</strong> means the window opens next month (time to prepare soil); and <strong>⏳ Gray</strong> tells you the next safe month.',
			},
		};

		function obtenerEstacionTraducida(est) {
			if (!est) return null;
			const en = window.getTerraSoftLang?.() === 'en';
			if (en && ESTACIONES_TOUR_EN[est.id]) {
				return { ...est, ...ESTACIONES_TOUR_EN[est.id] };
			}
			return est;
		}
		let pasoActual = 0;
		const pasosCompletados = new Set();
		let elementoIluminado = null;
		let timerAutoAvance = null;
		let timerDebounceArea = null;
		let capsulaActivaKey = null;

		function cancelarAutoAvance() {
			if (timerAutoAvance) {
				clearTimeout(timerAutoAvance);
				timerAutoAvance = null;
			}
		}

		function quitarSpotlight() {
			if (elementoIluminado) {
				elementoIluminado.classList.remove('ts-spotlight-target');
				elementoIluminado = null;
			}
		}

		function aplicarSpotlight(selector) {
			quitarSpotlight();
			if (!selector || panelAsistente?.classList.contains('d-none')) return;
			const el = document.querySelector(selector);
			if (el) {
				elementoIluminado = el;
				el.classList.add('ts-spotlight-target');
				const esMovil = window.innerWidth < 768;
				if (esMovil) {
					el.style.scrollMarginTop = '68px';
					el.scrollIntoView({ behavior: 'smooth', block: 'start' });
				} else {
					el.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			}
		}

		function expandirAsistente() {
			const en = window.getTerraSoftLang?.() === 'en';
			panelAsistente?.classList.remove('ts-minimized');
			if (minimizarBtn) {
				minimizarBtn.textContent = en ? '🔽 Fold' : '🔽 Plegar';
			}
			if (tituloHeader) {
				tituloHeader.textContent = en
					? 'Don Terra — Your Agronomist Guide'
					: 'Don Terra — Tu Agrónomo Guía';
			}
		}

		function alternarMinimizadoAsistente() {
			if (!panelAsistente) return;
			const en = window.getTerraSoftLang?.() === 'en';
			const minimizado = panelAsistente.classList.toggle('ts-minimized');
			if (minimizarBtn) {
				minimizarBtn.textContent = minimizado
					? en
						? '🔼 Expand'
						: '🔼 Expandir'
					: en
					? '🔽 Fold'
					: '🔽 Plegar';
			}
			if (tituloHeader) {
				const est = obtenerEstacionTraducida(ESTACIONES_TOUR[pasoActual]);
				tituloHeader.textContent =
					minimizado && est
						? est.titulo
						: en
						? 'Don Terra — Your Agronomist Guide'
						: 'Don Terra — Tu Agrónomo Guía';
			}
		}

		function renderizarPasoTour(ejecutarOnEnter = true) {
			cancelarAutoAvance();
			const estBase = ESTACIONES_TOUR[pasoActual];
			const est = obtenerEstacionTraducida(estBase);
			if (!est) return;
			const en = window.getTerraSoftLang?.() === 'en';

			if (ejecutarOnEnter && typeof est.onEnter === 'function') {
				est.onEnter();
			}

			const lblPaso = en ? 'Step' : 'Paso';
			if (badgeProgreso) badgeProgreso.textContent = `${lblPaso} ${pasoActual + 1} / ${ESTACIONES_TOUR.length}`;
			if (badgeProgresoMovil) badgeProgresoMovil.textContent = `${pasoActual + 1}/${ESTACIONES_TOUR.length}`;
			if (badgeFabPaso) badgeFabPaso.textContent = `${lblPaso} ${pasoActual + 1}/${ESTACIONES_TOUR.length}`;
			if (stepTitle) stepTitle.textContent = est.titulo;
			if (stepDesc) {
				stepDesc.textContent = est.descripcion;
				stepDesc.classList.remove('ts-desc-expanded');
			}
			if (toggleExplicacionBtn) {
				toggleExplicacionBtn.textContent = en ? 'ℹ️ Why?' : 'ℹ️ ¿Por qué?';
			}
			if (panelAsistente?.classList.contains('ts-minimized') && tituloHeader) {
				tituloHeader.textContent = est.titulo;
			}

			const yaCompletado = pasosCompletados.has(est.id);
			if (missionBox && missionTitle && missionText) {
				if (yaCompletado) {
					missionBox.classList.add('completed');
					missionTitle.textContent = en ? '🌟 Mission Completed!' : '🌟 ¡Misión Completada!';
					missionText.textContent = est.completadoTexto;
				} else {
					missionBox.classList.remove('completed');
					missionTitle.textContent = en ? '🎯 Your Interactive Mission:' : '🎯 Tu Misión Interactiva:';
					missionText.textContent = est.mision;
				}
			}

			if (btnPrev) btnPrev.disabled = pasoActual === 0;

			if (dotsContainer) {
				dotsContainer.innerHTML = ESTACIONES_TOUR.map((e, idx) => {
					const cls =
						idx === pasoActual
							? 'ts-step-dot active'
							: pasosCompletados.has(e.id)
							? 'ts-step-dot done'
							: 'ts-step-dot';
					return `<span class="${cls}" style="background: ${
						idx === pasoActual ? '#f5b041' : pasosCompletados.has(e.id) ? '#0284c7' : '#cbd5e1'
					};"></span>`;
				}).join('');
			}

			aplicarSpotlight(est.selector);
		}

		function marcarMisionCompletada(idEstacion, mensajeExtra) {
			pasosCompletados.add(idEstacion);
			const estActual = obtenerEstacionTraducida(ESTACIONES_TOUR[pasoActual]);
			const tourVisible =
				!panelAsistente?.classList.contains('d-none') && !vistaTour?.classList.contains('d-none');
			const en = window.getTerraSoftLang?.() === 'en';

			if (estActual && estActual.id === idEstacion && missionBox && missionTitle && missionText) {
				cancelarAutoAvance();
				if (tourVisible) {
					expandirAsistente();
				}
				const esUltimoPaso = pasoActual === ESTACIONES_TOUR.length - 1;
				const textoExito = mensajeExtra || estActual.completadoTexto;

				missionBox.classList.add('completed');
				missionTitle.textContent = en ? '🌟 Mission Successfully Completed!' : '🌟 ¡Misión Completada con Éxito!';
				missionText.innerHTML = `
					<div>${textoExito}</div>
					<div class="fw-semibold mt-1" style="font-size: 0.75rem; color: #0b213f;">
						${
							esUltimoPaso
								? en
									? '🎉 Tour finished! Closing guide...'
									: '🎉 ¡Recorrido finalizado! Cerrando guía...'
								: en
								? '⏭️ Automatically advancing to the next step...'
								: '⏭️ Avanzando automáticamente al siguiente paso...'
						}
					</div>
					<div class="ts-auto-advance-progress">
						<div class="ts-auto-advance-fill"></div>
					</div>
				`;

				if (tourVisible) {
					timerAutoAvance = setTimeout(() => {
						timerAutoAvance = null;
						if (pasoActual < ESTACIONES_TOUR.length - 1) {
							pasoActual++;
							renderizarPasoTour();
						} else {
							cerrarAsistente();
							if (badgeFabPaso) badgeFabPaso.textContent = en ? '✅ Tour completed' : '✅ Tour completado';
						}
					}, 2200);
				}
			}
		}

		function abrirAsistente(enModoTour = true) {
			panelAsistente?.classList.remove('d-none');
			fabBtn?.classList.add('d-none');
			expandirAsistente();
			if (enModoTour) {
				mostrarModoTour();
			} else {
				mostrarModoCapsulas();
			}
		}

		function cerrarAsistente() {
			cancelarAutoAvance();
			panelAsistente?.classList.add('d-none');
			fabBtn?.classList.remove('d-none');
			quitarSpotlight();
		}

		function mostrarModoTour() {
			btnModoTour?.classList.replace('btn-outline-secondary', 'ts-btn-space');
			btnModoCapsulas?.classList.replace('ts-btn-space', 'btn-outline-secondary');
			vistaTour?.classList.remove('d-none');
			vistaCapsulas?.classList.add('d-none');
			renderizarPasoTour();
		}

		function mostrarModoCapsulas() {
			quitarSpotlight();
			btnModoCapsulas?.classList.replace('btn-outline-secondary', 'ts-btn-space');
			btnModoTour?.classList.replace('ts-btn-space', 'btn-outline-secondary');
			vistaCapsulas?.classList.remove('d-none');
			vistaTour?.classList.add('d-none');
		}

		// Eventos de apertura / cierre
		fabBtn?.addEventListener('click', () => {
			if (panelAsistente?.classList.contains('d-none')) {
				abrirAsistente(true);
			} else {
				cerrarAsistente();
			}
		});
		navTourBtn?.addEventListener('click', () => {
			pasoActual = 0;
			abrirAsistente(true);
		});
		cerrarBtn?.addEventListener('click', cerrarAsistente);
		minimizarBtn?.addEventListener('click', alternarMinimizadoAsistente);
		toggleExplicacionBtn?.addEventListener('click', () => {
			if (!stepDesc) return;
			const expandido = stepDesc.classList.toggle('ts-desc-expanded');
			toggleExplicacionBtn.textContent = expandido ? '🔼 Ocultar' : 'ℹ️ ¿Por qué?';
		});

		btnModoTour?.addEventListener('click', mostrarModoTour);
		btnModoCapsulas?.addEventListener('click', mostrarModoCapsulas);

		btnPrev?.addEventListener('click', () => {
			if (pasoActual > 0) {
				pasoActual--;
				renderizarPasoTour();
			}
		});

		// Cápsulas didácticas
		function renderizarCapsulaActiva() {
			if (!capsulaActivaKey || !cajaCapsula) return;
			const en = window.getTerraSoftLang?.() === 'en';
			const dictCap = en ? CAPSULAS_INFO_EN : CAPSULAS_INFO;
			const info = dictCap[capsulaActivaKey];
			if (info) {
				cajaCapsula.innerHTML = `<div class="fw-bold text-success mb-1">${info.titulo}</div><div>${info.texto}</div>`;
			}
		}

		document.querySelectorAll('[data-capsule]').forEach((btn) => {
			btn.addEventListener('click', () => {
				capsulaActivaKey = btn.getAttribute('data-capsule');
				renderizarCapsulaActiva();
			});
		});

		window.addEventListener('terrasoft:lang-change', () => {
			renderizarPasoTour(false);
			if (capsulaActivaKey) {
				renderizarCapsulaActiva();
			}
		});

		// ESCUCHA ACTIVA DE INTERACCIONES DEL USUARIO ("APRENDE HACIENDO")
		// 1. Cuando hace clic en el mapa y se evalúa la coordenada
		let cargaInicialIgnorada = false;
		window.addEventListener('terrasync:terreno-evaluado', (e) => {
			if (!cargaInicialIgnorada) {
				cargaInicialIgnorada = true;
				return;
			}
			const { terreno, promedios } = e.detail || {};
			const estadoTxt = terreno?.aptoParaSiembra
				? `✅ ¡Muy bien! Seleccionaste un terreno apto (${promedios?.lluviaTotalAnual} mm/año, ${promedios?.tempMax} °C).`
				: `🚫 ¡Buen experimento! Detectamos que ese punto no es cultivable (${terreno?.etiqueta}).`;
			marcarMisionCompletada('mapa', estadoTxt);
		});

		// 2. Cuando cambia el cultivo actual
		document.getElementById('select-cultivo')?.addEventListener('change', (e) => {
			const textoOpcion = (e.target.options[e.target.selectedIndex]?.text || '').trim();
			marcarMisionCompletada(
				'cultivo',
				`✅ Elegiste "${textoOpcion}". Las tarjetas ahora buscan otra familia botánica para proteger tu suelo.`
			);
		});

		// 3. Cuando cambia el área o unidad del lote (con pequeño debounce al escribir para que termine de digitar el número)
		const handlerArea = () => {
			const val = document.getElementById('input-area-lote')?.value || '1200';
			const uni = document.getElementById('select-unidad-area')?.selectedOptions?.[0]?.text || 'm²';
			marcarMisionCompletada(
				'area',
				`✅ Ajustaste tu lote a ${val} ${uni}. ¡Mira cómo cambiaron los presupuestos en pesos colombianos!`
			);
		};
		document.getElementById('input-area-lote')?.addEventListener('input', () => {
			if (timerDebounceArea) clearTimeout(timerDebounceArea);
			timerDebounceArea = setTimeout(handlerArea, 750);
		});
		document.getElementById('select-unidad-area')?.addEventListener('change', handlerArea);

		// 4. Cuando hace clic en una prioridad
		document.querySelectorAll('[data-priority-val]').forEach((b) => {
			b.addEventListener('click', () => {
				marcarMisionCompletada(
					'prioridad',
					`✅ Cambiaste la prioridad a "${b.textContent.trim()}". El ranking se acaba de actualizar frente a ti.`
				);
			});
		});

		// 5. Cuando despliega el desglose de costos en cualquiera de las tarjetas recomendadas
		document.getElementById('rotation-cards-container')?.addEventListener('click', (e) => {
			if (e.target.closest('[data-bs-toggle="collapse"]')) {
				marcarMisionCompletada(
					'recomendaciones',
					'✅ ¡Excelente! Ahora puedes ver cuánto cuesta cada rubro de la siembra.'
				);
			}
		});

		// 6. Cuando exporta el informe PDF o CSV desde el Dashboard
		document.getElementById('btn-exportar-pdf')?.addEventListener('click', () => {
			marcarMisionCompletada('exportar', '🎉 ¡Excelente! Has generado el informe técnico completo en PDF.');
		});
		document.getElementById('btn-exportar-csv')?.addEventListener('click', () => {
			marcarMisionCompletada('exportar', '🎉 ¡Excelente! Has descargado la hoja de cálculo para Excel.');
		});

		// Si es la primera visita, resaltamos suavemente el botón del asistente sin hacer scroll automático
		// para no tapar el Hero Aero-Agrícola; el usuario inicia el tour cuando desee.
		if (!sessionStorage.getItem('terrasync_tour_visto')) {
			sessionStorage.setItem('terrasync_tour_visto', '1');
			if (badgeFabPaso) badgeFabPaso.textContent = '¡Nuevo Tour!';
		}
	});
</script>

