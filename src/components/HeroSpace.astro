---
---

<!-- PORTADA INICIAL EXCLUSIVA A PANTALLA COMPLETA (HERO LIMPIO + 3 SECCIONES INFORMATIVAS) -->
<div id="vista-portada-inicial" class="ts-landing-view">
	<section id="inicio" class="ts-hero">
		<div class="container-fluid px-lg-5 position-relative" style="z-index: 2;">
			<div class="row align-items-center">
				<!-- Columna Principal: Contenido Informativo Bien Distribuido (sin datos prematuros de clima/suelo) -->
				<div class="col-lg-7 col-xl-6">
					<div class="mb-3">
						<span class="ts-hero-badge">
							<span>🛰️</span>
							<span>Agricultura de Precisión · NASA POWER &amp; Colombia</span>
						</span>
					</div>

					<h1 class="display-5 fw-bold mb-3 text-white" style="line-height: 1.14; letter-spacing: -0.02em; text-shadow: 0 4px 18px rgba(0,0,0,0.55);">
						Datos espaciales para<br />decisiones en tu campo
					</h1>

					<p class="lead mb-4" style="font-size: 1.06rem; max-width: 560px; color: rgba(255,255,255,0.9); text-shadow: 0 2px 10px rgba(0,0,0,0.55);">
						Selecciona tu parcela en el mapa satelital para obtener en tiempo real la aptitud del suelo, el clima histórico de <strong class="text-warning">NASA POWER</strong>, la rotación ideal de cultivos y el presupuesto para tu lote.
					</p>

					<!-- Píldoras de Capacidades del Sistema (Informativas y Estáticas) -->
					<div class="d-flex flex-wrap gap-2 mb-4">
						<div class="ts-hero-feature-pill">
							<span>🌍</span>
							<span><strong>6 Macroregiones</strong> de Colombia</span>
						</div>
						<div class="ts-hero-feature-pill">
							<span>🌾</span>
							<span><strong>24 Cultivos</strong> y Familias Botánicas</span>
						</div>
						<div class="ts-hero-feature-pill">
							<span>💵</span>
							<span><strong>Presupuesto en $ COP</strong> e Informe PDF</span>
						</div>
					</div>

					<div class="d-flex flex-wrap align-items-center gap-3">
						<button
							type="button"
							id="btn-hero-tour"
							class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold"
							style="backdrop-filter: blur(8px); background: rgba(7, 20, 40, 0.52); border-color: rgba(56, 189, 248, 0.55);"
						>
							🧑‍🌾 Conoce cómo funciona con Don Terra
						</button>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- LAS 3 SECCIONES INFORMATIVAS DE LA PORTADA (CON BOTÓN DE INICIO EN MONITOREO SATELITAL) -->
	<section class="container-fluid px-lg-5 ts-bridge-wrap" id="secciones-informativas-portada">
		<div class="row g-3 g-lg-4 align-items-stretch justify-content-center">
			<!-- Sección Informativa 1: Monitoreo Satelital (Contiene el Botón para Iniciar el Dashboard) -->
			<div class="col-md-4">
				<div class="ts-bridge-card ts-bridge-left p-3 text-center">
					<div>
						<div class="fw-bold fs-5 mb-1" style="color: #071428;">
							🛰️ Monitoreo Satelital
						</div>
						<p class="small text-secondary mb-2" style="line-height: 1.38;">
							Ubica tu parcela en el mapa para activar el escáner óptico RGB y consultar la lluvia y temperatura de <strong>NASA POWER</strong>.
						</p>
					</div>
					<div class="pt-1">
						<button
							type="button"
							id="btn-iniciar-monitoreo"
							class="btn ts-btn-amber w-100 py-2 fw-bold"
						>
							🚀 Iniciar Monitoreo y Simulación ➔
						</button>
					</div>
				</div>
			</div>

			<!-- Sección Informativa 2: Simular Rotación -->
			<div class="col-md-4">
				<div class="ts-bridge-card ts-bridge-center p-3 text-center">
					<div>
						<div class="fw-bold fs-5 mb-1 text-white" style="text-shadow: 0 2px 8px rgba(0,0,0,0.7);">
							🌾 Simulación de Rotación
						</div>
						<p class="small text-white mb-2" style="line-height: 1.38; text-shadow: 0 1px 6px rgba(0,0,0,0.85);">
							Evalúa 24 cultivos regionales de Colombia alternando familias botánicas para cortar plagas y fijar nitrógeno en el suelo.
						</p>
					</div>
					<div>
						<span class="badge rounded-pill px-3 py-1 fw-semibold" style="background: rgba(13, 38, 71, 0.85); color: #f5b041; border: 1px solid rgba(245, 176, 65, 0.5);">
							🌱 24 Cultivos · 6 Macroregiones de Colombia
						</span>
					</div>
				</div>
			</div>

			<!-- Sección Informativa 3: Calendario y Presupuesto -->
			<div class="col-md-4">
				<div class="ts-bridge-card ts-bridge-right p-3 text-center">
					<div>
						<div class="fw-bold fs-5 mb-1" style="color: #071428;">
							📅 Calendario y Presupuesto
						</div>
						<p class="small mb-2" style="color: #0d2647; line-height: 1.38;">
							Semáforo de siembra según el mes actual, ventana de 12 meses y cálculo de costos en pesos (<strong>$ COP</strong>) para tu lote.
						</p>
					</div>
					<div>
						<span class="badge rounded-pill px-3 py-1 fw-semibold" style="background: #0d2647; color: #38bdf8;">
							💵 Costos en $ COP e Informe PDF / Excel
						</span>
					</div>
				</div>
			</div>
		</div>
	</section>
</div>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const btnHeroTour = document.getElementById('btn-hero-tour');
		btnHeroTour?.addEventListener('click', () => {
			document.getElementById('btn-abrir-tutorial-nav')?.click();
		});

		const btnIniciarMonitoreo = document.getElementById('btn-iniciar-monitoreo');
		btnIniciarMonitoreo?.addEventListener('click', () => {
			if (typeof window.abrirDashboardTerraSoft === 'function') {
				window.abrirDashboardTerraSoft();
			}
		});
	});
</script>
