---
interface Props {
	initialLat?: number;
	initialLon?: number;
	initialZoom?: number;
}

const {
	initialLat = 5.79482,
	initialLon = -72.99667,
	initialZoom = 17,
} = Astro.props;
---

<!-- Leaflet 1.9.4 CSS -->
<link
	rel="stylesheet"
	href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
	integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
	crossorigin=""
/>

<style is:global>
	/* Diseño horizontal y compacto para el mensaje emergente (Popup) dentro del mapa */
	#terrasync-map .leaflet-popup-content-wrapper {
		border-radius: 0.75rem;
		padding: 2px;
		box-shadow: 0 8px 24px rgba(7, 20, 40, 0.28);
		border: 1.5px solid rgba(13, 38, 71, 0.22);
	}
	#terrasync-map .leaflet-popup-content {
		min-width: 265px !important;
		max-width: 340px !important;
		width: max-content !important;
		margin: 8px 12px !important;
		line-height: 1.35 !important;
		white-space: normal !important;
	}
	@media (max-width: 480px) {
		#terrasync-map .leaflet-popup-content {
			min-width: 215px !important;
			max-width: 265px !important;
		}
	}
	.ts-map-popup-box {
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
	}
	.ts-map-popup-icon {
		width: 32px;
		height: 32px;
		border-radius: 0.5rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 1.05rem;
		flex-shrink: 0;
	}
	.ts-map-popup-body {
		flex: 1 1 auto;
		min-width: 0;
	}
	.ts-map-popup-title {
		font-weight: 700;
		font-size: 0.8rem;
		line-height: 1.25;
		margin-bottom: 2px;
		word-break: break-word;
	}
	.ts-map-popup-coords {
		font-size: 0.72rem;
		color: #64748b;
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: wrap;
	}
</style>

<div class="card ts-card shadow-sm border-0 mb-3 overflow-hidden">
	<div class="card-header ts-card-header-space d-flex justify-content-between align-items-center py-2 px-3">
		<div class="d-flex align-items-center gap-2">
			<span class="fw-bold text-info small">🛰️ Mapa Satelital de Parcela</span>
			<span class="text-white-50" style="font-size: 0.76rem;">(Haz clic o arrastra el marcador)</span>
		</div>
		<button
			type="button"
			id="btn-geolocate"
			class="btn ts-btn-amber btn-sm py-0 px-2"
			style="font-size: 0.76rem;"
			title="Usar mi ubicación GPS actual"
		>
			📍 Mi ubicación
		</button>
	</div>

	<div class="card-body p-0">
		<div
			id="terrasync-map"
			data-initial-lat={initialLat}
			data-initial-lon={initialLon}
			data-initial-zoom={initialZoom}
			style="height: 395px; width: 100%;"
		></div>
	</div>

	<div class="card-footer py-2 px-3 border-top" style="background: #0b213f; color: #fff;">
		<div class="row g-2 align-items-center">
			<div class="col-6">
				<div class="input-group input-group-sm">
					<span class="input-group-text border-0 fw-semibold" style="background: #163a66; color: #38bdf8; font-size: 0.75rem;">Lat</span>
					<input
						type="number"
						step="any"
						id="input-lat"
						name="lat"
						class="form-control form-control-sm border-0 fw-semibold"
						style="font-size: 0.8rem; background: #f8fafc;"
						value={initialLat}
						required
					/>
				</div>
			</div>
			<div class="col-6">
				<div class="input-group input-group-sm">
					<span class="input-group-text border-0 fw-semibold" style="background: #163a66; color: #38bdf8; font-size: 0.75rem;">Lon</span>
					<input
						type="number"
						step="any"
						id="input-lon"
						name="lon"
						class="form-control form-control-sm border-0 fw-semibold"
						style="font-size: 0.8rem; background: #f8fafc;"
						value={initialLon}
						required
					/>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Leaflet 1.9.4 JS -->
<script
	is:inline
	src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
	integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
	crossorigin=""
></script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const mapEl = document.getElementById('terrasync-map');
		if (!mapEl || typeof L === 'undefined') return;

		const initialLat = parseFloat(mapEl.dataset.initialLat || '5.79482');
		const initialLon = parseFloat(mapEl.dataset.initialLon || '-72.99667');
		const initialZoom = parseInt(mapEl.dataset.initialZoom || '17', 10);

		const inputLat = document.getElementById('input-lat');
		const inputLon = document.getElementById('input-lon');
		const btnGeolocate = document.getElementById('btn-geolocate');

		const capaSatelite = L.tileLayer(
			'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
			{
				maxZoom: 19,
				crossOrigin: true,
				attribution: 'Tiles &copy; Esri',
			}
		);

		const capaCalles = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
			attribution: '&copy; OpenStreetMap',
		});

		const map = L.map('terrasync-map', {
			center: [initialLat, initialLon],
			zoom: initialZoom,
			layers: [capaSatelite],
		});

		function crearHtmlPopupCargando(lat, lon) {
			return `
				<div class="ts-map-popup-box">
					<span class="ts-map-popup-icon" style="background: #eef4fb; color: #0d2647;">⏳</span>
					<div class="ts-map-popup-body">
						<div class="ts-map-popup-title" style="color: #0d2647;">Analizando punto satelital...</div>
						<div class="ts-map-popup-coords">
							<span>📍 Lat: <strong>${lat}</strong></span>
							<span>•</span>
							<span>Lon: <strong>${lon}</strong></span>
						</div>
					</div>
				</div>
			`;
		}

		function crearHtmlPopupEvaluado(terreno, coordenadas, promedios) {
			const esApto = Boolean(terreno?.aptoParaSiembra);
			const icono = esApto ? '✅' : '🚫';
			const bgIcono = esApto ? '#dcfce7' : '#fee2e2';
			const colorTitulo = esApto ? '#0d2647' : '#dc2626';
			const infoClima =
				promedios && typeof promedios.tempMax === 'number'
					? `<span>• 🌡️ ${promedios.tempMax}°C</span><span>• 🌧️ ${promedios.lluviaTotalAnual} mm</span>`
					: '';

			return `
				<div class="ts-map-popup-box">
					<span class="ts-map-popup-icon" style="background: ${bgIcono};">${icono}</span>
					<div class="ts-map-popup-body">
						<div class="ts-map-popup-title" style="color: ${colorTitulo};">
							${terreno.etiqueta}
						</div>
						<div class="ts-map-popup-coords">
							<span>📍 ${coordenadas.lat}, ${coordenadas.lon}</span>
							${infoClima}
						</div>
					</div>
				</div>
			`;
		}

		L.control
			.layers(
				{
					'🛰️ Satélite': capaSatelite,
					'🗺️ Calles (OSM)': capaCalles,
				},
				null,
				{ position: 'topright', collapsed: false }
			)
			.addTo(map);

		let marker = L.marker([initialLat, initialLon], { draggable: true })
			.addTo(map)
			.bindPopup(crearHtmlPopupCargando(initialLat.toFixed(5), initialLon.toFixed(5)), {
				minWidth: 265,
				maxWidth: 340,
				autoPanPadding: [20, 20],
			})
			.openPopup();

		let capaObstaculo = null;

		window.addEventListener('terrasoft:tab-changed', (e) => {
			if (e.detail?.tab === 'monitoreo') {
				setTimeout(() => {
					map.invalidateSize({ animate: false });
					map.setView(marker.getLatLng(), map.getZoom(), { animate: false });
					marker.getPopup()?.update();
					marker.openPopup();
				}, 65);
			}
		});

		function updateCoordinates(lat, lon, pan = false) {
			const roundedLat = Number(lat.toFixed(5));
			const roundedLon = Number(lon.toFixed(5));

			if (inputLat) inputLat.value = roundedLat;
			if (inputLon) inputLon.value = roundedLon;

			marker.setLatLng([roundedLat, roundedLon]);
			marker.setPopupContent(crearHtmlPopupCargando(roundedLat, roundedLon));
			marker.getPopup()?.update();
			marker.openPopup();

			if (pan) {
				map.setView([roundedLat, roundedLon], Math.max(map.getZoom(), 17));
			}

			window.dispatchEvent(
				new CustomEvent('terrasync:location-change', {
					detail: { lat: roundedLat, lon: roundedLon },
				})
			);
		}

		window.addEventListener('terrasync:terreno-evaluado', (e) => {
			const { terreno, coordenadas, promedios } = e.detail || {};
			if (!terreno || !coordenadas) return;

			if (capaObstaculo) {
				map.removeLayer(capaObstaculo);
				capaObstaculo = null;
			}

			if (!terreno.aptoParaSiembra && Array.isArray(terreno.geometriaDetectada) && terreno.geometriaDetectada.length > 1) {
				const latlngs = terreno.geometriaDetectada.map((pt) => [pt.lat, pt.lon]);
				capaObstaculo = L.polyline(latlngs, {
					color: '#dc3545',
					weight: 8,
					opacity: 0.8,
				}).addTo(map);
			}

			marker.setPopupContent(crearHtmlPopupEvaluado(terreno, coordenadas, promedios));
			marker.getPopup()?.update();
			marker.openPopup();
		});

		window.addEventListener('terrasync:terreno-error', (e) => {
			const { lat, lon, error } = e.detail || {};
			marker.setPopupContent(`
				<div class="ts-map-popup-box">
					<span class="ts-map-popup-icon" style="background: #fef3c7;">⚠️</span>
					<div class="ts-map-popup-body">
						<div class="ts-map-popup-title" style="color: #92400e;">${error || 'Reintenta el análisis del punto'}</div>
						<div class="ts-map-popup-coords">📍 ${lat ?? ''}, ${lon ?? ''}</div>
					</div>
				</div>
			`);
			marker.getPopup()?.update();
			marker.openPopup();
		});

		map.on('click', (e) => {
			updateCoordinates(e.latlng.lat, e.latlng.lng);
		});

		marker.on('dragend', () => {
			const pos = marker.getLatLng();
			updateCoordinates(pos.lat, pos.lng);
		});

		function handleManualInput() {
			const lat = parseFloat(inputLat.value);
			const lon = parseFloat(inputLon.value);
			if (!isNaN(lat) && !isNaN(lon) && lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180) {
				updateCoordinates(lat, lon, true);
			}
		}

		if (inputLat) inputLat.addEventListener('change', handleManualInput);
		if (inputLon) inputLon.addEventListener('change', handleManualInput);

		if (btnGeolocate && 'geolocation' in navigator) {
			btnGeolocate.addEventListener('click', () => {
				btnGeolocate.disabled = true;
				btnGeolocate.textContent = '⏳...';
				navigator.geolocation.getCurrentPosition(
					(pos) => {
						updateCoordinates(pos.coords.latitude, pos.coords.longitude, true);
						btnGeolocate.disabled = false;
						btnGeolocate.textContent = '📍 Mi ubicación';
					},
					() => {
						alert('No se pudo obtener tu ubicación actual. Selecciona un punto en el mapa.');
						btnGeolocate.disabled = false;
						btnGeolocate.textContent = '📍 Mi ubicación';
					}
				);
			});
		}
	});
</script>
