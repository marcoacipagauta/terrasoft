			/**
			 * Convierte el área ingresada por el usuario (m², fanegadas o ha) a Hectáreas (1 ha = 10,000 m², 1 fanegada = 6,400 m²).
			 */
			function obtenerAreaEnHectareas() {
				const valor = Math.max(1, parseFloat(inputAreaLote?.value || '1200') || 1200);
				const unidad = selectUnidadArea?.value || 'm2';
				if (unidad === 'ha') {
					return { areaHa: valor, etiquetaArea: `${valor} ha` };
				}
				if (unidad === 'fanegada') {
					return { areaHa: (valor * 6400) / 10000, etiquetaArea: `${valor} fanegada(s)` };
				}
				return { areaHa: valor / 10000, etiquetaArea: `${valor.toLocaleString('es-CO')} m²` };
			}

			/**
			 * Evalúa si el mes actual es ideal para sembrar el cultivo y genera el consejo para el campesino.
			 */
			function evaluarCalendarioSiembra(cultivo, mensualNasa) {
				const en = esIngles();
				const mesesLargos = obtenerMesesLargos();
				const nomMesActual = mesesLargos[mesActualNum - 1];
				const mesesOptimos = Array.isArray(cultivo.mesesSiembra) ? cultivo.mesesSiembra : [3, 4, 5, 9, 10];
				const mesSiguiente = (mesActualNum % 12) + 1;
				const lluviaMesActual = Array.isArray(mensualNasa) && mensualNasa[mesActualNum - 1]
					? mensualNasa[mesActualNum - 1].lluviaTotal
					: null;

				const textoLluviaMes =
					typeof lluviaMesActual === 'number'
						? en
							? ` (NASA historical in ${nomMesActual}: ${lluviaMesActual} mm)`
							: ` (Histórico NASA en ${nomMesActual}: ${lluviaMesActual} mm)`
						: '';

				const notaCal = obtenerNotaCalendarioCultivo(cultivo);

				if (mesesOptimos.includes(mesActualNum)) {
					return {
						estado: 'ideal',
						bonoPuntaje: 10,
						badgeClase: 'bg-success text-white',
						icono: '🟢',
						titulo: en
							? `Ideal Date! ${nomMesActual} is in the optimal planting window`
							: `¡Fecha Ideal! ${nomMesActual} está en ventana óptima de siembra`,
						consejo: en
							? `You can start planting now in ${nomMesActual}${textoLluviaMes}. ${notaCal}`
							: `Puedes iniciar la siembra ahora en ${nomMesActual}${textoLluviaMes}. ${notaCal}`,
					};
				}

				if (mesesOptimos.includes(mesSiguiente)) {
					const nombreSig = mesesLargos[mesSiguiente - 1];
					return {
						estado: 'preparacion',
						bonoPuntaje: 4,
						badgeClase: 'bg-warning text-dark',
						icono: '🟡',
						titulo: en
							? `Preparation Stage: Optimal planting starts next month (${nombreSig})`
							: `Etapa de Preparación: Siembra óptima inicia el próximo mes (${nombreSig})`,
						consejo: en
							? `Use ${nomMesActual} to prepare the soil, apply amendments, and get certified seed to plant in ${nombreSig}.`
							: `Aprovecha ${nomMesActual} para preparar el suelo, aplicar correctivos y conseguir semilla certificada para sembrar en ${nombreSig}.`,
					};
				}

				// Buscar el próximo mes óptimo en el calendario
				let proximoMes = mesesOptimos[0];
				for (let offset = 1; offset <= 12; offset++) {
					const candidato = ((mesActualNum - 1 + offset) % 12) + 1;
					if (mesesOptimos.includes(candidato)) {
						proximoMes = candidato;
						break;
					}
				}
				const nombreProx = mesesLargos[proximoMes - 1];

				return {
					estado: 'espera',
					bonoPuntaje: -6,
					badgeClase: 'bg-secondary-subtle text-secondary-emphasis border',
					icono: '⏳',
					titulo: en
						? `Off-season today (${nomMesActual}) — Next window: ${nombreProx}`
						: `Fuera de temporada hoy (${nomMesActual}) — Próxima ventana: ${nombreProx}`,
					consejo: en
						? `Rainfed planting is not advised in ${nomMesActual}${textoLluviaMes}. Schedule planting for ${nombreProx} or ensure supplemental irrigation.`
						: `No se aconseja sembrar en ${nomMesActual} a secano${textoLluviaMes}. Programa la siembra para ${nombreProx} o asegura riego suplementario.`,
				};
			}

			/**
			 * Extrae la duración media en días del ciclo del cultivo (ej. "90 - 120 días" -> 105).
			 */
			function extraerDiasCiclo(cicloTexto) {
				const nums = String(cicloTexto || '')
					.match(/\d+/g)
					?.map(Number);
				if (!nums || !nums.length) return 110;
				if (nums.length >= 2) return Math.round((nums[0] + nums[1]) / 2);
				return nums[0];
			}

			/**
			 * Calcula el presupuesto estimado del cultivo para el área del lote ingresada,
			 * aplicando descuento en fertilizantes si se rota después de una leguminosa y ajustando rendimiento por FAO GAEZ.
			 */
			function calcularPresupuestoLote(cultivo, objCultivoActual, clima) {
				const { areaHa, etiquetaArea } = obtenerAreaEnHectareas();
				const costoBaseHa = cultivo.costoTotalHaCOP || 10000000;
				const pcts = cultivo.desgloseCostosPct || {
					semilla: 22,
					manoObra: 35,
					fertilizantes: 25,
					fitosanitarios: 18,
				};

				const costoBrutoLote = costoBaseHa * areaHa;
				const rubSemilla = Math.round((costoBrutoLote * pcts.semilla) / 100);
				const rubManoObra = Math.round((costoBrutoLote * pcts.manoObra) / 100);
				let rubFertilizantes = Math.round((costoBrutoLote * pcts.fertilizantes) / 100);
				const rubFitosanitarios = Math.round((costoBrutoLote * pcts.fitosanitarios) / 100);

				// Si el cultivo anterior en la parcela fue una Leguminosa (Fabáceas) y el nuevo cultivo es diferente,
				// el nitrógeno biológico fijado ahorra ~18% en fertilizantes nitrogenados
				let ahorroNitrogeno = 0;
				if (
					objCultivoActual &&
					objCultivoActual.familia?.includes('Leguminosas') &&
					cultivo.id !== objCultivoActual.id
				) {
					ahorroNitrogeno = Math.round(rubFertilizantes * 0.18);
					rubFertilizantes -= ahorroNitrogeno;
				}

				const costoTotalNeto = rubSemilla + rubManoObra + rubFertilizantes + rubFitosanitarios;
				const factorFao = clima?.faoGaez?.factorRendimientoFao ?? 1;
				const rendimientoTonLote = Number(((cultivo.rendimientoTonHa || 5) * areaHa * factorFao).toFixed(2));
				const rendimientoTexto =
					rendimientoTonLote >= 1
						? `${rendimientoTonLote} ton`
						: `${Math.round(rendimientoTonLote * 1000).toLocaleString('es-CO')} kg`;

				return {
					etiquetaArea,
					costoTotalNeto,
					ahorroNitrogeno,
					rubSemilla,
					rubManoObra,
					rubFertilizantes,
					rubFitosanitarios,
					rendimientoTexto,
				};
			}

			function analizarSuperficieSatelital(lat, lon) {
				return new Promise((resolve) => {
					const zoom = 18;
					const n = Math.pow(2, zoom);
					const xFloat = ((lon + 180) / 360) * n;
					const latRad = (lat * Math.PI) / 180;
					const yFloat =
						((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / Math.PI) / 2) * n;

					const tileX = Math.floor(xFloat);
					const tileY = Math.floor(yFloat);
					const px = Math.floor((xFloat - tileX) * 256);
					const py = Math.floor((yFloat - tileY) * 256);

					let finalizado = false;
					const resolverSeguro = (valor) => {
						if (!finalizado) {
							finalizado = true;
							clearTimeout(timerTile);
							resolve(valor);
						}
					};
					const timerTile = setTimeout(() => resolverSeguro({ disponible: false }), 3500);

					const img = new Image();
					img.crossOrigin = 'anonymous';
					img.onload = () => {
						try {
							const offCanvas = document.createElement('canvas');
							offCanvas.width = 256;
							offCanvas.height = 256;
							const ctx = offCanvas.getContext('2d');
							ctx.drawImage(img, 0, 0);

							if (canvasMuestra) {
								const ctxMini = canvasMuestra.getContext('2d');
								ctxMini.imageSmoothingEnabled = false;
								const radioVista = 10;
								const sx = Math.max(0, Math.min(256 - radioVista * 2, px - radioVista));
								const sy = Math.max(0, Math.min(256 - radioVista * 2, py - radioVista));
								ctxMini.clearRect(0, 0, 46, 46);
								ctxMini.drawImage(img, sx, sy, radioVista * 2, radioVista * 2, 0, 0, 46, 46);
								ctxMini.strokeStyle = 'rgba(255, 255, 255, 0.9)';
								ctxMini.lineWidth = 1.5;
								ctxMini.strokeRect(18, 18, 10, 10);
							}

							const radio = 4;
							const x0 = Math.max(0, px - radio);
							const y0 = Math.max(0, py - radio);
							const w = Math.min(255, px + radio) - x0 + 1;
							const h = Math.min(255, py + radio) - y0 + 1;
							const imgData = ctx.getImageData(x0, y0, w, h).data;

							let totalPixeles = 0;
							let pixelesVegetacion = 0;
							let pixelesTierraArada = 0;
							let pixelesHieloNieve = 0;
							let pixelesGrisArtificialORoca = 0;

							for (let i = 0; i < imgData.length; i += 4) {
								const r = imgData[i];
								const g = imgData[i + 1];
								const b = imgData[i + 2];
								totalPixeles++;

								const maxC = Math.max(r, g, b);
								const minC = Math.min(r, g, b);
								const delta = maxC - minC;
								const saturacion = maxC === 0 ? 0 : delta / maxC;
								const brillo = (r + g + b) / 3;

								const exG = 2 * g - r - b;
								const indiceTierra = r - b;

								if (brillo >= 205 && (saturacion < 0.2 || b >= r - 5)) {
									pixelesHieloNieve++;
								} else if (exG >= 12 && g >= r - 5 && brillo > 25 && brillo < 205) {
									pixelesVegetacion++;
								} else if (
									r > g &&
									g >= b - 4 &&
									indiceTierra >= 20 &&
									saturacion >= 0.16 &&
									brillo > 45 &&
									brillo < 205
								) {
									pixelesTierraArada++;
								} else if (
									saturacion < 0.17 ||
									(Math.abs(r - g) <= 12 && Math.abs(g - b) <= 14 && exG < 10)
								) {
									pixelesGrisArtificialORoca++;
								} else {
									if (exG >= 6 || indiceTierra >= 16) {
										pixelesTierraArada++;
									} else {
										pixelesGrisArtificialORoca++;
									}
								}
							}

							const pctVeg = Math.round((pixelesVegetacion / totalPixeles) * 100);
							const pctTierra = Math.round((pixelesTierraArada / totalPixeles) * 100);
							const pctHielo = Math.round((pixelesHieloNieve / totalPixeles) * 100);
							const pctAsfalto = Math.max(0, 100 - pctVeg - pctTierra - pctHielo);

							resolverSeguro({
								disponible: true,
								pctVeg,
								pctTierra,
								pctHielo,
								pctAsfalto,
								esHieloONieve: pctHielo >= 45 || (pctHielo + pctAsfalto >= 65 && Math.abs(lat) >= 58),
								esSuperficieGrisSinSuelo: pctAsfalto + pctHielo >= 58 && pctVeg + pctTierra <= 42,
							});
						} catch {
							resolverSeguro({ disponible: false });
						}
					};
					img.onerror = () => resolverSeguro({ disponible: false });
					img.src = `https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/${zoom}/${tileY}/${tileX}`;
				});
			}

