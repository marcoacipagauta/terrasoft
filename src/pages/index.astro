			 */
			function exportarInformeCSV() {
				if (!ultimoClima) {
					alert('Primero espera a que se carguen los datos climáticos de la parcela.');
					return;
				}

				const cultivoActualId = selectCultivo?.value || 'papa';
				const objCultivoActual = catalogoCultivos.find((c) => c.id === cultivoActualId);
				const { etiquetaArea } = obtenerAreaEnHectareas();

				const escapar = (val) => `"${String(val ?? '').replace(/"/g, '""')}"`;

				const lineas = [
					['INFORME TECNICO DE ROTACION Y COSTOS AGRICOLAS - TERRASOFT'],
					['Fecha de generacion', new Date().toLocaleString('es-CO')],
					['Coordenadas', `Lat ${ultimoClima.coordenadas.lat}, Lon ${ultimoClima.coordenadas.lon}`],
					['Ubicacion', ultimoClima.terreno?.ubicacionNombre || ''],
					['Estado del Terreno', ultimoClima.terreno?.etiqueta || ''],
					['Area del Lote', etiquetaArea],
					['Cultivo Actual', objCultivoActual?.nombre || cultivoActualId],
					['Temp. Maxima Promedio Anual (C)', ultimoClima.promedios.tempMax],
					['Lluvia Total Anual (mm)', ultimoClima.promedios.lluviaTotalAnual],
					['Zona Agroecologica FAO GAEZ v4', ultimoClima.faoGaez?.zonaAgroecologica || ''],
					['Altitud Media FAO LR (m s.n.m.)', ultimoClima.faoGaez?.altitudMsnm ?? ''],
					['Pendiente del Terreno FAO LR', ultimoClima.faoGaez?.pendienteTexto || ''],
					['Estado de Reserva / Area Protegida FAO', ultimoClima.faoGaez?.areaProtegidaTexto || ''],
					['Proyeccion Climatica 2050 (RCP 4.5)', ultimoClima.faoGaez?.proyeccionClimatica2050 || ''],
					['Periodo de Crecimiento Agricola FAO LGP (dias/ano)', ultimoClima.faoGaez?.lgpDias ?? ''],
					['Aptitud Edafica FAO GAEZ', ultimoClima.faoGaez?.etiquetaSueloFao || ''],
					[],
					['1. RECOMENDACIONES DE ROTACION, CALENDARIO Y PRESUPUESTO (COP)'],
					[
						'Ranking',
						'Cultivo Recomendado',
						'Familia Botanica',
						'Compatibilidad (%)',
						'Ciclo',
						'Demanda Agua',
						'Estado Fecha Actual',
						'Meses Optimos de Siembra',
						'Inversion Total Estimada (COP)',
						'Costo Semilla (COP)',
						'Costo Mano de Obra (COP)',
						'Costo Fertilizantes (COP)',
						'Costo Fitosanitarios (COP)',
						'Ahorro por Nitrogeno Previo (COP)',
						'Produccion Estimada Lote',
						'Justificacion Tecnica',
					],
				];

				ultimasRecomendaciones.forEach((item, idx) => {
					const p = item.presupuesto;
					const mesesTexto = (item.mesesSiembra || [])
						.map((num) => NOMBRES_MESES_LARGO[num - 1])
						.join(' - ');

					lineas.push([
						`#${idx + 1}`,
						item.nombre,
						item.familia,
						`${item.score}%`,
						item.cicloDias,
						item.agua,
						item.evalCal.titulo,
						mesesTexto,
						p.costoTotalNeto,
						p.rubSemilla,
						p.rubManoObra,
						p.rubFertilizantes,
						p.rubFitosanitarios,
						p.ahorroNitrogeno,
						p.rendimientoTexto,
						item.razones.join(' | '),
					]);
				});

				lineas.push(
					[],
					['2. HISTORICO CLIMATICO MENSUAL NASA POWER (2023)'],
					['Mes', 'Lluvia Mensual Total (mm)', 'Lluvia Promedio Diaria (mm/dia)', 'Temperatura Maxima Promedio (C)']
				);

				(ultimoClima.mensual || []).forEach((m) => {
					lineas.push([m.mes, m.lluviaTotal, m.lluviaPromedioDiaria, m.tempMaxPromedio]);
				});

				// Usamos punto y coma (;) y BOM UTF-8 para apertura directa en Excel en español
				const contenidoCsv = '\uFEFF' + lineas.map((fila) => fila.map(escapar).join(';')).join('\r\n');
				const blob = new Blob([contenidoCsv], { type: 'text/csv;charset=utf-8;' });
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = `Informe_TerraSoft_${ultimoClima.coordenadas.lat}_${ultimoClima.coordenadas.lon}.csv`;
				document.body.appendChild(a);
				a.click();
				document.body.removeChild(a);
				URL.revokeObjectURL(url);
			}

			document.getElementById('btn-exportar-pdf')?.addEventListener('click', exportarInformeDetalladoPDF);
			document.getElementById('btn-exportar-csv')?.addEventListener('click', exportarInformeCSV);

			btnAnalizar?.addEventListener('click', () => {
				const lat = parseFloat(inputLat?.value || '5.79482');
				const lon = parseFloat(inputLon?.value || '-72.99667');
				consultarParcela(lat, lon);
			});

			formTerraSync?.addEventListener('submit', (e) => {
				e.preventDefault();
				const lat = parseFloat(inputLat?.value || '5.79482');
				const lon = parseFloat(inputLon?.value || '-72.99667');
				consultarParcela(lat, lon);
			});

			const latInicial = parseFloat(inputLat?.value || '5.79482');
			const lonInicial = parseFloat(inputLon?.value || '-72.99667');
			consultarParcela(latInicial, lonInicial);
		});
	</script>
</Layout>
