			}

			function calcularYRenderizarRotacion(clima) {
				if (!rotationContainer || !catalogoCultivos.length) return;

				const cultivoActualId = selectCultivo?.value || 'papa';
				const objCultivoActual = catalogoCultivos.find((c) => c.id === cultivoActualId);
				if (chipCultivoOrigen && objCultivoActual) {
					chipCultivoOrigen.textContent = objCultivoActual.nombre.split('(')[0].trim();
				}

				if (clima?.terreno && !clima.terreno.aptoParaSiembra) {
					renderizarTerrenoNoApto(clima);
					return;
				}

				badgeEstadoRotacion.className =
					'badge bg-success-subtle text-success border border-success-subtle';

				const prioridad = selectPrioridad?.value || 'suelo';
				const lluviaTotalAnual = clima?.promedios?.lluviaTotalAnual;
				const tempMaxPromedio = clima?.promedios?.tempMax;
				const ubicacionTexto = (clima?.terreno?.ubicacionNombre || '').toLowerCase();

				const evaluados = catalogoCultivos.map((cultivo) => {
					let puntaje = 52;
					const razones = [];
					const chips = [];

					// Evaluación de calendario respecto a la fecha actual
					const evalCal = evaluarCalendarioSiembra(cultivo, clima?.mensual);
					puntaje += evalCal.bonoPuntaje;

					// Cálculo de costos para el área del lote ingresada
					const presupuesto = calcularPresupuestoLote(cultivo, objCultivoActual);

					// 0. Vocación Regional por Departamento en Colombia
					if (Array.isArray(cultivo.departamentos) && ubicacionTexto) {
						const deptoCoincidente = cultivo.departamentos.find((dep) =>
							ubicacionTexto.includes(dep.toLowerCase())
						);
						if (deptoCoincidente) {
							puntaje += 14;
							chips.push({ texto: `🇨🇴 Vocación en ${deptoCoincidente}`, clase: 'bg-success-subtle text-success-emphasis' });
							razones.push(`Vocación productiva comprobada en ${deptoCoincidente} (${cultivo.macroregion}).`);
						}
					}

					// 1. Prioridad del agricultor
					if (prioridad === 'agua') {
						if (cultivo.agua === 'baja') {
							puntaje += 20;
							chips.push({ texto: '💧 Ahorro Hídrico', clase: 'bg-info-subtle text-info-emphasis' });
							razones.push('Baja demanda de agua, ideal para tu prioridad de ahorro hídrico.');
						} else if (cultivo.agua === 'media') {
							puntaje += 8;
						} else {
							puntaje -= 12;
						}
					} else if (prioridad === 'suelo') {
						if (cultivo.beneficio === 'mejora_suelo_nitrogeno') {
							puntaje += 24;
							chips.push({ texto: '🌱 Fija Nitrógeno', clase: 'bg-success-subtle text-success-emphasis' });
							razones.push(`Leguminosa fijadora de nitrógeno que restaura el suelo.`);
						} else if (cultivo.id === 'avena_forrajera' || cultivo.id === 'cebada') {
							puntaje += 12;
							chips.push({ texto: '🌾 Abono Verde', clase: 'bg-success-subtle text-success-emphasis' });
							razones.push('Aporta materia orgánica y descompacta el suelo.');
						}
					} else if (prioridad === 'rentabilidad') {
						if (cultivo.beneficio === 'rentabilidad') {
							puntaje += 22;
							chips.push({ texto: '💰 Alta Rentabilidad', clase: 'bg-warning-subtle text-warning-emphasis' });
							razones.push('Excelente retorno comercial en mercados regionales.');
						} else if (cultivo.beneficio === 'mejora_suelo_nitrogeno') {
							puntaje += 10;
							razones.push('Ahorra fertilizantes nitrogenados en la cosecha posterior.');
						}
					}

					// 2. Rotación de Familias Botánicas
					if (cultivoActualId === cultivo.id) {
						puntaje -= 35;
						razones.push(`⚠️ Monocultivo: evita repetir el mismo cultivo consecutivo.`);
					} else if (
						Array.isArray(cultivo.evitarDespuesDe) &&
						cultivo.evitarDespuesDe.includes(cultivoActualId)
					) {
						puntaje -= 20;
						razones.push(`⚠️ Comparte ciclo sanitario (${cultivo.familia}) con tu cultivo actual.`);
					} else if (objCultivoActual && objCultivoActual.familia !== cultivo.familia) {
						puntaje += 14;
						chips.push({ texto: '🧬 Corta Plagas', clase: 'bg-secondary-subtle text-secondary-emphasis' });
						razones.push(`Alterna de ${objCultivoActual.familia} a ${cultivo.familia}, rompiendo plagas.`);
					}

					// 3. Compatibilidad con Rango Térmico (NASA POWER)
					if (typeof tempMaxPromedio === 'number' && Array.isArray(cultivo.tempOptima)) {
						const [tMin, tMax] = cultivo.tempOptima;
						if (tempMaxPromedio >= tMin && tempMaxPromedio <= tMax) {
							puntaje += 20;
							chips.push({ texto: `🌡️ Clima Ideal (${tMin}–${tMax}°C)`, clase: 'bg-danger-subtle text-danger-emphasis' });
							razones.push(`La temperatura de la parcela (${tempMaxPromedio} °C) encaja en su óptimo (${tMin}–${tMax} °C).`);
						} else {
							const desviacion = tempMaxPromedio < tMin ? tMin - tempMaxPromedio : tempMaxPromedio - tMax;
							if (desviacion <= 2.5) {
								puntaje += 4;
								razones.push(`Temperatura cercana a su rango óptimo (${tMin}–${tMax} °C).`);
							} else {
								puntaje -= Math.min(35, Math.round(desviacion * 4));
								razones.push(`Fuera de su piso térmico ideal (${tMin}–${tMax} °C vs ${tempMaxPromedio} °C local).`);
							}
						}
					}

					// 4. Compatibilidad con Precipitación Anual (NASA POWER)
					if (typeof lluviaTotalAnual === 'number' && Array.isArray(cultivo.lluviaOptima)) {
						const [lMin, lMax] = cultivo.lluviaOptima;
						if (lluviaTotalAnual >= lMin && lluviaTotalAnual <= lMax) {
							puntaje += 16;
							razones.push(`Lluvia local (${lluviaTotalAnual} mm/año) óptima para su rango (${lMin}–${lMax} mm).`);
						} else if (lluviaTotalAnual < lMin) {
							if (cultivo.agua === 'baja') {
								puntaje += 6;
								razones.push(`Tolera bien lluvias moderadas/bajas (${lluviaTotalAnual} mm/año).`);
							} else {
								puntaje -= 16;
								razones.push(`Lluvia insuficiente (${lluviaTotalAnual} mm vs ${lMin} mm mín.): requiere riego.`);
							}
						} else {
							if (cultivo.agua === 'alta') {
								puntaje += 6;
								razones.push(`Buena oferta hídrica (${lluviaTotalAnual} mm/año); cuidar drenaje.`);
							} else {
								puntaje -= 12;
								razones.push(`Exceso de lluvia (${lluviaTotalAnual} mm/año) frente a su óptimo (${lMax} mm).`);
							}
						}
					}

					const score = Math.max(15, Math.min(99, Math.round(puntaje)));
					return {
						...cultivo,
						score,
						razones: razones.slice(0, 3),
						chips: chips.slice(0, 3),
						evalCal,
						presupuesto,
					};
				});

				evaluados.sort((a, b) => b.score - a.score);
				const topRecomendados = evaluados.slice(0, 3);
				ultimasRecomendaciones = topRecomendados;

				if (chipCultivoDestino && topRecomendados[0]) {
					chipCultivoDestino.className = 'badge bg-success text-white';
					chipCultivoDestino.textContent = `${topRecomendados[0].nombre.split('(')[0].trim()} (${topRecomendados[0].score}%)`;
				}

				if (clima?.coordenadas) {
					subtituloRotacion.textContent = `${lluviaTotalAnual} mm/año | ${tempMaxPromedio} °C`;
					badgeEstadoRotacion.textContent = `Top #1: ${topRecomendados[0].nombre.split('(')[0].trim()} (${topRecomendados[0].score}%)`;
				}

				rotationContainer.innerHTML = topRecomendados
					.map((item, idx) => {
						const infoAgua = etiquetasAgua[item.agua] || {
							texto: `Agua: ${item.agua}`,
							badge: 'bg-secondary',
						};
						const infoBeneficio = etiquetasBeneficio[item.beneficio] || {
							titulo: item.beneficio,
							descripcion: '',
							icono: '🌿',
						};
						const esMejor = idx === 0;
						const barColor = item.score >= 80 ? 'bg-success' : item.score >= 60 ? 'bg-primary' : 'bg-warning';
						const mesesOptimos = Array.isArray(item.mesesSiembra) ? item.mesesSiembra : [3, 4, 5, 9, 10];
						const collapseId = `desglose-costos-${item.id}-${idx}`;

						// Cinta visual de los 12 meses del año
						const htmlMeses = NOMBRES_MESES_CORTO.map((nomMes, mIdx) => {
							const numMes = mIdx + 1;
							const esOptimo = mesesOptimos.includes(numMes);
							const esActual = numMes === mesActualNum;
							const tituloMes = `${NOMBRES_MESES_LARGO[mIdx]}${esActual ? ' (MES ACTUAL)' : ''}: ${
								esOptimo ? '✅ Mes óptimo de siembra' : 'Fuera de ventana principal'
							}`;
							return `<div class="ts-cal-month ${esOptimo ? 'optimal' : ''} ${
								esActual ? 'current' : ''
							}" title="${tituloMes}">${nomMes}${esActual ? '📍' : ''}</div>`;
						}).join('');

						const p = item.presupuesto;

						return `
						<div class="col-12 ts-animate-in" style="animation-delay: ${idx * 45}ms;">
							<div class="card ts-card shadow-sm ${esMejor ? 'ts-card-top1' : ''}">
								<div class="card-body p-3">
									<!-- Fila 1: Nombre, Píldoras y Porcentaje -->
									<div class="row align-items-center g-2">
										<div class="col-md-8">
											<div class="d-flex align-items-center gap-2 mb-1">
												<span class="badge ${esMejor ? 'bg-success' : 'bg-secondary'}">#${idx + 1}</span>
												<span class="fs-5">${infoBeneficio.icono}</span>
												<h3 class="h6 mb-0 fw-bold text-dark">${item.nombre}</h3>
											</div>
											<div class="d-flex flex-wrap gap-1 mb-1">
												<span class="badge bg-light text-secondary border">${item.familia}</span>
												<span class="badge ${infoAgua.badge}">${infoAgua.texto}</span>
												<span class="badge bg-light text-dark border">⏱️ ${item.cicloDias}</span>
												${item.chips
													.map((ch) => `<span class="badge ${ch.clase}">${ch.texto}</span>`)
													.join('')}
											</div>
										</div>

										<div class="col-md-4 text-md-end">
											<div class="d-flex justify-content-md-end align-items-baseline gap-2 mb-1">
												<span class="text-muted small">Afinidad:</span>
												<span class="fs-5 fw-bold ${esMejor ? 'text-success' : 'text-dark'}">${item.score}%</span>
											</div>
											<div class="progress" style="height: 7px;">
												<div class="progress-bar ${barColor}" role="progressbar" style="width: ${item.score}%"></div>
											</div>
										</div>
									</div>

									<!-- Fila 2: Calendario Óptimo de Siembra y Consejo para la Fecha Actual -->
									<div class="mt-2 pt-2 border-top">
										<div class="d-flex flex-wrap justify-content-between align-items-center gap-1 mb-1">
											<span class="badge ${item.evalCal.badgeClase}" style="font-size: 0.74rem;">
												${item.evalCal.icono} ${item.evalCal.titulo}
											</span>
											<span class="text-muted" style="font-size: 0.7rem;">
												🟩 = Meses óptimos &nbsp;|&nbsp; 📍 = Mes actual (${nombreMesActual})
											</span>
										</div>
										<div class="ts-cal-grid mb-1">${htmlMeses}</div>
										<div class="text-secondary" style="font-size: 0.76rem;">
											${item.evalCal.consejo}
										</div>
									</div>

									<!-- Fila 3: Presupuesto Estimado para el Lote (COP $) + Botón Desglose -->
									<div class="mt-2 ts-cost-panel">
										<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
											<div>
												<span class="text-secondary fw-semibold small">
													💵 Inversión Estimada (${p.etiquetaArea}):
												</span>
												<span class="fs-6 fw-bold text-success ms-1">
													${formatoCOP.format(p.costoTotalNeto)}
												</span>
												<span class="badge bg-white text-secondary border ms-1" style="font-size: 0.7rem;">
													📦 Prod. est.: ~${p.rendimientoTexto}
												</span>
												${
													p.ahorroNitrogeno > 0
														? `<div class="text-success fw-semibold" style="font-size: 0.73rem;">
															🌱 Incl. ahorro de ${formatoCOP.format(p.ahorroNitrogeno)} en fertilizante por nitrógeno fijado del cultivo previo
														   </div>`
														: ''
												}
											</div>
											<button
												class="btn btn-outline-secondary btn-sm py-0 px-2"
												style="font-size: 0.74rem;"
												type="button"
												data-bs-toggle="collapse"
												data-bs-target="#${collapseId}"
											>
												📋 Ver desglose de gastos
											</button>
										</div>

										<!-- Desglose colapsable por rubros -->
										<div class="collapse mt-2 pt-2 border-top" id="${collapseId}">
											<div class="row g-2 text-center" style="font-size: 0.75rem;">
												<div class="col-6 col-sm-3">
													<div class="p-1 bg-white rounded border">
														<div class="text-muted">🌱 Semilla/Colino</div>
														<div class="fw-bold text-dark">${formatoCOP.format(p.rubSemilla)}</div>
													</div>
												</div>
												<div class="col-6 col-sm-3">
													<div class="p-1 bg-white rounded border">
														<div class="text-muted">🚜 Mano de Obra</div>
														<div class="fw-bold text-dark">${formatoCOP.format(p.rubManoObra)}</div>
													</div>
												</div>
												<div class="col-6 col-sm-3">
													<div class="p-1 bg-white rounded border">
														<div class="text-muted">🧪 Fertilizantes</div>
														<div class="fw-bold text-success">${formatoCOP.format(p.rubFertilizantes)}</div>
													</div>
												</div>
												<div class="col-6 col-sm-3">
													<div class="p-1 bg-white rounded border">
														<div class="text-muted">🛡️ Fitosanitarios</div>
														<div class="fw-bold text-dark">${formatoCOP.format(p.rubFitosanitarios)}</div>
