---
import Layout from '../layouts/Layout.astro';
import HeroSpace from '../components/HeroSpace.astro';
import MapSelector from '../components/MapSelector.astro';
import RotationCards from '../components/RotationCards.astro';
import AssistantTour from '../components/AssistantTour.astro';
import cultivos from '../data/cultivos.json';

// Agrupar cultivos por macroregión colombiana para el selector
const macroregiones = Array.from(new Set(cultivos.map((c) => c.macroregion || 'General')));
---

<Layout title="TerraSoft - Datos Espaciales para Decisiones en tu Campo">
	<!-- 0. HERO AERO-AGRÍCOLA + TARJETAS PUENTE -->
	<HeroSpace />

	<!-- DASHBOARD PRINCIPAL DE CONTROL EN UNA SOLA PÁGINA (OCULTO EN LA PORTADA INICIAL) -->
	<div class="container-fluid px-lg-4 pt-3 pb-4 d-none" id="simulador-rotacion">
		<!-- 1. BARRA SUPERIOR UNIFICADA DE CONTROL DEL DASHBOARD (STICKY) -->
		<div class="card ts-card ts-topbar shadow-sm mb-3">
			<div class="card-body py-2 px-3">
				<form id="form-terrasync" class="row g-2 align-items-center">
					<!-- Botón Volver a Portada + Selector de Cultivo Actual -->
					<div class="col-xl-4 col-lg-4 col-md-6 col-12 position-relative">
						<div class="d-flex align-items-center gap-2 w-100" style="min-width: 0;">
							<button
								type="button"
								id="btn-volver-portada-top"
								class="btn btn-sm rounded-pill fw-semibold px-2 flex-shrink-0"
								style="background: #0d2647; color: #ffffff; border: 1px solid #38bdf8;"
								title="Regresar a la página principal"
							>
								<span data-i18n="navBackShort">🏠 Portada</span>
							</button>
							<div class="input-group input-group-sm position-relative" id="grupo-selector-cultivo" style="min-width: 0; flex: 1 1 0%;">
								<label class="input-group-text border-0 fw-bold" for="select-cultivo" style="background: #f5b041; color: #071428; cursor: pointer;">
									🌾 <span class="d-none d-sm-inline ms-1" data-i18n="lblCurrentCrop">Cultivo Actual</span><span class="d-inline d-sm-none ms-1" data-i18n="lblCurrentCropShort">Cultivo</span>
								</label>
								<select
									id="select-cultivo"
									class="form-select form-select-sm fw-semibold"
									style="min-width: 0; width: 0; flex: 1 1 0%;"
									required
								>
									{
										macroregiones.map((macro) => (
											<optgroup label={`🇨🇴 ${macro}`} data-macro-es={macro}>
												{cultivos
													.filter((c) => (c.macroregion || 'General') === macro)
													.map((c) => (
														<option value={c.id} data-nombre-es={c.nombre}>{c.nombre}</option>
													))}
											</optgroup>
										))
									}
								</select>
							</div>
						</div>

						<!-- Menú Desplegable Táctil para Móvil / Emulador (< 992px) -->
						<div
							id="menu-cultivos-movil"
							class="d-none shadow-lg rounded-3 border bg-white text-dark position-absolute start-0 end-0 mt-1 mx-2"
							style="z-index: 1085; max-height: 290px; max-width: calc(100vw - 24px); overflow-y: auto; overflow-x: hidden; box-sizing: border-box; border-color: #0d2647 !important;"
						>
							<div class="d-flex justify-content-between align-items-center px-3 py-2 sticky-top" style="background: #0d2647; color: #fff;">
								<span class="fw-bold small text-truncate" data-i18n="lblMobileCropTitle">🌾 Selecciona tu Cultivo Actual</span>
								<button type="button" id="btn-cerrar-menu-cultivos" class="btn-close btn-close-white flex-shrink-0" style="font-size: 0.7rem;" aria-label="Cerrar"></button>
							</div>
							<div class="p-2" style="max-width: 100%; overflow-x: hidden;">
								{
									macroregiones.map((macro) => (
										<div class="mb-2">
											<div class="px-2 py-1 rounded fw-bold small text-truncate ts-macro-header-movil" data-macro-es={macro} style="background: #eef4fb; color: #0d2647; font-size: 0.74rem;">
												🇨🇴 {macro}
											</div>
											<div class="d-flex flex-column gap-1 mt-1">
												{cultivos
													.filter((c) => (c.macroregion || 'General') === macro)
													.map((c) => (
														<button
															type="button"
															class="btn btn-sm text-start py-1 px-2 border-0 rounded ts-item-cultivo-movil w-100"
															data-crop-select-id={c.id}
															data-nombre-es={c.nombre}
															data-familia-es={c.familia}
															style="font-size: 0.77rem; color: #0f172a; white-space: normal !important; word-break: break-word; line-height: 1.25;"
														>
															<strong>{c.nombre}</strong> <span class="text-muted" style="font-size: 0.69rem;">({c.familia})</span>
														</button>
													))}
											</div>
										</div>
									))
								}
							</div>
						</div>
					</div>

					<!-- Selector de Área del Lote para Cálculo de Costos -->
					<div class="col-xl-3 col-lg-3 col-md-6 col-12">
						<div class="input-group input-group-sm" id="grupo-area-lote">
							<span class="input-group-text fw-bold" style="background: #163a66; color: #38bdf8; border-color: rgba(56,189,248,0.35);" data-i18n="lblLotSize">📐 Lote</span>
							<input
								type="number"
								id="input-area-lote"
								class="form-control form-control-sm fw-bold"
								value="1200"
								min="10"
								step="any"
								title="Tamaño de tu lote o parcela"
							/>
							<select id="select-unidad-area" class="form-select form-select-sm bg-light fw-semibold" style="max-width: 112px; flex: 0 0 auto !important; width: auto !important;">
								<option value="m2" data-i18n="unitM2" selected>m² (Metros²)</option>
								<option value="fanegada" data-i18n="unitFanegada">Fanegadas</option>
								<option value="ha" data-i18n="unitHa">Hectáreas</option>
							</select>
						</div>
					</div>

					<!-- Selector Rápido de Prioridad (Botones Segmentados) -->
					<div class="col-xl-4 col-lg-3 col-md-8">
						<input type="hidden" id="select-prioridad" value="suelo" />
						<div class="btn-group w-100" role="group" aria-label="Prioridad del próximo ciclo">
							<button type="button" class="btn ts-priority-btn active" data-priority-val="suelo" data-i18n="prioSoil">
								🌱 Suelo
							</button>
							<button type="button" class="btn ts-priority-btn" data-priority-val="agua" data-i18n="prioWater">
								💧 Agua
							</button>
							<button type="button" class="btn ts-priority-btn" data-priority-val="rentabilidad" data-i18n="prioProfit">
								💰 Rentabilidad
							</button>
						</div>
					</div>

					<!-- Estado en Vivo y Botón Actualizar -->
					<div class="col-xl-1 col-lg-2 col-md-4 d-flex justify-content-end align-items-center gap-2">
						<div id="spinner-clima" class="spinner-border spinner-border-sm text-warning d-none" role="status">
							<span class="visually-hidden">Consultando...</span>
						</div>
						<button type="submit" id="btn-analizar" class="btn ts-btn-amber btn-sm w-100 fw-bold" title="Actualizar consulta satelital">
							🛰️
						</button>
					</div>
				</form>

				<!-- Cinta de Retroalimentación Instantánea en Móvil (< 992px) cuando se cambia el Cultivo, Área o Prioridad -->
				<div
					id="topbar-resumen-movil"
					class="d-lg-none mt-2 pt-2 border-top border-info border-opacity-25 d-flex justify-content-between align-items-center gap-2 small"
					style="max-width: 100%; overflow: hidden;"
				>
					<div class="d-flex align-items-center gap-1 text-truncate" style="font-size: 0.75rem; min-width: 0; flex: 1 1 0%; overflow: hidden;">
						<span class="text-info fw-semibold flex-shrink-0" data-i18n="lblMobileRot">Rotación:</span>
						<span class="text-white fw-bold text-truncate" style="max-width: 32%;" id="movil-chip-origen">Papa</span>
						<span class="text-warning flex-shrink-0">➔</span>
						<span class="badge text-dark fw-bold text-truncate" style="background: #f5b041; max-width: 52%; display: inline-block; vertical-align: middle;" id="movil-chip-destino">Calculando...</span>
					</div>
					<a
						href="#calendario-costos"
						class="btn btn-outline-info btn-sm py-0 px-2 rounded-pill flex-shrink-0 text-white"
						style="font-size: 0.71rem;"
						data-i18n="btnMobileSeeTop3"
					>
						Ver Top 3 ⬇
					</a>
				</div>
			</div>
		</div>

		<div id="alerta-error-clima" class="alert alert-danger small d-none mb-3 py-2"></div>

		<!-- 2. VISTA PRINCIPAL DIVIDIDA DEL DASHBOARD (TODO EL PROCESO EN UNA SOLA PÁGINA) -->
		<div class="row g-3 align-items-start">
			<!-- COLUMNA IZQUIERDA (5/12): Mapa Interactivo + Diagnóstico + KPIs NASA + Escáner RGB -->
			<div class="col-lg-5" id="datos-satelitales">
				<MapSelector />

				<div class="card ts-card shadow-sm border-0">
					<div class="card-body p-3">
						<!-- Banner de Aptitud de Superficie -->
						<div id="banner-terreno" class="alert alert-secondary small mb-2 py-2 px-3">
							Verificando superficie en el punto seleccionado...
						</div>

						<!-- Cinta de 3 KPIs Climáticos NASA POWER -->
						<div class="row g-2 text-center mb-2">
							<div class="col-4">
								<div class="ts-kpi-box">
									<div class="text-white-50" style="font-size: 0.7rem;" data-i18n="kpiTempLabel">🌡️ Temp. Máx</div>
									<div class="fw-bold fs-6" style="color: #fbbf24;" id="kpi-temp-max">-- °C</div>
									<div class="text-white-50" style="font-size: 0.68rem;" id="kpi-piso-termico">Piso térmico</div>
								</div>
							</div>
							<div class="col-4">
								<div class="ts-kpi-box">
									<div class="text-white-50" style="font-size: 0.7rem;" data-i18n="kpiLluviaLabel">🌧️ Lluvia Anual</div>
									<div class="fw-bold fs-6" style="color: #38bdf8;" id="kpi-lluvia-anual">-- mm</div>
									<div class="text-white-50" style="font-size: 0.68rem;" id="kpi-regimen-lluvia">Régimen</div>
								</div>
							</div>
							<div class="col-4">
								<div class="ts-kpi-box">
									<div class="text-white-50" style="font-size: 0.7rem;" data-i18n="kpiDiariaLabel">💧 Prom. Diario</div>
									<div class="fw-bold fs-6" style="color: #7dd3fc;" id="kpi-lluvia-diaria">-- mm/d</div>
									<div class="text-white-50" style="font-size: 0.68rem;" id="clima-coords-label">NASA 2023</div>
								</div>
							</div>
						</div>

						<!-- Escáner Óptico Satelital Integrado -->
						<div class="d-flex align-items-center gap-2 p-2 rounded mb-2" style="background: #0b213f; border: 1px solid rgba(56,189,248,0.3); color: #e2e8f0;">
							<canvas
								id="canvas-muestra-satelital"
								width="46"
								height="46"
								class="rounded flex-shrink-0"
								style="border: 1.5px solid #38bdf8;"
								title="Muestra satelital 6m x 6m bajo el marcador"
							></canvas>
							<div class="flex-grow-1" style="font-size: 0.75rem; min-width: 0;">
								<div class="fw-bold" style="color: #38bdf8;" id="titulo-espectral" data-i18n="scannerTitle">🔬 Escáner Óptico Satelital (Radio 4m)</div>
								<div class="text-white-50" id="detalle-espectral">Muestreando reflectancia RGB...</div>
							</div>
						</div>

						<!-- Panel de Zonificación Agroecológica, Topografía y Futuro Climático FAO GAEZ v4 (Datos Locales LR) -->
						<div class="p-2 rounded" style="background: linear-gradient(135deg, #071428 0%, #102a4c 100%); border: 1px solid rgba(245,176,65,0.45); color: #ffffff;" id="panel-fao-gaez">
							<div class="d-flex justify-content-between align-items-center gap-2 mb-1">
								<span class="fw-bold" style="font-size: 0.75rem; color: #f5b041;" data-i18n="faoPanelTitle">
									🌍 Zonificación y Topografía FAO GAEZ v4 (LR)
								</span>
								<a
									href="https://gaez.fao.org/pages/data-access-download"
									target="_blank"
									rel="noopener noreferrer"
									class="badge text-decoration-none"
									style="background: rgba(56,189,248,0.2); color: #7dd3fc; border: 1px solid rgba(56,189,248,0.4); font-size: 0.65rem;"
									title="Fuente oficial FAO Global Agro-Ecological Zones v4"
								>
									FAO LR Local + WMS ↗
								</a>
							</div>

							<div class="d-flex align-items-center gap-2 mb-2">
								<img
									id="img-mapa-fao"
									src="https://gaez-services.fao.org/server/rest/services/LR/ImageServer/exportImage?bbox=-73.2467,5.5448,-72.7467,6.0448&bboxSR=4326&size=160,160&imageSR=4326&format=png&transparent=true&f=image"
									alt="Mapa Raster FAO GAEZ LR"
									width="46"
									height="46"
									class="rounded flex-shrink-0"
									style="border: 1.5px solid #f5b041; background: #0d2647; object-fit: cover;"
									title="Raster regional extraído vía FAO GAEZ LR/ImageServer/exportImage"
								/>
								<div class="flex-grow-1" style="font-size: 0.73rem; min-width: 0; line-height: 1.35;">
									<div class="text-truncate" id="fao-zona-aez">
										<strong>AEZ:</strong> <span class="text-info">Consultando FAO GAEZ...</span>
									</div>
									<div class="d-flex flex-wrap gap-1 mt-1">
										<span class="badge" style="background: #163a66; color: #38bdf8; font-size: 0.67rem;" id="fao-lgp-dias">
											🌱 LGP: -- días/año
										</span>
										<span class="badge" style="background: #f5b041; color: #071428; font-size: 0.67rem;" id="fao-clase-suelo">
											Suelo FAO: --
										</span>
										<span class="badge" style="background: #1e293b; color: #fde68a; border: 1px solid rgba(253,230,138,0.4); font-size: 0.67rem;" id="fao-altitud">
											⛰️ -- m s.n.m.
										</span>
									</div>
								</div>
							</div>

							<!-- Cinta de Topografía (Pendiente), Reserva Protegida y Proyección Climática 2050 -->
							<div class="pt-1 border-top border-info border-opacity-25" style="font-size: 0.71rem; line-height: 1.38;">
								<div class="d-flex flex-wrap justify-content-between gap-1 text-white-50">
									<span id="fao-pendiente">📐 Pendiente: <strong class="text-white">--</strong></span>
									<span id="fao-area-protegida">🌳 Reserva: <strong class="text-success">Frontera agrícola</strong></span>
								</div>
								<div class="mt-1 px-2 py-1 rounded" style="background: rgba(56,189,248,0.12); color: #bae6fd;" id="fao-proyeccion-2050">
									🔮 <strong> Escenario 2050 (RCP 4.5):</strong> Evaluando transición agroecológica...
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- NUEVA TARJETA VISUAL: Radiografía de las 7 Propiedades del Suelo FAO GAEZ (SQ1 a SQ7 de Downloads\LR\soi1) -->
				<div class="card ts-card shadow-sm border-0 mt-3" id="card-propiedades-suelo-fao">
					<div class="card-header ts-card-header-space py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
						<span class="fw-bold text-warning small" data-i18n="faoSoilCardTitle">🧪 7 Propiedades del Suelo (FAO GAEZ SQ1–SQ7)</span>
						<span class="badge border" style="background: rgba(245,176,65,0.18); color: #f5b041; border-color: rgba(245,176,65,0.4) !important; font-size: 0.68rem;" data-i18n="faoSoilCardBadge">
							Rasters Locales LR/soi1
						</span>
					</div>
					<div class="card-body p-3">
						<div class="row g-2" id="contenedor-barras-sq">
							<div class="col-12 text-muted small">Cargando perfil físico-químico del suelo FAO...</div>
						</div>
					</div>
				</div>

				<!-- Tarjeta de Gráficos Climáticos NASA POWER (Siempre visible debajo del Escáner Óptico Satelital) -->
				<div class="card ts-card shadow-sm border-0 mt-3" id="card-graficos-nasa">
					<div class="card-header ts-card-header-space py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
						<span class="fw-bold text-info small" data-i18n="chartsCardTitle">📊 Gráficos Climáticos (NASA POWER)</span>
						<span class="badge border" style="background: rgba(56,189,248,0.18); color: #7dd3fc; border-color: rgba(56,189,248,0.4) !important; font-size: 0.7rem;" id="diagnostico-climatico">
							Histórico Mensual 2023
						</span>
					</div>
					<div class="card-body p-3">
						<div class="row g-3">
							<div class="col-12">
								<div class="p-2 px-3 rounded bg-light border">
									<h3 class="h6 fw-bold mb-1" style="color: #0d2647; font-size: 0.8rem;" data-i18n="chartRainTitle">
										🌧️ Precipitación Mensual Acumulada (mm)
									</h3>
									<div style="height: 175px;">
										<canvas id="chart-lluvia"></canvas>
									</div>
								</div>
							</div>
							<div class="col-12">
								<div class="p-2 px-3 rounded bg-light border">
									<h3 class="h6 fw-bold text-danger mb-1" style="font-size: 0.8rem;" data-i18n="chartTempTitle">
										🌡️ Temperatura Máxima Promedio Mensual (°C)
									</h3>
									<div style="height: 175px;">
										<canvas id="chart-temperatura"></canvas>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- COLUMNA DERECHA (7/12): Panel de Control con Top 3 Rotaciones, Calendario, Costos y Exportación -->
			<div class="col-lg-7" id="calendario-costos">
				<div class="card ts-card shadow-sm border-0">
					<div class="card-header ts-card-header-space py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
						<div class="d-flex align-items-center gap-2">
							<span class="fw-bold text-warning small" data-i18n="rightHeaderTitle">🌾 Top 3 Rotaciones, Calendario y Costos ($ COP)</span>
						</div>

						<!-- Botones de Exportación EXCLUSIVOS del Dashboard de Control -->
						<div class="d-flex align-items-center gap-2 flex-wrap">
							<span class="badge border" style="background: rgba(56,189,248,0.18); color: #7dd3fc; border-color: rgba(56,189,248,0.4) !important;" id="badge-estado-rotacion">
								Analizando...
							</span>
							<div class="btn-group btn-group-sm" role="group" aria-label="Exportar informe">
								<button
									type="button"
									id="btn-exportar-pdf"
									class="btn ts-btn-amber btn-sm fw-bold"
									title="Generar informe técnico completo en PDF / Vista de impresión"
									data-i18n="btnExportPdf"
								>
									📄 Informe PDF
								</button>
								<button
									type="button"
									id="btn-exportar-csv"
									class="btn btn-outline-info btn-sm fw-semibold text-white"
									title="Descargar tabla detallada para Excel (.csv)"
									data-i18n="btnExportCsv"
								>
									📥 Excel (.CSV)
								</button>
							</div>
						</div>
					</div>

					<div class="card-body p-3">
						<RotationCards />
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Asistente Didáctico e Interactivo "Don Terra" -->
	<AssistantTour />

	<!-- Chart.js CDN -->
	<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

	<!-- Lógica integrada del Dashboard: Clima + Suelo + Calendario Actual + Presupuesto COP -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const inputLat = document.getElementById('input-lat');
			const inputLon = document.getElementById('input-lon');
			const selectCultivo = document.getElementById('select-cultivo');
			const inputAreaLote = document.getElementById('input-area-lote');
			const selectUnidadArea = document.getElementById('select-unidad-area');
			const selectPrioridad = document.getElementById('select-prioridad');
			const priorityButtons = document.querySelectorAll('[data-priority-val]');
			const formTerraSync = document.getElementById('form-terrasync');
			const btnAnalizar = document.getElementById('btn-analizar');

			const spinnerClima = document.getElementById('spinner-clima');
			const climaCoordsLabel = document.getElementById('clima-coords-label');
			const alertaError = document.getElementById('alerta-error-clima');
			const bannerTerreno = document.getElementById('banner-terreno');
			const canvasMuestra = document.getElementById('canvas-muestra-satelital');
			const tituloEspectral = document.getElementById('titulo-espectral');
			const detalleEspectral = document.getElementById('detalle-espectral');

			const kpiTempMax = document.getElementById('kpi-temp-max');
			const kpiPisoTermico = document.getElementById('kpi-piso-termico');
			const kpiLluviaAnual = document.getElementById('kpi-lluvia-anual');
			const kpiRegimenLluvia = document.getElementById('kpi-regimen-lluvia');
			const kpiLluviaDiaria = document.getElementById('kpi-lluvia-diaria');
			const diagnosticoClimatico = document.getElementById('diagnostico-climatico');

			const seccionRotacion = document.getElementById('seccion-rotacion');
			const rotationContainer = document.getElementById('rotation-cards-container');
			const subtituloRotacion = document.getElementById('subtitulo-rotacion');
			const badgeEstadoRotacion = document.getElementById('badge-estado-rotacion');
			const chipCultivoOrigen = document.getElementById('chip-cultivo-origen');
