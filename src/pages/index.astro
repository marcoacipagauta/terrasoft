									<!-- Fila 4: Justificación Agronómica y Región -->
									<div class="mt-2 pt-2 border-top d-flex flex-wrap justify-content-between align-items-start gap-2">
										<ul class="small text-muted ps-3 mb-0 flex-grow-1" style="font-size: 0.78rem;">
											${item.razones.map((r) => `<li>${r}</li>`).join('')}
