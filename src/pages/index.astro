---
import Layout from '../layouts/Layout.astro';
import MapSelector from '../components/MapSelector.astro';
import RotationCards from '../components/RotationCards.astro';
import AssistantTour from '../components/AssistantTour.astro';
import cultivos from '../data/cultivos.json';

// Agrupar cultivos por macroregión colombiana para el selector
const macroregiones = Array.from(new Set(cultivos.map((c) => c.macroregion || 'General')));
---

<Layout title="TerraSync - Dashboard de Rotación Agrícola">
	<!-- 1. BARRA SUPERIOR UNIFICADA DE CONTROL (STICKY) -->
	<div class="card ts-card ts-topbar shadow-sm mb-3">
		<div class="card-body py-2 px-3">
			<form id="form-terrasync" class="row g-2 align-items-center">
				<!-- Selector de Cultivo Actual -->
				<div class="col-xl-4 col-lg-4 col-md-6">
					<div class="input-group input-group-sm">
						<label class="input-group-text bg-success text-white fw-semibold" for="select-cultivo">
							🌾 Cultivo Actual
						</label>
						<select id="select-cultivo" class="form-select form-select-sm fw-semibold" required>
							{
								macroregiones.map((macro) => (
									<optgroup label={`🇨🇴 ${macro}`}>
										{cultivos
											.filter((c) => (c.macroregion || 'General') === macro)
											.map((c) => (
												<option value={c.id}>
													{c.nombre} ({c.familia})
												</option>
											))}
									</optgroup>
								))
							}
						</select>
					</div>
				</div>

				<!-- Selector de Área del Lote para Cálculo de Costos -->
				<div class="col-xl-3 col-lg-3 col-md-6">
					<div class="input-group input-group-sm">
						<span class="input-group-text bg-light fw-semibold text-secondary">📐 Lote</span>
						<input
							type="number"
							id="input-area-lote"
							class="form-control form-control-sm fw-bold"
							value="1200"
							min="10"
							step="any"
							title="Tamaño de tu lote o parcela"
						/>
						<select id="select-unidad-area" class="form-select form-select-sm bg-light fw-semibold" style="max-width: 115px;">
							<option value="m2" selected>m² (Metros²)</option>
							<option value="fanegada">Fanegadas</option>
							<option value="ha">Hectáreas</option>
						</select>
					</div>
				</div>

				<!-- Selector Rápido de Prioridad (Botones Segmentados) -->
				<div class="col-xl-4 col-lg-3 col-md-8">
					<input type="hidden" id="select-prioridad" value="suelo" />
					<div class="btn-group w-100" role="group" aria-label="Prioridad del próximo ciclo">
						<button
							type="button"
							class="btn ts-priority-btn active"
							data-priority-val="suelo"
						>
							🌱 Suelo
						</button>
						<button
							type="button"
							class="btn ts-priority-btn"
							data-priority-val="agua"
						>
							💧 Agua
						</button>
						<button
							type="button"
							class="btn ts-priority-btn"
							data-priority-val="rentabilidad"
						>
							💰 Rentabilidad
						</button>
					</div>
				</div>

				<!-- Estado en Vivo y Botón Actualizar -->
				<div class="col-xl-1 col-lg-2 col-md-4 d-flex justify-content-end align-items-center gap-2">
					<div id="spinner-clima" class="spinner-border spinner-border-sm text-success d-none" role="status">
						<span class="visually-hidden">Consultando...</span>
					</div>
					<button type="submit" id="btn-analizar" class="btn btn-outline-success btn-sm w-100 fw-semibold" title="Actualizar consulta satelital">
						🛰️
					</button>
				</div>
			</form>
		</div>
	</div>

	<div id="alerta-error-clima" class="alert alert-danger small d-none mb-3 py-2"></div>

	<!-- 2. VISTA PRINCIPAL DIVIDIDA (2 COLUMNAS EN PARALELO) -->
	<div class="row g-3 align-items-start">
		<!-- COLUMNA IZQUIERDA (5/12): Mapa Interactivo + Cinta Compacta de Suelo y Clima -->
		<div class="col-lg-5">
			<MapSelector />

			<!-- Panel Compacto de Diagnóstico de Suelo y KPIs NASA POWER -->
			<div class="card ts-card shadow-sm border-0">
				<div class="card-body p-3">
					<!-- Banner de Aptitud de Superficie -->
					<div id="banner-terreno" class="alert alert-secondary small mb-2 py-2 px-3">
						Verificando superficie en el punto seleccionado...
					</div>

					<!-- Cinta de 3 KPIs Climáticos NASA POWER -->
					<div class="row g-2 text-center mb-2">
						<div class="col-4">
							<div class="ts-kpi-box">
								<div class="text-muted" style="font-size: 0.7rem;">🌡️ Temp. Máx</div>
								<div class="fw-bold text-danger fs-6" id="kpi-temp-max">-- °C</div>
								<div class="text-secondary" style="font-size: 0.68rem;" id="kpi-piso-termico">Piso térmico</div>
							</div>
						</div>
						<div class="col-4">
							<div class="ts-kpi-box">
								<div class="text-muted" style="font-size: 0.7rem;">🌧️ Lluvia Anual</div>
								<div class="fw-bold text-primary fs-6" id="kpi-lluvia-anual">-- mm</div>
								<div class="text-secondary" style="font-size: 0.68rem;" id="kpi-regimen-lluvia">Régimen</div>
							</div>
						</div>
						<div class="col-4">
							<div class="ts-kpi-box">
								<div class="text-muted" style="font-size: 0.7rem;">💧 Prom. Diario</div>
								<div class="fw-bold text-info fs-6" id="kpi-lluvia-diaria">-- mm/d</div>
								<div class="text-secondary" style="font-size: 0.68rem;" id="clima-coords-label">NASA 2023</div>
							</div>
						</div>
					</div>

					<!-- Escáner Óptico Satelital Integrado -->
					<div class="d-flex align-items-center gap-2 p-2 rounded bg-light border">
						<canvas
							id="canvas-muestra-satelital"
							width="46"
							height="46"
							class="rounded border border-secondary-subtle flex-shrink-0"
							title="Muestra satelital 6m x 6m bajo el marcador"
						></canvas>
						<div class="flex-grow-1" style="font-size: 0.75rem;">
							<div class="fw-bold text-dark" id="titulo-espectral">🔬 Escáner Óptico Satelital (Radio 4m)</div>
							<div class="text-muted" id="detalle-espectral">Muestreando reflectancia RGB...</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- COLUMNA DERECHA (7/12): Panel de Análisis con Pestañas (Recomendaciones vs Gráficos) -->
		<div class="col-lg-7">
			<div class="card ts-card shadow-sm border-0">
				<div class="card-header bg-white border-bottom py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
					<!-- Pestañas de Navegación -->
					<ul class="nav nav-pills" id="terrasync-tabs" role="tablist">
						<li class="nav-item" role="presentation">
							<button
								class="nav-link active btn-sm"
								id="tab-recomendaciones-btn"
								data-bs-toggle="pill"
								data-bs-target="#pane-recomendaciones"
								type="button"
								role="tab"
							>
								🌾 Top 3 Rotaciones, Calendario y Costos
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button
								class="nav-link btn-sm"
								id="tab-graficos-btn"
								data-bs-toggle="pill"
								data-bs-target="#pane-graficos"
								type="button"
								role="tab"
							>
								📊 Gráficos Climáticos (NASA POWER)
							</button>
						</li>
					</ul>

					<div class="d-flex align-items-center gap-2 flex-wrap">
						<span class="badge bg-success-subtle text-success border border-success-subtle" id="badge-estado-rotacion">
							Analizando...
						</span>
						<div class="btn-group btn-group-sm" role="group" aria-label="Exportar informe">
							<button
								type="button"
								id="btn-exportar-pdf"
								class="btn btn-success btn-sm fw-semibold"
								title="Generar informe técnico completo en PDF / Vista de impresión"
							>
								📄 Informe PDF
							</button>
							<button
								type="button"
								id="btn-exportar-csv"
								class="btn btn-outline-success btn-sm fw-semibold"
								title="Descargar tabla detallada para Excel (.csv)"
							>
								📥 Excel (.CSV)
							</button>
						</div>
					</div>
				</div>

				<div class="card-body p-3">
					<div class="tab-content">
						<!-- PESTAÑA 1: Top 3 Recomendaciones de Rotación + Calendario + Costos -->
						<div
							class="tab-pane fade show active"
							id="pane-recomendaciones"
							role="tabpanel"
						>
							<RotationCards />
						</div>

						<!-- PESTAÑA 2: Gráficos Históricos de Lluvia y Temperatura (NASA POWER) -->
						<div
							class="tab-pane fade"
							id="pane-graficos"
							role="tabpanel"
						>
							<div class="mb-2 d-flex justify-content-between align-items-center">
								<span class="fw-bold text-secondary small">
									Comportamiento Mensual Histórico (Enero – Diciembre 2023)
								</span>
								<span class="badge bg-light text-dark border small" id="diagnostico-climatico">
									Datos satelitales NASA POWER
								</span>
							</div>

							<div class="row g-3">
								<div class="col-12">
									<div class="p-3 rounded bg-light border">
										<h3 class="h6 fw-bold text-primary mb-2 small">
											🌧️ Precipitación Mensual Acumulada (mm)
										</h3>
										<div style="height: 210px;">
											<canvas id="chart-lluvia"></canvas>
										</div>
									</div>
								</div>
								<div class="col-12">
									<div class="p-3 rounded bg-light border">
										<h3 class="h6 fw-bold text-danger mb-2 small">
											🌡️ Temperatura Máxima Promedio Mensual (°C)
										</h3>
										<div style="height: 210px;">
											<canvas id="chart-temperatura"></canvas>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Asistente Didáctico e Interactivo "Don Terra" -->
	<AssistantTour />

	<!-- Chart.js CDN -->
	<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

	<!-- Lógica integrada del Dashboard: Clima + Suelo + Calendario Actual + Presupuesto COP -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const inputLat = document.getElementById('input-lat');
			const inputLon = document.getElementById('input-lon');
			const selectCultivo = document.getElementById('select-cultivo');
			const inputAreaLote = document.getElementById('input-area-lote');
			const selectUnidadArea = document.getElementById('select-unidad-area');
			const selectPrioridad = document.getElementById('select-prioridad');
			const priorityButtons = document.querySelectorAll('[data-priority-val]');
			const formTerraSync = document.getElementById('form-terrasync');
			const btnAnalizar = document.getElementById('btn-analizar');

			const spinnerClima = document.getElementById('spinner-clima');
			const climaCoordsLabel = document.getElementById('clima-coords-label');
			const alertaError = document.getElementById('alerta-error-clima');
			const bannerTerreno = document.getElementById('banner-terreno');
			const canvasMuestra = document.getElementById('canvas-muestra-satelital');
			const tituloEspectral = document.getElementById('titulo-espectral');
			const detalleEspectral = document.getElementById('detalle-espectral');

			const kpiTempMax = document.getElementById('kpi-temp-max');
			const kpiPisoTermico = document.getElementById('kpi-piso-termico');
			const kpiLluviaAnual = document.getElementById('kpi-lluvia-anual');
			const kpiRegimenLluvia = document.getElementById('kpi-regimen-lluvia');
			const kpiLluviaDiaria = document.getElementById('kpi-lluvia-diaria');
			const diagnosticoClimatico = document.getElementById('diagnostico-climatico');

			const seccionRotacion = document.getElementById('seccion-rotacion');
			const rotationContainer = document.getElementById('rotation-cards-container');
			const subtituloRotacion = document.getElementById('subtitulo-rotacion');
			const badgeEstadoRotacion = document.getElementById('badge-estado-rotacion');
			const chipCultivoOrigen = document.getElementById('chip-cultivo-origen');
			const chipCultivoDestino = document.getElementById('chip-cultivo-destino');
			const chipFechaActual = document.getElementById('chip-fecha-actual');

			const catalogoCultivos = JSON.parse(seccionRotacion?.dataset.cultivos || '[]');
			const etiquetasAgua = JSON.parse(seccionRotacion?.dataset.etiquetasAgua || '{}');
			const etiquetasBeneficio = JSON.parse(seccionRotacion?.dataset.etiquetasBeneficio || '{}');

			const NOMBRES_MESES_CORTO = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
			const NOMBRES_MESES_LARGO = [
				'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
				'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
			];

			const fechaHoy = new Date();
			const mesActualNum = fechaHoy.getMonth() + 1; // 1..12
			const nombreMesActual = NOMBRES_MESES_LARGO[mesActualNum - 1];

			if (chipFechaActual) {
				chipFechaActual.textContent = `📅 Hoy: ${fechaHoy.getDate()} de ${nombreMesActual}`;
			}

			const formatoCOP = new Intl.NumberFormat('es-CO', {
				style: 'currency',
				currency: 'COP',
				maximumFractionDigits: 0,
			});

			let ultimoClima = null;
			let ultimasRecomendaciones = [];
			let ultimoEspectral = null;
			let chartLluvia = null;
			let chartTemp = null;
			let controladorPeticion = null;

			/**
			 * Convierte el área ingresada por el usuario (m², fanegadas o ha) a Hectáreas (1 ha = 10,000 m², 1 fanegada = 6,400 m²).
			 */
			function obtenerAreaEnHectareas() {
				const valor = Math.max(1, parseFloat(inputAreaLote?.value || '1200') || 1200);
				const unidad = selectUnidadArea?.value || 'm2';
				if (unidad === 'ha') {
					return { areaHa: valor, etiquetaArea: `${valor} ha` };
				}
				if (unidad === 'fanegada') {
					return { areaHa: (valor * 6400) / 10000, etiquetaArea: `${valor} fanegada(s)` };
				}
				return { areaHa: valor / 10000, etiquetaArea: `${valor.toLocaleString('es-CO')} m²` };
			}

			/**
			 * Evalúa si el mes actual es ideal para sembrar el cultivo y genera el consejo para el campesino.
			 */
			function evaluarCalendarioSiembra(cultivo, mensualNasa) {
				const mesesOptimos = Array.isArray(cultivo.mesesSiembra) ? cultivo.mesesSiembra : [3, 4, 5, 9, 10];
				const mesSiguiente = (mesActualNum % 12) + 1;
				const lluviaMesActual = Array.isArray(mensualNasa) && mensualNasa[mesActualNum - 1]
					? mensualNasa[mesActualNum - 1].lluviaTotal
					: null;

				const textoLluviaMes =
					typeof lluviaMesActual === 'number'
						? ` (Histórico NASA en ${nombreMesActual}: ${lluviaMesActual} mm)`
						: '';

				if (mesesOptimos.includes(mesActualNum)) {
					return {
						estado: 'ideal',
						bonoPuntaje: 10,
						badgeClase: 'bg-success text-white',
						icono: '🟢',
						titulo: `¡Fecha Ideal! ${nombreMesActual} está en ventana óptima de siembra`,
						consejo: `Puedes iniciar la siembra ahora en ${nombreMesActual}${textoLluviaMes}. ${cultivo.notaCalendario || ''}`,
					};
				}

				if (mesesOptimos.includes(mesSiguiente)) {
					const nombreSig = NOMBRES_MESES_LARGO[mesSiguiente - 1];
					return {
						estado: 'preparacion',
						bonoPuntaje: 4,
						badgeClase: 'bg-warning text-dark',
						icono: '🟡',
						titulo: `Etapa de Preparación: Siembra óptima inicia el próximo mes (${nombreSig})`,
						consejo: `Aprovecha ${nombreMesActual} para preparar el suelo, aplicar correctivos y conseguir semilla certificada para sembrar en ${nombreSig}.`,
					};
				}

				// Buscar el próximo mes óptimo en el calendario
				let proximoMes = mesesOptimos[0];
				for (let offset = 1; offset <= 12; offset++) {
					const candidato = ((mesActualNum - 1 + offset) % 12) + 1;
					if (mesesOptimos.includes(candidato)) {
						proximoMes = candidato;
						break;
					}
				}
				const nombreProx = NOMBRES_MESES_LARGO[proximoMes - 1];

				return {
					estado: 'espera',
					bonoPuntaje: -6,
					badgeClase: 'bg-secondary-subtle text-secondary-emphasis border',
					icono: '⏳',
					titulo: `Fuera de temporada hoy (${nombreMesActual}) — Próxima ventana: ${nombreProx}`,
					consejo: `No se aconseja sembrar en ${nombreMesActual} a secano${textoLluviaMes}. Programa la siembra para ${nombreProx} o asegura riego suplementario.`,
				};
			}

			/**
			 * Calcula el presupuesto estimado del cultivo para el área del lote ingresada,
			 * aplicando descuento en fertilizantes si se rota después de una leguminosa.
			 */
			function calcularPresupuestoLote(cultivo, objCultivoActual) {
				const { areaHa, etiquetaArea } = obtenerAreaEnHectareas();
				const costoBaseHa = cultivo.costoTotalHaCOP || 10000000;
				const pcts = cultivo.desgloseCostosPct || {
					semilla: 22,
					manoObra: 35,
					fertilizantes: 25,
					fitosanitarios: 18,
				};

				const costoBrutoLote = costoBaseHa * areaHa;
				const rubSemilla = Math.round((costoBrutoLote * pcts.semilla) / 100);
				const rubManoObra = Math.round((costoBrutoLote * pcts.manoObra) / 100);
				let rubFertilizantes = Math.round((costoBrutoLote * pcts.fertilizantes) / 100);
				const rubFitosanitarios = Math.round((costoBrutoLote * pcts.fitosanitarios) / 100);

				// Si el cultivo anterior en la parcela fue una Leguminosa (Fabáceas) y el nuevo cultivo es diferente,
				// el nitrógeno biológico fijado ahorra ~18% en fertilizantes nitrogenados
				let ahorroNitrogeno = 0;
				if (
					objCultivoActual &&
					objCultivoActual.familia?.includes('Leguminosas') &&
					cultivo.id !== objCultivoActual.id
				) {
					ahorroNitrogeno = Math.round(rubFertilizantes * 0.18);
					rubFertilizantes -= ahorroNitrogeno;
				}

				const costoTotalNeto = rubSemilla + rubManoObra + rubFertilizantes + rubFitosanitarios;
				const rendimientoTonLote = Number(((cultivo.rendimientoTonHa || 5) * areaHa).toFixed(2));
				const rendimientoTexto =
					rendimientoTonLote >= 1
						? `${rendimientoTonLote} ton`
						: `${Math.round(rendimientoTonLote * 1000).toLocaleString('es-CO')} kg`;

				return {
					etiquetaArea,
					costoTotalNeto,
					ahorroNitrogeno,
					rubSemilla,
					rubManoObra,
					rubFertilizantes,
					rubFitosanitarios,
					rendimientoTexto,
				};
			}

			function analizarSuperficieSatelital(lat, lon) {
				return new Promise((resolve) => {
					const zoom = 18;
					const n = Math.pow(2, zoom);
					const xFloat = ((lon + 180) / 360) * n;
					const latRad = (lat * Math.PI) / 180;
					const yFloat =
						((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / Math.PI) / 2) * n;

					const tileX = Math.floor(xFloat);
					const tileY = Math.floor(yFloat);
					const px = Math.floor((xFloat - tileX) * 256);
					const py = Math.floor((yFloat - tileY) * 256);

					const img = new Image();
					img.crossOrigin = 'anonymous';
					img.onload = () => {
						try {
							const offCanvas = document.createElement('canvas');
							offCanvas.width = 256;
							offCanvas.height = 256;
							const ctx = offCanvas.getContext('2d');
							ctx.drawImage(img, 0, 0);

							if (canvasMuestra) {
								const ctxMini = canvasMuestra.getContext('2d');
								ctxMini.imageSmoothingEnabled = false;
								const radioVista = 10;
								const sx = Math.max(0, Math.min(256 - radioVista * 2, px - radioVista));
								const sy = Math.max(0, Math.min(256 - radioVista * 2, py - radioVista));
								ctxMini.clearRect(0, 0, 46, 46);
								ctxMini.drawImage(img, sx, sy, radioVista * 2, radioVista * 2, 0, 0, 46, 46);
								ctxMini.strokeStyle = 'rgba(255, 255, 255, 0.9)';
								ctxMini.lineWidth = 1.5;
								ctxMini.strokeRect(18, 18, 10, 10);
							}

							const radio = 4;
							const x0 = Math.max(0, px - radio);
							const y0 = Math.max(0, py - radio);
							const w = Math.min(255, px + radio) - x0 + 1;
							const h = Math.min(255, py + radio) - y0 + 1;
							const imgData = ctx.getImageData(x0, y0, w, h).data;

							let totalPixeles = 0;
							let pixelesVegetacion = 0;
							let pixelesTierraArada = 0;
							let pixelesHieloNieve = 0;
							let pixelesGrisArtificialORoca = 0;

							for (let i = 0; i < imgData.length; i += 4) {
								const r = imgData[i];
								const g = imgData[i + 1];
								const b = imgData[i + 2];
								totalPixeles++;

								const maxC = Math.max(r, g, b);
								const minC = Math.min(r, g, b);
								const delta = maxC - minC;
								const saturacion = maxC === 0 ? 0 : delta / maxC;
								const brillo = (r + g + b) / 3;

								const exG = 2 * g - r - b;
								const indiceTierra = r - b;

								if (brillo >= 205 && (saturacion < 0.2 || b >= r - 5)) {
									pixelesHieloNieve++;
								} else if (exG >= 12 && g >= r - 5 && brillo > 25 && brillo < 205) {
									pixelesVegetacion++;
								} else if (
									r > g &&
									g >= b - 4 &&
									indiceTierra >= 20 &&
									saturacion >= 0.16 &&
									brillo > 45 &&
									brillo < 205
								) {
									pixelesTierraArada++;
								} else if (
									saturacion < 0.17 ||
									(Math.abs(r - g) <= 12 && Math.abs(g - b) <= 14 && exG < 10)
								) {
									pixelesGrisArtificialORoca++;
								} else {
									if (exG >= 6 || indiceTierra >= 16) {
										pixelesTierraArada++;
									} else {
										pixelesGrisArtificialORoca++;
									}
								}
							}

							const pctVeg = Math.round((pixelesVegetacion / totalPixeles) * 100);
							const pctTierra = Math.round((pixelesTierraArada / totalPixeles) * 100);
							const pctHielo = Math.round((pixelesHieloNieve / totalPixeles) * 100);
							const pctAsfalto = Math.max(0, 100 - pctVeg - pctTierra - pctHielo);

							resolve({
								disponible: true,
								pctVeg,
								pctTierra,
								pctHielo,
								pctAsfalto,
								esHieloONieve: pctHielo >= 45 || (pctHielo + pctAsfalto >= 65 && Math.abs(lat) >= 58),
								esSuperficieGrisSinSuelo: pctAsfalto + pctHielo >= 58 && pctVeg + pctTierra <= 42,
							});
						} catch {
							resolve({ disponible: false });
						}
					};
					img.onerror = () => resolve({ disponible: false });
					img.src = `https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/${zoom}/${tileY}/${tileX}`;
				});
			}

			function inicializarGraficos() {
				const ctxLluvia = document.getElementById('chart-lluvia');
				const ctxTemp = document.getElementById('chart-temperatura');
				if (!ctxLluvia || !ctxTemp || typeof Chart === 'undefined') return;

				chartLluvia = new Chart(ctxLluvia, {
					type: 'bar',
					data: {
						labels: NOMBRES_MESES_CORTO,
						datasets: [
							{
								label: 'Precipitación (mm)',
								data: new Array(12).fill(0),
								backgroundColor: 'rgba(13, 110, 253, 0.65)',
								borderColor: 'rgb(13, 110, 253)',
								borderWidth: 1,
								borderRadius: 4,
							},
						],
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						scales: {
							y: { beginAtZero: true, title: { display: true, text: 'mm' } },
						},
					},
				});

				chartTemp = new Chart(ctxTemp, {
					type: 'line',
					data: {
						labels: NOMBRES_MESES_CORTO,
						datasets: [
							{
								label: 'Temp. Máx (°C)',
								data: new Array(12).fill(0),
								borderColor: 'rgb(220, 53, 69)',
								backgroundColor: 'rgba(220, 53, 69, 0.15)',
								tension: 0.3,
								fill: true,
								pointRadius: 4,
							},
						],
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						scales: {
							y: { title: { display: true, text: '°C' } },
						},
					},
				});
			}

			function actualizarGraficos(mensual) {
				if (!chartLluvia || !chartTemp || !Array.isArray(mensual)) return;
				const labels = mensual.map((m) => m.mes);
				const lluvias = mensual.map((m) => m.lluviaTotal);
				const temps = mensual.map((m) => m.tempMaxPromedio);

				chartLluvia.data.labels = labels;
				chartLluvia.data.datasets[0].data = lluvias;
				chartLluvia.update();

				chartTemp.data.labels = labels;
				chartTemp.data.datasets[0].data = temps;
				chartTemp.update();
			}

			function renderizarTerrenoNoApto(clima) {
				if (!rotationContainer || !clima?.terreno) return;
				const { terreno, coordenadas } = clima;

				const iconosPorTipo = {
					hielo_glaciar: '❄️',
					desierto_arido: '🏜️',
					cuerpo_agua: '🌊',
					asfalto_via: '🛣️',
					urbano_edificado: '🏙️',
					no_cultivable: '🪨',
				};
				const iconoPrincipal = iconosPorTipo[terreno.clasificacion] || '🚫';

				let consejoAccion =
					'Haz clic sobre los lotes verdes o de tierra arada alrededor de la vía, o confirma manualmente si estás en tierra cultivable.';
				if (terreno.clasificacion === 'hielo_glaciar') {
					consejoAccion =
						'Esta coordenada se encuentra en una región polar, glaciar o de congelamiento permanente (permafrost/nieve). Selecciona una región templada o tropical con suelo agrícola descubierto.';
				} else if (terreno.clasificacion === 'desierto_arido') {
					consejoAccion =
						'Esta coordenada presenta aridez extrema sin lluvias suficientes para agricultura de secano.';
				} else if (terreno.clasificacion === 'cuerpo_agua') {
					consejoAccion =
						'El marcador está sobre el océano, un lago o un río. Selecciona una parcela en tierra firme.';
				} else if (terreno.clasificacion === 'no_cultivable') {
					consejoAccion =
						'El punto presenta roca desnuda o suelo estéril sin cobertura vegetal. Desplaza el marcador hacia una zona con suelo fértil.';
				}

				if (chipCultivoDestino) {
					chipCultivoDestino.className = 'badge bg-danger text-white';
					chipCultivoDestino.textContent = 'No Cultivable';
				}
				subtituloRotacion.textContent = `Lat ${coordenadas.lat}, Lon ${coordenadas.lon}`;
				badgeEstadoRotacion.className = 'badge bg-danger text-white';
				badgeEstadoRotacion.textContent = `${iconoPrincipal} Siembra No Viable`;

				rotationContainer.innerHTML = `
					<div class="col-12 ts-animate-in">
						<div class="card border-danger border-2 shadow-sm">
							<div class="card-body p-3">
								<div class="d-flex align-items-center mb-2">
									<span class="fs-2 me-3">${iconoPrincipal}</span>
									<div>
										<h3 class="h6 fw-bold text-danger mb-1">
											No es posible sembrar aquí: ${terreno.etiqueta}
										</h3>
										<p class="text-muted small mb-0">
											<strong>Ubicación:</strong> ${terreno.ubicacionNombre}
										</p>
									</div>
								</div>
								<p class="mb-3 small text-dark">${terreno.motivo}</p>
								<div class="p-2 px-3 bg-light rounded border small text-secondary d-flex flex-wrap justify-content-between align-items-center gap-2">
									<span><strong>💡 Sugerencia:</strong> ${consejoAccion}</span>
									<button type="button" id="btn-forzar-lote" class="btn btn-outline-success btn-sm fw-semibold">
										✅ Forzar simulación aquí
									</button>
								</div>
							</div>
						</div>
					</div>
				`;

				document.getElementById('btn-forzar-lote')?.addEventListener('click', () => {
					if (ultimoClima && ultimoClima.terreno) {
						ultimoClima.terreno.aptoParaSiembra = true;
						if (bannerTerreno) {
							bannerTerreno.className = 'alert alert-success small mb-2 py-2 px-3';
							bannerTerreno.innerHTML =
								'<strong>✅ Simulación habilitada manualmente:</strong> Mostrando recomendaciones para esta coordenada.';
						}
						calcularYRenderizarRotacion(ultimoClima);
					}
