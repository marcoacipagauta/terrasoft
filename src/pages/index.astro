			function actualizarGraficos(mensual) {
				if (!chartLluvia || !chartTemp || !Array.isArray(mensual)) return;
				const en = esIngles();
				const labels = obtenerMesesCortos();
				const lluvias = mensual.map((m) => m.lluviaTotal);
				const temps = mensual.map((m) => m.tempMaxPromedio);

				chartLluvia.data.labels = labels;
				chartLluvia.data.datasets[0].label = en ? 'Monthly rainfall (mm)' : 'Lluvia mensual (mm)';
				chartLluvia.data.datasets[0].data = lluvias;
				chartLluvia.update();

				chartTemp.data.labels = labels;
				chartTemp.data.datasets[0].label = en ? 'Avg. max temp (°C)' : 'Temp. máx promedio (°C)';
				chartTemp.data.datasets[0].data = temps;
				chartTemp.update();
			}

			function renderizarTerrenoNoApto(clima) {
				if (!rotationContainer || !clima?.terreno) return;
				const { terreno, coordenadas } = clima;
				const en = esIngles();

				const iconosPorTipo = {
					hielo_glaciar: '❄️',
					desierto_arido: '🏜️',
					cuerpo_agua: '🌊',
					asfalto_via: '🛣️',
					urbano_edificado: '🏙️',
					no_cultivable: '🪨',
				};
				const iconoPrincipal = iconosPorTipo[terreno.clasificacion] || '🚫';

				let consejoAccion = en
					? 'Click on the green or plowed fields next to the road, or manually confirm if you are on cultivable land.'
					: 'Haz clic sobre los lotes verdes o de tierra arada alrededor de la vía, o confirma manualmente si estás en tierra cultivable.';
				if (terreno.clasificacion === 'hielo_glaciar') {
					consejoAccion = en
						? 'This coordinate is in a polar, glacial, or permafrost region. Select a temperate or tropical region with exposed agricultural soil.'
						: 'Esta coordenada se encuentra en una región polar, glaciar o de congelamiento permanente (permafrost/nieve). Selecciona una región templada o tropical con suelo agrícola descubierto.';
				} else if (terreno.clasificacion === 'desierto_arido') {
					consejoAccion = en
						? 'This coordinate has extreme aridity without enough rainfall for rainfed farming.'
						: 'Esta coordenada presenta aridez extrema sin lluvias suficientes para agricultura de secano.';
				} else if (terreno.clasificacion === 'cuerpo_agua') {
					consejoAccion = en
						? 'The marker is over an ocean, lake, or river. Select a plot on solid ground.'
						: 'El marcador está sobre el océano, un lago o un río. Selecciona una parcela en tierra firme.';
				} else if (terreno.clasificacion === 'no_cultivable') {
					consejoAccion = en
						? 'This point shows bare rock or barren soil without vegetation cover. Move the marker toward an area with fertile soil.'
						: 'El punto presenta roca desnuda o suelo estéril sin cobertura vegetal. Desplaza el marcador hacia una zona con suelo fértil.';
				}

				if (chipCultivoDestino) {
					chipCultivoDestino.className = 'badge bg-danger text-white';
					chipCultivoDestino.textContent = en ? 'Not Cultivable' : 'No Cultivable';
				}
				subtituloRotacion.textContent = `Lat ${coordenadas.lat}, Lon ${coordenadas.lon}`;
				badgeEstadoRotacion.className = 'badge bg-danger text-white';
				badgeEstadoRotacion.textContent = `${iconoPrincipal} ${en ? 'Planting Not Viable' : 'Siembra No Viable'}`;

				const htmlBloqueo = `
					<div class="col-12 ts-animate-in">
						<div class="card border-danger border-2 shadow-sm">
							<div class="card-body p-3">
								<div class="d-flex align-items-center mb-2">
									<span class="fs-2 me-3">${iconoPrincipal}</span>
									<div>
										<h3 class="h6 fw-bold text-danger mb-1">
											${en ? 'Cannot plant here:' : 'No es posible sembrar aquí:'} ${terreno.etiqueta}
										</h3>
										<p class="text-muted small mb-0">
											<strong>${en ? 'Location:' : 'Ubicación:'}</strong> ${terreno.ubicacionNombre}
										</p>
									</div>
								</div>
								<p class="mb-3 small text-dark">${terreno.motivo}</p>
								<div class="p-2 px-3 bg-light rounded border small text-secondary d-flex flex-wrap justify-content-between align-items-center gap-2">
									<span><strong>💡 ${en ? 'Suggestion:' : 'Sugerencia:'}</strong> ${consejoAccion}</span>
									<button type="button" class="btn btn-outline-success btn-sm fw-semibold btn-forzar-lote-action">
										${en ? '✅ Force simulation here' : '✅ Forzar simulación aquí'}
									</button>
								</div>
							</div>
						</div>
					</div>
				`;

				rotationContainer.innerHTML = htmlBloqueo;

				document.querySelectorAll('.btn-forzar-lote-action').forEach((btn) => {
					btn.addEventListener('click', () => {
						if (ultimoClima && ultimoClima.terreno) {
							ultimoClima.terreno.aptoParaSiembra = true;
							if (bannerTerreno) {
								bannerTerreno.className = 'alert alert-success small mb-2 py-2 px-3';
								bannerTerreno.innerHTML = esIngles()
									? '<strong>✅ Simulation manually enabled:</strong> Showing recommendations for this coordinate.'
									: '<strong>✅ Simulación habilitada manualmente:</strong> Mostrando recomendaciones para esta coordenada.';
							}
							renderizarPanelFaoGaez(ultimoClima);
							calcularYRenderizarRotacion(ultimoClima);
						}
					});
				});
			}

			/**
			 * Renderiza el panel de Zonificación FAO GAEZ v4 y las 7 barras de Propiedades del Suelo (SQ1–SQ7),
			 * reduciendo las barras a 0% (Clase N - Bloqueado) cuando el marcador cae sobre vías, edificios, agua, roca o hielo,
			 * y modulándolas con la reflectancia óptica del píxel cuando el terreno sí es cultivable.
			 */
			function renderizarPanelFaoGaez(data) {
				if (!data?.faoGaez) return;

				// Conservar copia base de las propiedades regionales FAO para restaurarlas si el usuario fuerza la simulación
				if (!data.faoGaez._propiedadesBase && Array.isArray(data.faoGaez.propiedadesSuelo)) {
					data.faoGaez._propiedadesBase = data.faoGaez.propiedadesSuelo.map((p) => ({ ...p }));
					data.faoGaez._claseBase = data.faoGaez.claseSueloFao !== 'N' ? data.faoGaez.claseSueloFao : 'S1';
					data.faoGaez._lgpBase = data.faoGaez.lgpDias;
				}

				const esApto = Boolean(data.terreno?.aptoParaSiembra);
				const clasif = data.terreno?.clasificacion || 'agricola_rural';

				const faoZonaEl = document.getElementById('fao-zona-aez');
				const faoLgpEl = document.getElementById('fao-lgp-dias');
				const faoSueloEl = document.getElementById('fao-clase-suelo');
				const faoAltitudEl = document.getElementById('fao-altitud');
				const faoPendienteEl = document.getElementById('fao-pendiente');
				const faoAreaProtEl = document.getElementById('fao-area-protegida');
				const faoProy2050El = document.getElementById('fao-proyeccion-2050');
				const contenedorSqEl = document.getElementById('contenedor-barras-sq');
				const imgMapaFao = document.getElementById('img-mapa-fao');

				if (faoZonaEl) {
					faoZonaEl.innerHTML = `<strong>AEZ:</strong> <span class="text-info">${data.faoGaez.zonaAgroecologica}</span>`;
				}
				if (faoLgpEl) {
					const en = esIngles();
					faoLgpEl.textContent = esApto
						? en
							? `🌱 LGP: ${data.faoGaez._lgpBase ?? data.faoGaez.lgpDias} days/yr`
							: `🌱 LGP: ${data.faoGaez._lgpBase ?? data.faoGaez.lgpDias} días/año`
						: en
						? `🚫 Effective LGP: 0 days (Not cultivable)`
						: `🚫 LGP Efectivo: 0 días (No cultivable)`;
				}
				if (faoSueloEl) {
					const en = esIngles();
					if (esApto) {
						const clsRestaurada = data.faoGaez._claseBase || 'S1';
						data.faoGaez.claseSueloFao = clsRestaurada;
						faoSueloEl.style.background = '#f5b041';
						faoSueloEl.style.color = '#071428';
						faoSueloEl.textContent = en ? `FAO Soil: Class ${clsRestaurada}` : `Suelo FAO: Clase ${clsRestaurada}`;
						faoSueloEl.title = data.faoGaez.etiquetaSueloFao;
					} else {
						data.faoGaez.claseSueloFao = 'N';
						faoSueloEl.style.background = '#dc2626';
						faoSueloEl.style.color = '#ffffff';
						faoSueloEl.textContent = en ? '🚫 FAO Soil: Class N (Unsuitable)' : '🚫 Suelo FAO: Clase N (No Apto)';
						faoSueloEl.title = en
							? 'Class N — Surface without usable agricultural soil'
							: 'Clase N — Superficie sin suelo agrícola aprovechable';
					}
				}
				if (faoAltitudEl) {
					faoAltitudEl.textContent =
						typeof data.faoGaez.altitudMsnm === 'number'
							? `⛰️ ${data.faoGaez.altitudMsnm.toLocaleString('es-CO')} m ${esIngles() ? 'a.s.l.' : 's.n.m.'}`
							: esIngles()
							? '⛰️ Evaluated altitude'
							: '⛰️ Altitud evaluada';
				}
				if (faoPendienteEl && data.faoGaez.pendienteTexto) {
					faoPendienteEl.innerHTML = `📐 ${esIngles() ? 'Slope' : 'Pendiente'}: <strong class="text-white">${data.faoGaez.pendienteTexto}</strong>`;
				}
				if (faoAreaProtEl && data.faoGaez.areaProtegidaTexto) {
					const colorProt = data.faoGaez.enAreaProtegida ? 'text-warning' : 'text-info';
					const iconoProt = data.faoGaez.enAreaProtegida ? '⚠️' : '✅';
					faoAreaProtEl.innerHTML = `🌳 ${iconoProt} <strong class="${colorProt}">${data.faoGaez.areaProtegidaTexto}</strong>`;
				}
				if (faoProy2050El && data.faoGaez.proyeccionClimatica2050) {
					faoProy2050El.innerHTML = `🔮 <strong>${esIngles() ? '2050 Climate (RCP 4.5):' : 'Clima 2050 (RCP 4.5):'}</strong> ${data.faoGaez.proyeccionClimatica2050}`;
				}

				if (contenedorSqEl && Array.isArray(data.faoGaez._propiedadesBase)) {
					const en = esIngles();
					if (!esApto) {
						// Cuando el puntero cae en carretera, edificio, agua, glaciar o roca estéril, las barras bajan a 0% - 8% en rojo
						const motivosCortos = en
							? {
									asfalto_via: 'Sealed by Road/Asphalt',
									urbano_edificado: 'Building/Concrete',
									cuerpo_agua: 'Water Body',
									hielo_glaciar: 'Frozen/Glacier',
									desierto_arido: 'Extreme Aridity',
									no_cultivable: 'Barren Rock',
							  }
							: {
									asfalto_via: 'Sellado por Asfalto/Vía',
									urbano_edificado: 'Construcción/Concreto',
									cuerpo_agua: 'Cuerpo de Agua',
									hielo_glaciar: 'Congelado/Glaciar',
									desierto_arido: 'Aridez Extrema',
									no_cultivable: 'Roca Estéril',
							  };
						const etiquetaBloqueo = motivosCortos[clasif] || (en ? 'Not Cultivable' : 'No Cultivable');

						const htmlAlertaSq = `
							<div class="col-12">
								<div class="alert alert-danger py-1 px-2 mb-1 small" style="font-size: 0.72rem;">
									🚫 <strong>${en ? `Blocked Soil (${etiquetaBloqueo}):` : `Suelo Bloqueado (${etiquetaBloqueo}):`}</strong> ${
							en
								? 'At this exact point there is no arable topsoil; move the marker to a green or plowed lot.'
								: 'En este punto exacto no hay capa vegetal arable; mueve el marcador hacia un lote verde o de tierra arada.'
						}
								</div>
							</div>
						`;

						contenedorSqEl.innerHTML =
							htmlAlertaSq +
							data.faoGaez._propiedadesBase
								.map((sq) => {
									const pctResidual =
										clasif === 'cuerpo_agua' || clasif === 'hielo_glaciar' || clasif === 'asfalto_via' || clasif === 'urbano_edificado'
											? 0
											: Math.min(12, Math.round((ultimoEspectral?.pctVeg || 0) + (ultimoEspectral?.pctTierra || 0)) / 3);
									const pctRedondeado = Math.round(pctResidual);
									return `
										<div class="col-sm-6 col-12">
											<div class="p-2 rounded bg-danger-subtle border border-danger-subtle h-100">
												<div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.74rem;">
													<span class="fw-bold text-danger-emphasis">
														${sq.icono} ${sq.codigo}: ${obtenerNombreSq(sq)}
													</span>
													<span class="badge bg-danger text-white" style="font-size: 0.66rem;">
														${pctRedondeado}% (${etiquetaBloqueo})
													</span>
												</div>
												<div class="progress" style="height: 6px; background: #fecaca;">
													<div class="progress-bar bg-danger" role="progressbar" style="width: ${pctRedondeado}%;"></div>
												</div>
											</div>
										</div>
									`;
								})
								.join('');
					} else {
						// Terreno cultivable: combina la celda FAO LR con la micro-cobertura óptica bajo el marcador
						const pctSueloVivo = ultimoEspectral?.disponible
							? (ultimoEspectral.pctVeg || 0) + (ultimoEspectral.pctTierra || 0)
							: 80;
						const ajusteMicro = Math.round((pctSueloVivo - 75) * 0.14);

						contenedorSqEl.innerHTML = data.faoGaez._propiedadesBase
							.map((sq, idx) => {
								// Pequeña variación específica por propiedad según cobertura vegetal/tierra local
								const modProp = idx === 0 || idx === 1 ? ajusteMicro : idx === 6 ? Math.round(ajusteMicro * 0.7) : Math.round(ajusteMicro * 0.5);
								const pctFinal = Math.min(98, Math.max(25, sq.porcentaje + modProp));
								const estadoFinal =
									pctFinal >= 75
										? en
											? 'Optimal'
											: 'Óptimo'
										: pctFinal >= 50
										? en
											? 'Moderate'
											: 'Moderado'
										: en
										? 'Limited'
										: 'Limitado';

								const barColor =
									pctFinal >= 75
										? 'linear-gradient(90deg, #059669, #10b981)'
										: pctFinal >= 50
										? 'linear-gradient(90deg, #0284c7, #38bdf8)'
										: 'linear-gradient(90deg, #d97706, #f5b041)';
								const badgeColor =
									pctFinal >= 75
										? 'bg-success-subtle text-success-emphasis'
										: pctFinal >= 50
										? 'bg-info-subtle text-info-emphasis'
										: 'bg-warning-subtle text-warning-emphasis';
								return `
									<div class="col-sm-6 col-12">
										<div class="p-2 rounded bg-light border h-100">
											<div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.74rem;">
												<span class="fw-bold" style="color: #071428;">
													${sq.icono} ${sq.codigo}: ${obtenerNombreSq(sq)}
												</span>
												<span class="badge ${badgeColor}" style="font-size: 0.67rem;">
													${pctFinal}% (${estadoFinal})
												</span>
											</div>
											<div class="progress" style="height: 6px; background: #e2e8f0;">
												<div class="progress-bar" role="progressbar" style="width: ${pctFinal}%; background: ${barColor};"></div>
											</div>
										</div>
									</div>
								`;
							})
							.join('');
					}
				}

				if (imgMapaFao && data.faoGaez.exportImageUrl) {
					imgMapaFao.src = data.faoGaez.exportImageUrl;
				}
			}

			function calcularYRenderizarRotacion(clima) {
				if (!rotationContainer || !catalogoCultivos.length) return;

				const cultivoActualId = selectCultivo?.value || 'papa';
				const objCultivoActual = catalogoCultivos.find((c) => c.id === cultivoActualId);
				if (chipCultivoOrigen && objCultivoActual) {
					chipCultivoOrigen.textContent = objCultivoActual.nombre.split('(')[0].trim();
				}

				if (clima?.terreno && !clima.terreno.aptoParaSiembra) {
					renderizarTerrenoNoApto(clima);
					return;
				}

				badgeEstadoRotacion.className =
					'badge bg-success-subtle text-success border border-success-subtle';

				const prioridad = selectPrioridad?.value || 'suelo';
				const lluviaTotalAnual = clima?.promedios?.lluviaTotalAnual;
				const tempMaxPromedio = clima?.promedios?.tempMax;
				const ubicacionTexto = (clima?.terreno?.ubicacionNombre || '').toLowerCase();

				const en = esIngles();

				const evaluados = catalogoCultivos.map((cultivo) => {
					let puntaje = 52;
					const razones = [];
					const chips = [];

					// Evaluación de calendario respecto a la fecha actual
					const evalCal = evaluarCalendarioSiembra(cultivo, clima?.mensual);
					puntaje += evalCal.bonoPuntaje;

					// Cálculo de costos para el área del lote ingresada (ajustado con aptitud FAO GAEZ)
					const presupuesto = calcularPresupuestoLote(cultivo, objCultivoActual, clima);
					const macroTrad = obtenerMacroregion(cultivo.macroregion);
					const famTrad = obtenerFamiliaCultivo(cultivo.familia);
					const famOrigTrad = objCultivoActual ? obtenerFamiliaCultivo(objCultivoActual.familia) : '';
					const cicloTrad = obtenerCicloCultivo(cultivo);

					// 0. Vocación Regional por Departamento en Colombia
					if (Array.isArray(cultivo.departamentos) && ubicacionTexto) {
						const deptoCoincidente = cultivo.departamentos.find((dep) =>
							ubicacionTexto.includes(dep.toLowerCase())
						);
						if (deptoCoincidente) {
							puntaje += 14;
							chips.push({
								texto: en ? `🇨🇴 Vocation in ${deptoCoincidente}` : `🇨🇴 Vocación en ${deptoCoincidente}`,
								clase: 'bg-success-subtle text-success-emphasis',
							});
							razones.push(
								en
									? `Proven agricultural vocation in ${deptoCoincidente} (${macroTrad}).`
									: `Vocación productiva comprobada en ${deptoCoincidente} (${cultivo.macroregion}).`
							);
						}
					}

					// 1. Prioridad del agricultor
					if (prioridad === 'agua') {
						if (cultivo.agua === 'baja') {
							puntaje += 20;
							chips.push({
								texto: en ? '💧 Water Saving' : '💧 Ahorro Hídrico',
								clase: 'bg-info-subtle text-info-emphasis',
							});
							razones.push(
								en
									? 'Low water demand, ideal for your water-saving priority.'
									: 'Baja demanda de agua, ideal para tu prioridad de ahorro hídrico.'
							);
						} else if (cultivo.agua === 'media') {
							puntaje += 8;
						} else {
							puntaje -= 12;
						}
					} else if (prioridad === 'suelo') {
						if (cultivo.beneficio === 'mejora_suelo_nitrogeno') {
							puntaje += 24;
							chips.push({
								texto: en ? '🌱 Fixes Nitrogen' : '🌱 Fija Nitrógeno',
								clase: 'bg-success-subtle text-success-emphasis',
							});
							razones.push(
								en
									? 'Nitrogen-fixing legume that restores soil fertility.'
									: 'Leguminosa fijadora de nitrógeno que restaura el suelo.'
							);
						} else if (cultivo.id === 'avena_forrajera' || cultivo.id === 'cebada') {
							puntaje += 12;
							chips.push({
								texto: en ? '🌾 Green Manure' : '🌾 Abono Verde',
								clase: 'bg-success-subtle text-success-emphasis',
							});
							razones.push(
								en
									? 'Adds organic matter and decompacts the soil.'
									: 'Aporta materia orgánica y descompacta el suelo.'
							);
						}
					} else if (prioridad === 'rentabilidad') {
						if (cultivo.beneficio === 'rentabilidad') {
							puntaje += 22;
							chips.push({
								texto: en ? '💰 High Profitability' : '💰 Alta Rentabilidad',
								clase: 'bg-warning-subtle text-warning-emphasis',
							});
							razones.push(
								en
									? 'Excellent commercial return in regional markets.'
									: 'Excelente retorno comercial en mercados regionales.'
							);
						} else if (cultivo.beneficio === 'mejora_suelo_nitrogeno') {
							puntaje += 10;
							razones.push(
								en
									? 'Saves nitrogen fertilizers in the subsequent harvest.'
									: 'Ahorra fertilizantes nitrogenados en la cosecha posterior.'
							);
						}
					}

					// 2. Rotación de Familias Botánicas
					if (cultivoActualId === cultivo.id) {
						puntaje -= 35;
						razones.push(
							en
								? '⚠️ Monoculture: avoid repeating the exact same crop consecutively.'
								: '⚠️ Monocultivo: evita repetir el mismo cultivo consecutivo.'
						);
					} else if (
						Array.isArray(cultivo.evitarDespuesDe) &&
						cultivo.evitarDespuesDe.includes(cultivoActualId)
					) {
						puntaje -= 20;
						razones.push(
							en
								? `⚠️ Shares sanitary pest cycle (${famTrad}) with your current crop.`
								: `⚠️ Comparte ciclo sanitario (${cultivo.familia}) con tu cultivo actual.`
						);
					} else if (objCultivoActual && objCultivoActual.familia !== cultivo.familia) {
						puntaje += 14;
						chips.push({
							texto: en ? '🧬 Breaks Pests' : '🧬 Corta Plagas',
							clase: 'bg-secondary-subtle text-secondary-emphasis',
						});
						razones.push(
							en
								? `Rotates from ${famOrigTrad} to ${famTrad}, breaking pest cycles.`
								: `Alterna de ${objCultivoActual.familia} a ${cultivo.familia}, rompiendo plagas.`
						);
					}

					// 3. Compatibilidad con Rango Térmico (NASA POWER)
					if (typeof tempMaxPromedio === 'number' && Array.isArray(cultivo.tempOptima)) {
						const [tMin, tMax] = cultivo.tempOptima;
						if (tempMaxPromedio >= tMin && tempMaxPromedio <= tMax) {
							puntaje += 20;
							chips.push({
								texto: en ? `🌡️ Ideal Climate (${tMin}–${tMax}°C)` : `🌡️ Clima Ideal (${tMin}–${tMax}°C)`,
								clase: 'bg-danger-subtle text-danger-emphasis',
							});
							razones.push(
								en
									? `Plot temperature (${tempMaxPromedio} °C) fits its optimal range (${tMin}–${tMax} °C).`
									: `La temperatura de la parcela (${tempMaxPromedio} °C) encaja en su óptimo (${tMin}–${tMax} °C).`
							);
						} else {
							const desviacion = tempMaxPromedio < tMin ? tMin - tempMaxPromedio : tempMaxPromedio - tMax;
							if (desviacion <= 2.5) {
								puntaje += 4;
								razones.push(
									en
										? `Temperature close to its optimal range (${tMin}–${tMax} °C).`
										: `Temperatura cercana a su rango óptimo (${tMin}–${tMax} °C).`
								);
							} else {
								puntaje -= Math.min(35, Math.round(desviacion * 4));
								razones.push(
									en
										? `Outside its ideal thermal zone (${tMin}–${tMax} °C vs ${tempMaxPromedio} °C local).`
										: `Fuera de su piso térmico ideal (${tMin}–${tMax} °C vs ${tempMaxPromedio} °C local).`
								);
							}
						}
					}

					// 4. Compatibilidad con Precipitación Anual (NASA POWER)
					if (typeof lluviaTotalAnual === 'number' && Array.isArray(cultivo.lluviaOptima)) {
						const [lMin, lMax] = cultivo.lluviaOptima;
						if (lluviaTotalAnual >= lMin && lluviaTotalAnual <= lMax) {
							puntaje += 16;
							razones.push(
								en
									? `Local rainfall (${lluviaTotalAnual} mm/yr) is optimal for its range (${lMin}–${lMax} mm).`
									: `Lluvia local (${lluviaTotalAnual} mm/año) óptima para su rango (${lMin}–${lMax} mm).`
							);
						} else if (lluviaTotalAnual < lMin) {
							if (cultivo.agua === 'baja') {
								puntaje += 6;
								razones.push(
									en
										? `Tolerates moderate/low rainfall well (${lluviaTotalAnual} mm/yr).`
										: `Tolera bien lluvias moderadas/bajas (${lluviaTotalAnual} mm/año).`
								);
							} else {
								puntaje -= 16;
								razones.push(
									en
										? `Insufficient rainfall (${lluviaTotalAnual} mm vs ${lMin} mm min.): requires irrigation.`
										: `Lluvia insuficiente (${lluviaTotalAnual} mm vs ${lMin} mm mín.): requiere riego.`
								);
							}
						} else {
							if (cultivo.agua === 'alta') {
								puntaje += 6;
								razones.push(
									en
										? `Good water supply (${lluviaTotalAnual} mm/yr); ensure proper drainage.`
										: `Buena oferta hídrica (${lluviaTotalAnual} mm/año); cuidar drenaje.`
								);
							} else {
								puntaje -= 12;
								razones.push(
									en
										? `Excess rainfall (${lluviaTotalAnual} mm/yr) compared to its optimum (${lMax} mm).`
										: `Exceso de lluvia (${lluviaTotalAnual} mm/año) frente a su óptimo (${lMax} mm).`
								);
							}
						}
					}

					// 5. Compatibilidad con Periodo de Crecimiento FAO GAEZ v4 (LGP en días/año vs Ciclo del Cultivo)
					const lgpFao = clima?.faoGaez?.lgpDias;
					const claseSueloFao = clima?.faoGaez?.claseSueloFao;
					if (typeof lgpFao === 'number') {
						const diasCicloMedio = extraerDiasCiclo(cultivo.cicloDias);
						if (lgpFao >= diasCicloMedio) {
							puntaje += 8;
							chips.push({
								texto: `🌍 FAO ${claseSueloFao || 'S1'} (LGP ${lgpFao}d)`,
								clase: 'bg-primary-subtle text-primary-emphasis',
							});
							razones.push(
								en
									? `FAO GAEZ v4: Local growing period (${lgpFao} days/yr) covers the crop cycle (${cicloTrad}).`
									: `FAO GAEZ v4: Periodo de crecimiento local (${lgpFao} días/año) cubre el ciclo del cultivo (${cultivo.cicloDias}).`
							);
						} else if (cultivo.agua === 'baja' && lgpFao >= diasCicloMedio * 0.65) {
							puntaje += 3;
							razones.push(
								en
									? `FAO GAEZ v4: Resilient to the local growing period (LGP ${lgpFao} days/yr).`
									: `FAO GAEZ v4: Rústico ante el periodo de crecimiento local (LGP ${lgpFao} días/año).`
							);
						} else {
							puntaje -= 10;
							razones.push(
								en
									? `FAO GAEZ v4: Cycle (${cicloTrad}) exceeds natural moisture days LGP (${lgpFao} d/yr); requires irrigation.`
									: `FAO GAEZ v4: Ciclo (${cultivo.cicloDias}) supera los días de humedad natural LGP (${lgpFao} d/año); requiere riego.`
							);
						}
					}

					const score = Math.max(15, Math.min(99, Math.round(puntaje)));
					return {
						...cultivo,
						score,
						razones: razones.slice(0, 3),
						chips: chips.slice(0, 3),
						evalCal,
						presupuesto,
					};
				});

				evaluados.sort((a, b) => b.score - a.score);
				const topRecomendados = evaluados.slice(0, 3);
				ultimasRecomendaciones = topRecomendados;

				const mesesCortos = obtenerMesesCortos();
				const mesesLargos = obtenerMesesLargos();
				const nomMesActual = mesesLargos[mesActualNum - 1];

				const movilChipOrigen = document.getElementById('movil-chip-origen');
				const movilChipDestino = document.getElementById('movil-chip-destino');
				const nombreOrigenTrad = obtenerNombreCultivo(objCultivoActual).split('(')[0].trim();
				const nombreTop1Trad = topRecomendados[0]
					? obtenerNombreCultivo(topRecomendados[0]).split('(')[0].trim()
					: '';

				if (chipCultivoOrigen && objCultivoActual) {
					chipCultivoOrigen.textContent = nombreOrigenTrad;
				}
				if (movilChipOrigen && objCultivoActual) {
					movilChipOrigen.textContent = nombreOrigenTrad;
				}

				if (chipCultivoDestino && topRecomendados[0]) {
					chipCultivoDestino.className = 'badge fw-bold text-wrap';
					chipCultivoDestino.style.background = '#f5b041';
					chipCultivoDestino.style.color = '#071428';
					chipCultivoDestino.textContent = `${nombreTop1Trad} (${topRecomendados[0].score}%)`;
				}
				if (movilChipDestino && topRecomendados[0]) {
					movilChipDestino.textContent = `#1 ${nombreTop1Trad} (${topRecomendados[0].score}%)`;
				}

				if (badgeEstadoRotacion && topRecomendados[0]) {
					badgeEstadoRotacion.textContent = `Top #1: ${nombreTop1Trad} (${topRecomendados[0].score}%)`;
				}
				if (clima?.coordenadas && subtituloRotacion) {
					subtituloRotacion.textContent = `${lluviaTotalAnual} ${en ? 'mm/yr' : 'mm/año'} | ${tempMaxPromedio} °C`;
				}

				// RENDERIZAR TARJETAS UNIFICADAS EN EL DASHBOARD PRINCIPAL (AFINIDAD + CALENDARIO 12 MESES + COSTOS $ COP)
				rotationContainer.innerHTML = topRecomendados
					.map((item, idx) => {
						const infoAguaBase = etiquetasAgua[item.agua] || {
							texto: `Agua: ${item.agua}`,
							badge: 'bg-secondary',
						};
						const textoAguaTrad = en
							? item.agua === 'alta'
								? 'High Water'
								: item.agua === 'media'
								? 'Medium Water'
								: 'Low Water'
							: infoAguaBase.texto;
						const infoBeneficio = etiquetasBeneficio[item.beneficio] || {
							titulo: item.beneficio,
							descripcion: '',
							icono: '🌿',
						};
						const esMejor = idx === 0;
						const barBg = item.score >= 80 ? 'linear-gradient(90deg, #0d2647, #0284c7)' : item.score >= 60 ? '#0284c7' : '#f5b041';
						const mesesOptimos = Array.isArray(item.mesesSiembra) ? item.mesesSiembra : [3, 4, 5, 9, 10];
						const p = item.presupuesto;
						const collapseId = `desglose-costos-${item.id}-${idx}`;
						const nombreItemTrad = obtenerNombreCultivo(item);
						const familiaItemTrad = obtenerFamiliaCultivo(item.familia);
						const cicloItemTrad = obtenerCicloCultivo(item);
						const macroItemTrad = obtenerMacroregion(item.macroregion || item.region);

						const htmlMeses = mesesCortos
							.map((nomMes, mIdx) => {
								const numMes = mIdx + 1;
								const esOptimo = mesesOptimos.includes(numMes);
								const esActual = numMes === mesActualNum;
								const tituloMes = `${mesesLargos[mIdx]}${esActual ? (en ? ' (CURRENT MONTH)' : ' (MES ACTUAL)') : ''}: ${
									esOptimo
										? en
											? '✅ Optimal planting month'
											: '✅ Mes óptimo de siembra'
										: en
										? 'Outside main window'
										: 'Fuera de ventana principal'
								}`;
								return `<div class="ts-cal-month ${esOptimo ? 'optimal' : ''} ${
									esActual ? 'current' : ''
								}" title="${tituloMes}">${nomMes}${esActual ? '📍' : ''}</div>`;
							})
							.join('');

						return `
						<div class="col-12 ts-animate-in" style="animation-delay: ${idx * 45}ms;">
							<div class="card ts-card shadow-sm ${esMejor ? 'ts-card-top1' : ''}">
								<div class="card-body p-3">
									<!-- Fila 1: Medalla, Nombre, Píldoras y Porcentaje de Afinidad -->
									<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
										<div class="d-flex align-items-center gap-2 flex-wrap">
											<span class="badge fw-bold" style="${esMejor ? 'background: #f5b041; color: #071428;' : 'background: #0d2647; color: #38bdf8;'}">#${idx + 1}</span>
											<span class="fs-5">${infoBeneficio.icono}</span>
											<h3 class="h6 mb-0 fw-bold" style="color: #071428;">${nombreItemTrad}</h3>
											<span class="badge" style="background: #eef4fb; color: #0d2647; border: 1px solid #cbd5e1;">${familiaItemTrad}</span>
											<span class="badge ${infoAguaBase.badge}">${textoAguaTrad}</span>
											<span class="badge" style="background: #eef4fb; color: #0d2647; border: 1px solid #cbd5e1;">⏱️ ${cicloItemTrad}</span>
											${item.chips
												.map((ch) => `<span class="badge ${ch.clase}">${ch.texto}</span>`)
												.join('')}
										</div>
										<div class="text-end">
											<span class="fs-5 fw-bold" style="color: ${esMejor ? '#0284c7' : '#0d2647'};">${item.score}%</span>
											<small class="text-muted d-block" style="font-size: 0.7rem;">${en ? 'Affinity' : 'Afinidad'}</small>
										</div>
									</div>

									<div class="progress mb-2" style="height: 6px; background: #e2e8f0;">
										<div class="progress-bar" role="progressbar" style="width: ${item.score}%; background: ${barBg};"></div>
									</div>

									<!-- Fila 2: Calendario de Siembra (12 Meses) + Semáforo de Fecha Actual -->
									<div class="p-2 rounded bg-light border mb-2">
										<div class="d-flex flex-wrap justify-content-between align-items-start gap-1 mb-1">
											<span class="badge ts-cal-badge py-1 px-2 ${item.evalCal.badgeClase}" style="font-size: 0.72rem;">
												${item.evalCal.icono} ${item.evalCal.titulo}
											</span>
											<span class="text-muted" style="font-size: 0.7rem; overflow-wrap: anywhere;">
												🟦 = ${en ? 'Optimal months' : 'Meses óptimos'} &nbsp;|&nbsp; 📍 = ${nomMesActual}
											</span>
										</div>
										<div class="ts-cal-grid mb-1">${htmlMeses}</div>
										<div class="text-secondary" style="font-size: 0.75rem; line-height: 1.38; overflow-wrap: anywhere; word-break: break-word;">
											<strong>💡 ${en ? 'Calendar:' : 'Calendario:'}</strong> ${item.evalCal.consejo}
										</div>
									</div>

									<!-- Fila 3: Presupuesto Estimado en Pesos ($ COP) con Desglose Desplegable -->
									<div class="ts-cost-panel mb-2">
										<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
											<div>
												<span class="fw-bold small" style="color: #0d2647;">
													💵 ${en ? `Estimated Investment (${p.etiquetaArea}):` : `Inversión Estimada (${p.etiquetaArea}):`}
												</span>
												<span class="fs-6 fw-bold ms-1" style="color: #0284c7;">
													${formatoCOP.format(p.costoTotalNeto)}
												</span>
												<span class="text-muted ms-1" style="font-size: 0.72rem;">
													• ${en ? 'Est. yield:' : 'Producción est.:'} ~${p.rendimientoTexto}
												</span>
											</div>
											<button
												class="btn btn-sm py-0 px-2 fw-semibold"
												style="font-size: 0.72rem; background: #0d2647; color: #f5b041;"
												type="button"
												data-bs-toggle="collapse"
												data-bs-target="#${collapseId}"
												aria-expanded="false"
											>
												${en ? '📋 View cost breakdown ▾' : '📋 Ver desglose de costos ▾'}
											</button>
										</div>

										${
											p.ahorroNitrogeno > 0
												? `<div class="mt-1 p-1 px-2 rounded fw-semibold" style="font-size: 0.72rem; background: #fef3c7; color: #92400e; border: 1px solid #f5b041;">
													${
														en
															? `🌱 You save <strong>${formatoCOP.format(p.ahorroNitrogeno)}</strong> on fertilizers thanks to the nitrogen fixed by your previous legume crop!`
															: `🌱 ¡Ahorras <strong>${formatoCOP.format(p.ahorroNitrogeno)}</strong> en fertilizantes gracias al nitrógeno que dejó tu cultivo previo!`
													}
												   </div>`
												: ''
										}

										<div class="collapse mt-2" id="${collapseId}">
											<div class="row g-1 text-center pt-1 border-top" style="font-size: 0.73rem;">
												<div class="col-6 col-sm-3">
													<div class="p-1 bg-white rounded border">
														<div class="text-muted">${en ? '🌱 Seed/Planting' : '🌱 Semilla/Colino'}</div>
														<div class="fw-bold text-dark">${formatoCOP.format(p.rubSemilla)}</div>
													</div>
												</div>
												<div class="col-6 col-sm-3">
													<div class="p-1 bg-white rounded border">
														<div class="text-muted">${en ? '🚜 Labor' : '🚜 Mano de Obra'}</div>
														<div class="fw-bold text-dark">${formatoCOP.format(p.rubManoObra)}</div>
													</div>
												</div>
												<div class="col-6 col-sm-3">
													<div class="p-1 bg-white rounded border">
														<div class="text-muted">${en ? '🧪 Fertilizers' : '🧪 Fertilizantes'}</div>
														<div class="fw-bold" style="color: #0284c7;">${formatoCOP.format(p.rubFertilizantes)}</div>
													</div>
												</div>
												<div class="col-6 col-sm-3">
													<div class="p-1 bg-white rounded border">
														<div class="text-muted">${en ? '🛡️ Crop Protection' : '🛡️ Fitosanitarios'}</div>
														<div class="fw-bold text-dark">${formatoCOP.format(p.rubFitosanitarios)}</div>
													</div>
												</div>
											</div>
										</div>
									</div>

									<!-- Fila 4: Razones Agronómicas y Región -->
									<div class="d-flex flex-wrap justify-content-between align-items-end gap-2">
										<ul class="small text-muted ps-3 mb-0" style="font-size: 0.75rem;">
											${item.razones.map((r) => `<li>${r}</li>`).join('')}
										</ul>
										<span class="badge bg-light text-secondary border" style="font-size: 0.68rem;">
											📍 ${macroItemTrad}
										</span>
									</div>
								</div>
							</div>
						</div>`;
					})
					.join('');
			}

			async function consultarParcela(lat, lon) {
				if (isNaN(lat) || isNaN(lon)) return;

				if (controladorPeticion) {
					controladorPeticion.abort();
				}
				controladorPeticion = new AbortController();

				spinnerClima?.classList.remove('d-none');
				alertaError?.classList.add('d-none');
				if (btnAnalizar) {
					btnAnalizar.disabled = true;
				}

				try {
					const [resp, analisisSatelital] = await Promise.all([
						fetch(`/api/clima?lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}`, {
							signal: controladorPeticion.signal,
						}),
						analizarSuperficieSatelital(lat, lon),
					]);

					const data = await resp.json();

					if (!resp.ok) {
						throw new Error(data.error || 'Error al obtener datos de NASA POWER');
					}

					if (analisisSatelital?.disponible && detalleEspectral && tituloEspectral) {
						ultimoEspectral = analisisSatelital;
						const { pctVeg, pctTierra, pctHielo, pctAsfalto, esHieloONieve, esSuperficieGrisSinSuelo } =
							analisisSatelital;
						const tempMaxAnual = data?.promedios?.tempMax ?? 20;
						const tieneInfra = Boolean(data?.terreno?.tieneInfraestructuraCercana);
						const esClimaFrioExtremo =
							tempMaxAnual < 7 || data?.terreno?.clasificacion === 'hielo_glaciar';

						if (esClimaFrioExtremo || esHieloONieve) {
							const pctCoberturaNival = Math.min(100, pctHielo + pctAsfalto);
							detalleEspectral.innerHTML = `❄️ Hielo/Nieve: <strong>${pctCoberturaNival}%</strong> | 🌿 Veg: <strong>${pctVeg}%</strong> | 🟤 Suelo: <strong>${pctTierra}%</strong>`;
						} else if (tieneInfra) {
							detalleEspectral.innerHTML = `🌿 Veg: <strong>${pctVeg}%</strong> | 🟤 Tierra: <strong>${pctTierra}%</strong> | 🛣️ Pavimento/Techo: <strong>${pctAsfalto + pctHielo}%</strong>`;
						} else {
							detalleEspectral.innerHTML = `🌿 Veg: <strong>${pctVeg}%</strong> | 🟤 Tierra: <strong>${pctTierra}%</strong> | 🪨 Roca: <strong>${pctAsfalto + pctHielo}%</strong>`;
						}

						if (esSuperficieGrisSinSuelo && data.terreno?.aptoParaSiembra) {
							data.terreno.aptoParaSiembra = false;
							if (esClimaFrioExtremo || (esHieloONieve && tempMaxAnual < 12)) {
								data.terreno.clasificacion = 'hielo_glaciar';
								data.terreno.etiqueta = `❄️ Superficie Cubierta de Nieve / Hielo (${pctHielo + pctAsfalto}%)`;
								data.terreno.motivo = `La imagen satelital y el registro térmico (${tempMaxAnual} °C máx.) indican cobertura de nieve, hielo glaciar o suelo congelado.`;
							} else if (tieneInfra) {
								data.terreno.clasificacion = 'asfalto_via';
								data.terreno.etiqueta = `🛣️ Pavimento / Concreto o Techo (${pctAsfalto + pctHielo}% Superficie Artificial)`;
								data.terreno.motivo = `El análisis óptico satelital detecta un ${
									pctAsfalto + pctHielo
								}% de superficie pavimentada o techo construido y solo ${pctVeg + pctTierra}% de suelo vegetal.`;
							} else {
								data.terreno.clasificacion = 'no_cultivable';
								data.terreno.etiqueta = `🪨 Suelo Rocoso / Afloramiento Mineral Estéril (${pctAsfalto + pctHielo}%)`;
								data.terreno.motivo = `El análisis satelital muestra un ${
									pctAsfalto + pctHielo
								}% de roca desnuda o terreno sin suelo agrícola fértil.`;
							}
						}
					}

					ultimoClima = data;

					window.dispatchEvent(
						new CustomEvent('terrasync:terreno-evaluado', {
							detail: data,
						})
					);

					if (bannerTerreno && data.terreno) {
						if (data.terreno.aptoParaSiembra) {
							bannerTerreno.className = 'alert alert-success small mb-2 py-2 px-3';
							bannerTerreno.innerHTML = `<strong>✅ ${data.terreno.etiqueta}:</strong> ${data.terreno.motivo}`;
						} else {
							bannerTerreno.className = 'alert alert-danger small mb-2 py-2 px-3';
							bannerTerreno.innerHTML = `<strong>🚫 ${data.terreno.etiqueta}:</strong> ${data.terreno.motivo}`;
						}
					}

					const temp = data.promedios.tempMax;
					const lluvia = data.promedios.lluviaTotalAnual;

					if (climaCoordsLabel) {
						climaCoordsLabel.textContent = `${data.coordenadas.lat}, ${data.coordenadas.lon}`;
					}
					if (kpiTempMax) kpiTempMax.textContent = `${temp} °C`;
					if (kpiLluviaAnual) kpiLluviaAnual.textContent = `${lluvia} mm`;
					if (kpiLluviaDiaria) kpiLluviaDiaria.textContent = `${data.promedios.lluviaDiaria} mm/d`;

					if (kpiPisoTermico) {
						let piso = 'Templado';
						if (temp <= 5) piso = 'Polar / Nival';
						else if (temp < 12) piso = 'Páramo';
						else if (temp <= 22) piso = 'Frío Andino';
						else if (temp <= 28) piso = 'Templado';
						else piso = 'Cálido';
						kpiPisoTermico.textContent = piso;
					}

					if (kpiRegimenLluvia) {
						let reg = 'Subhúmedo';
						if (lluvia < 120) reg = 'Hiperárido';
						else if (lluvia < 650) reg = 'Seco';
						else if (lluvia <= 1400) reg = 'Moderado';
						else reg = 'Húmedo';
						kpiRegimenLluvia.textContent = reg;
					}

					if (diagnosticoClimatico) {
						diagnosticoClimatico.textContent = `${temp} °C máx. prom | ${lluvia} mm/año`;
					}

					// Actualizar Panel de Zonificación Agroecológica, Topografía y las 7 Propiedades del Suelo de FAO GAEZ v4
					renderizarPanelFaoGaez(data);

					actualizarGraficos(data.mensual);
					calcularYRenderizarRotacion(data);
				} catch (err) {
					if (err.name === 'AbortError') return;
					window.dispatchEvent(
						new CustomEvent('terrasync:terreno-error', {
							detail: { lat, lon, error: err.message || 'Error al analizar la coordenada' },
						})
					);
					if (alertaError) {
						alertaError.textContent = err.message || 'No se pudo conectar con la API de NASA POWER.';
						alertaError.classList.remove('d-none');
					}
				} finally {
					spinnerClima?.classList.add('d-none');
					if (btnAnalizar) {
						btnAnalizar.disabled = false;
					}
				}
			}

			inicializarGraficos();

			priorityButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					priorityButtons.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					if (selectPrioridad) {
						selectPrioridad.value = btn.getAttribute('data-priority-val') || 'suelo';
					}
					calcularYRenderizarRotacion(ultimoClima);
				});
			});

			window.addEventListener('terrasync:location-change', (e) => {
				const { lat, lon } = e.detail;
				consultarParcela(lat, lon);
			});

			// Recalcular costos y recomendaciones al cambiar el cultivo actual o el área/unidad del lote (incluso antes de que responda NASA)
			const menuCultivosMovil = document.getElementById('menu-cultivos-movil');
			const btnCerrarMenuCultivos = document.getElementById('btn-cerrar-menu-cultivos');
			const grupoSelectorCultivo = document.getElementById('grupo-selector-cultivo');
			const itemsCultivoMovil = document.querySelectorAll('.ts-item-cultivo-movil');

			const actualizarResaltadoMenuMovil = () => {
				const actual = selectCultivo?.value || 'papa';
				itemsCultivoMovil.forEach((btn) => {
					const activo = btn.getAttribute('data-crop-select-id') === actual;
					btn.style.background = activo ? '#fef3c7' : 'transparent';
					btn.style.borderLeft = activo ? '3px solid #f5b041' : 'none';
				});
			};

			const recalcularAlInstante = () => {
				actualizarResaltadoMenuMovil();
				calcularYRenderizarRotacion(ultimoClima);
			};
			selectCultivo?.addEventListener('change', recalcularAlInstante);
			selectCultivo?.addEventListener('input', recalcularAlInstante);
			inputAreaLote?.addEventListener('input', recalcularAlInstante);
			selectUnidadArea?.addEventListener('change', recalcularAlInstante);

			// En pantallas móviles / emulador táctil (< 992px), abrir el selector táctil personalizado para evitar el bloqueo del <select> nativo
			grupoSelectorCultivo?.addEventListener('mousedown', (e) => {
				if (window.innerWidth < 992 && menuCultivosMovil) {
					e.preventDefault();
					actualizarResaltadoMenuMovil();
					menuCultivosMovil.classList.toggle('d-none');
				}
			});
			grupoSelectorCultivo?.addEventListener('click', (e) => {
				if (window.innerWidth < 992 && menuCultivosMovil) {
					e.preventDefault();
					actualizarResaltadoMenuMovil();
					menuCultivosMovil.classList.remove('d-none');
				}
			});
			btnCerrarMenuCultivos?.addEventListener('click', () => {
				menuCultivosMovil?.classList.add('d-none');
			});
			itemsCultivoMovil.forEach((btn) => {
				btn.addEventListener('click', () => {
					const cropId = btn.getAttribute('data-crop-select-id');
					if (cropId && selectCultivo) {
						selectCultivo.value = cropId;
						selectCultivo.dispatchEvent(new Event('change', { bubbles: true }));
						menuCultivosMovil?.classList.add('d-none');
					}
				});
			});
			document.addEventListener('click', (e) => {
				if (
					menuCultivosMovil &&
					!menuCultivosMovil.classList.contains('d-none') &&
					!e.target.closest('#grupo-selector-cultivo') &&
					!e.target.closest('#menu-cultivos-movil')
				) {
					menuCultivosMovil.classList.add('d-none');
				}
			});

			function aplicarTraduccionesSelectorYClima() {
				const en = esIngles();
				const mesesLargos = obtenerMesesLargos();
				const nomMesActual = mesesLargos[mesActualNum - 1];
				const anioActual = fechaHoy.getFullYear();

				if (chipFechaActual) {
					chipFechaActual.textContent = `📅 ${nomMesActual} ${anioActual}`;
				}

				// Traducir optgroups y opciones de #select-cultivo
				if (selectCultivo) {
					selectCultivo.querySelectorAll('optgroup').forEach((og) => {
						const origLabel = og.getAttribute('data-orig-label') || og.label;
						if (!og.hasAttribute('data-orig-label')) {
							og.setAttribute('data-orig-label', origLabel);
						}
						const limpio = origLabel.replace('📍 ', '').trim();
						og.label = `📍 ${obtenerMacroregion(limpio)}`;
					});
					selectCultivo.querySelectorAll('option').forEach((opt) => {
						const cObj = catalogoCultivos.find((c) => c.id === opt.value);
						if (cObj) {
							opt.textContent = `${obtenerNombreCultivo(cObj)} — [${obtenerFamiliaCultivo(cObj.familia)}]`;
						}
					});
				}

				// Traducir menú móvil de cultivos
				if (menuCultivosMovil) {
					menuCultivosMovil.querySelectorAll('.px-3.py-1.small.fw-bold').forEach((hdr) => {
						const orig = hdr.getAttribute('data-orig-macro') || hdr.textContent.trim();
						if (!hdr.hasAttribute('data-orig-macro')) {
							hdr.setAttribute('data-orig-macro', orig);
						}
						const limpio = orig.replace('📍 ', '').trim();
						hdr.textContent = `📍 ${obtenerMacroregion(limpio)}`;
					});
					itemsCultivoMovil.forEach((btn) => {
						const cId = btn.getAttribute('data-crop-select-id');
						const cObj = catalogoCultivos.find((c) => c.id === cId);
						if (cObj) {
							const spans = btn.querySelectorAll('span');
							if (spans[0]) spans[0].textContent = obtenerNombreCultivo(cObj);
							if (spans[1]) spans[1].textContent = obtenerFamiliaCultivo(cObj.familia);
						}
					});
				}

				// Traducir KPIs climáticos y gráficos si ya hay datos
				if (ultimoClima?.promedios) {
					const temp = ultimoClima.promedios.tempMax;
					const lluvia = ultimoClima.promedios.lluviaTotalAnual;
					if (kpiPisoTermico) {
						let piso = en ? 'Temperate' : 'Templado';
						if (temp <= 5) piso = en ? 'Polar / Nival' : 'Polar / Nival';
						else if (temp < 12) piso = en ? 'Paramo' : 'Páramo';
						else if (temp <= 22) piso = en ? 'Andean Cold' : 'Frío Andino';
						else if (temp <= 28) piso = en ? 'Temperate' : 'Templado';
						else piso = en ? 'Warm' : 'Cálido';
						kpiPisoTermico.textContent = piso;
					}
					if (kpiRegimenLluvia) {
						let reg = en ? 'Subhumid' : 'Subhúmedo';
						if (lluvia < 120) reg = en ? 'Hyperarid' : 'Hiperárido';
						else if (lluvia < 650) reg = en ? 'Dry' : 'Seco';
						else if (lluvia <= 1400) reg = en ? 'Moderate' : 'Moderado';
						else reg = en ? 'Humid' : 'Húmedo';
						kpiRegimenLluvia.textContent = reg;
					}
					if (diagnosticoClimatico) {
						diagnosticoClimatico.textContent = en
							? `${temp} °C avg max | ${lluvia} mm/yr`
							: `${temp} °C máx. prom | ${lluvia} mm/año`;
					}
				}

				if (ultimoClima?.mensual) {
					actualizarGraficos(ultimoClima.mensual);
				} else if (chartLluvia && chartTemp) {
					const labels = obtenerMesesCortos();
					chartLluvia.data.labels = labels;
					chartLluvia.data.datasets[0].label = en ? 'Monthly rainfall (mm)' : 'Lluvia mensual (mm)';
					chartLluvia.update();
					chartTemp.data.labels = labels;
					chartTemp.data.datasets[0].label = en ? 'Avg. max temp (°C)' : 'Temp. máx promedio (°C)';
					chartTemp.update();
				}

				if (ultimoClima) {
					renderizarPanelFaoGaez(ultimoClima);
				}
				calcularYRenderizarRotacion(ultimoClima);
			}

			window.addEventListener('terrasoft:lang-change', () => {
				aplicarTraduccionesSelectorYClima();
			});

			// Renderizado inicial inmediato con el cultivo seleccionado por defecto y el idioma activo
			aplicarTraduccionesSelectorYClima();

