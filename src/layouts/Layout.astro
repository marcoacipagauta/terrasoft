---
import { TERRASOFT_I18N } from '../i18n/translations';

interface Props {
	title?: string;
}

const { title = 'TerraSoft - Datos Espaciales para Decisiones en tu Campo' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Bootstrap 5.3 CSS CDN -->
		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
			rel="stylesheet"
			integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
			crossorigin="anonymous"
		/>

		<style is:global>
			:root {
				--ts-space-dark: #071428;
				--ts-space-mid: #0d2647;
				--ts-space-light: #163a66;
				--ts-amber: #f5b041;
				--ts-amber-hover: #e59822;
				--ts-cyan: #38bdf8;
				--ts-cyan-soft: #e0f2fe;
				--ts-emerald: #10b981;
				--ts-bg: #eef2f6;
			}
			html {
				scroll-behavior: smooth;
				overflow-x: clip;
				width: 100%;
				max-width: 100vw;
			}
			body {
				background-color: var(--ts-bg);
				color: #0f172a;
				font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
				overflow-x: clip;
				width: 100%;
				max-width: 100vw;
				position: relative;
			}
			#simulador-rotacion {
				overflow-x: clip;
				max-width: 100vw;
			}

			/* 1. NAVBAR ESPACIAL (#071428) */
			.ts-navbar-space {
				background: linear-gradient(90deg, #061121 0%, #0b213f 100%);
				border-bottom: 1px solid rgba(56, 189, 248, 0.22);
			}
			.ts-navbar-space .nav-link {
				color: rgba(255, 255, 255, 0.82);
				font-size: 0.88rem;
				font-weight: 500;
				padding: 0.45rem 0.9rem;
				border-radius: 999px;
				transition: color 0.15s ease, background 0.15s ease;
			}
			.ts-navbar-space .nav-link:hover,
			.ts-navbar-space .nav-link.active {
				color: #f5b041;
				background: rgba(255, 255, 255, 0.08);
			}
			.ts-btn-amber {
				background: linear-gradient(135deg, #f5b041 0%, #ea9c1b 100%);
				color: #071428 !important;
				font-weight: 700;
				border: none;
				border-radius: 999px;
				padding: 0.48rem 1.25rem;
				box-shadow: 0 4px 14px rgba(245, 176, 65, 0.35);
				transition: transform 0.16s ease, box-shadow 0.16s ease;
			}
			.ts-btn-amber:hover {
				transform: translateY(-1px);
				box-shadow: 0 6px 20px rgba(245, 176, 65, 0.55);
			}
			.ts-btn-space {
				background: linear-gradient(135deg, #0b213f 0%, #163a66 100%);
				color: #ffffff !important;
				border: 1px solid rgba(56, 189, 248, 0.35);
				font-weight: 600;
			}
			.ts-btn-space:hover {
				background: linear-gradient(135deg, #102c52 0%, #1d497d 100%);
				border-color: #f5b041;
			}

			/* 2. PORTADA INICIAL A PANTALLA COMPLETA (HERO + 3 SECCIONES) */
			.ts-landing-view {
				min-height: calc(100vh - 54px);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				background: #061121;
			}
			.ts-hero {
				position: relative;
				flex: 1 1 auto;
				display: flex;
				align-items: center;
				background-color: #061121;
				background-image:
					radial-gradient(circle at 22% 36%, rgba(6, 17, 33, 0.78) 0%, rgba(6, 17, 33, 0.32) 48%, rgba(6, 17, 33, 0.05) 78%),
					linear-gradient(180deg, rgba(6, 17, 33, 0.35) 0%, rgba(6, 17, 33, 0) 45%, rgba(6, 17, 33, 0.25) 100%),
					url('/images/hero-space-agro.jpg');
				background-size: cover;
				background-position: center 38%;
				color: #ffffff;
				padding: 2.5rem 0 5.5rem 0;
				overflow: hidden;
			}
			.ts-hero-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				background: rgba(13, 38, 71, 0.72);
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
				border: 1px solid rgba(56, 189, 248, 0.45);
				color: #38bdf8;
				border-radius: 999px;
				padding: 0.35rem 0.9rem;
				font-size: 0.76rem;
				font-weight: 700;
				letter-spacing: 0.03em;
				text-transform: uppercase;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
			}
			.ts-hero-feature-pill {
				background: rgba(13, 38, 71, 0.68);
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
				border: 1px solid rgba(255, 255, 255, 0.22);
				border-radius: 0.65rem;
				padding: 0.48rem 0.85rem;
				color: #ffffff;
				font-size: 0.8rem;
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
			}

			/* 3. TRÍO DE SECCIONES INFORMATIVAS EN PORTADA INICIAL */
			.ts-bridge-wrap {
				position: relative;
				z-index: 15;
				margin-top: -4.2rem;
				padding-bottom: 1.5rem;
				background: linear-gradient(180deg, rgba(6, 17, 33, 0) 0%, #eef2f6 55%);
			}
			.ts-bridge-card {
				width: 100%;
				height: 100%;
				border-radius: 1.1rem;
				transition: transform 0.22s ease, box-shadow 0.22s ease;
				overflow: hidden;
				text-decoration: none;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				min-height: 152px;
				position: relative;
				text-align: center;
			}
			/* Card Izquierda (Monitoreo Satelital — Punto de Inicio): Blanca con Borde Destacado */
			.ts-bridge-left {
				background: #ffffff;
				color: #0b213f;
				border: 2px solid #f5b041;
				box-shadow: 0 16px 36px rgba(7, 20, 40, 0.18);
			}
			.ts-bridge-left:hover {
				transform: translateY(-4px);
				box-shadow: 0 20px 42px rgba(245, 176, 65, 0.28);
			}
			/* Card Central (Informativa): Marco Azul Espacial Profundo con Fotografía de Surcos */
			.ts-bridge-center {
				position: relative;
				background:
					linear-gradient(180deg, rgba(7, 20, 40, 0.55) 0%, rgba(7, 20, 40, 0.82) 100%),
					url('/images/card-rotacion.jpg') center/cover no-repeat;
				color: #ffffff;
				border: 6px solid #0b213f;
				box-shadow: 0 18px 38px rgba(7, 20, 40, 0.28);
				margin-top: -5px;
			}
			/* Card Derecha (Informativa): Translúcida sobre Campo Dorado */
			.ts-bridge-right {
				background:
					linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(235, 244, 238, 0.85) 100%),
					url('/images/card-cultivos.jpg') center/cover no-repeat;
				backdrop-filter: blur(8px);
				color: #071428;
				border: 2px solid rgba(255, 255, 255, 0.85);
				box-shadow: 0 14px 32px rgba(7, 20, 40, 0.14);
			}

			/* 4. MODO PANTALLA COMPLETA DE SECCIÓN Y STEPPER DE AVANCE/RETROCESO */
			.ts-fullscreen-workspace {
				min-height: calc(100vh - 54px);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding-top: 0.75rem;
				padding-bottom: 0.75rem;
			}
			.ts-wizard-step-btn {
				border: 1px solid rgba(56, 189, 248, 0.35);
				background: rgba(255, 255, 255, 0.08);
				color: rgba(255, 255, 255, 0.82);
				font-size: 0.8rem;
				font-weight: 600;
				border-radius: 999px;
				padding: 0.38rem 0.9rem;
				transition: all 0.18s ease;
			}
			.ts-wizard-step-btn:hover {
				background: rgba(255, 255, 255, 0.18);
				color: #ffffff;
			}
			.ts-wizard-step-btn.active {
				background: linear-gradient(135deg, #f5b041 0%, #ea9c1b 100%);
				color: #071428 !important;
				border-color: #f5b041;
				font-weight: 800;
				box-shadow: 0 3px 12px rgba(245, 176, 65, 0.45);
			}
			.ts-master-pane {
				flex: 1 1 auto;
				display: flex;
				flex-direction: column;
				animation: tsFlashUpdate 0.24s ease-out;
			}

			/* 4. COMPONENTES DEL SIMULADOR CON PALETA AERO-AGRÍCOLA */
			.ts-topbar {
				position: sticky;
				top: 8px;
				z-index: 1020;
				background: linear-gradient(90deg, #071428 0%, #0e294b 100%);
				border: 1px solid rgba(56, 189, 248, 0.3) !important;
				color: #ffffff;
				border-radius: 0.9rem;
				box-shadow: 0 10px 26px rgba(7, 20, 40, 0.22) !important;
				overflow: visible !important;
			}
			@media (max-width: 991.98px) {
				.ts-topbar {
					position: relative;
					top: 0;
					z-index: 20;
				}
			}
			.ts-topbar .row > * {
				min-width: 0 !important;
				max-width: 100% !important;
			}
			.ts-topbar .input-group {
				min-width: 0 !important;
				max-width: 100% !important;
				flex: 1 1 0% !important;
				flex-wrap: nowrap !important;
			}
			.ts-topbar .form-select,
			.ts-topbar .form-control {
				width: 0 !important;
				flex: 1 1 0% !important;
				min-width: 0 !important;
				max-width: 100% !important;
				text-overflow: ellipsis;
				overflow: hidden;
				white-space: nowrap;
				touch-action: manipulation;
				cursor: pointer;
			}
			.ts-card {
				background: #ffffff;
				border: 1px solid rgba(14, 41, 75, 0.12);
				border-radius: 0.95rem;
				box-shadow: 0 6px 20px rgba(7, 20, 40, 0.06);
				transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
				overflow: hidden;
				min-width: 0;
			}
			.ts-card .badge {
				white-space: normal;
				max-width: 100%;
				line-height: 1.35;
			}
			.ts-card-header-space {
				background: linear-gradient(90deg, #08172e 0%, #102a4c 100%) !important;
				color: #ffffff !important;
				border-bottom: 2px solid #f5b041 !important;
			}
			.ts-card-top1 {
				border: 2px solid #0e294b !important;
				box-shadow: 0 10px 28px rgba(14, 41, 75, 0.14) !important;
				background: linear-gradient(180deg, #f4f9ff 0%, #ffffff 48%);
			}
			@keyframes tsFlashUpdate {
				0% {
					transform: translateY(3px);
					opacity: 0.65;
				}
				100% {
					transform: translateY(0);
					opacity: 1;
				}
			}
			.ts-animate-in {
				animation: tsFlashUpdate 0.28s ease-out forwards;
			}

			/* Botones de Prioridad en Barra Espacial */
			.ts-priority-btn {
				border: 1px solid rgba(56, 189, 248, 0.3);
				background: rgba(255, 255, 255, 0.08);
				color: rgba(255, 255, 255, 0.85);
				font-weight: 600;
				font-size: 0.83rem;
				padding: 0.42rem 0.75rem;
				transition: all 0.15s ease;
			}
			.ts-priority-btn,
			.ts-priority-btn:focus,
			.ts-priority-btn:focus-visible,
			.ts-priority-btn:active {
				--bs-btn-color: #ffffff;
				--bs-btn-hover-color: #ffffff;
				--bs-btn-active-color: #071428;
				color: #ffffff;
			}
			.ts-priority-btn:not(.active) {
				background: #163a66 !important;
				color: #ffffff !important;
				border-color: rgba(56, 189, 248, 0.55) !important;
			}
			.ts-priority-btn:not(.active):hover {
				background: #1e4d85 !important;
			}
			/* Texto legible en las listas desplegables del selector de cultivos */
			.ts-topbar select option,
			.ts-topbar select optgroup {
				background: #ffffff;
				color: #071428;
			}
			.ts-priority-btn.active {
				background: linear-gradient(135deg, #f5b041 0%, #ea9c1b 100%);
				color: #071428 !important;
				border-color: #f5b041;
				font-weight: 700;
				box-shadow: 0 2px 10px rgba(245, 176, 65, 0.4);
			}

			/* Cajas KPI NASA POWER */
			.ts-kpi-box {
				background: linear-gradient(180deg, #0b213f 0%, #112d54 100%);
				border: 1px solid rgba(56, 189, 248, 0.25);
				color: #ffffff;
				border-radius: 0.7rem;
				padding: 0.6rem 0.65rem;
			}

			/* Pestañas del Panel Derecho */
			.nav-pills .nav-link {
				color: rgba(255, 255, 255, 0.78);
				font-weight: 600;
				border-radius: 999px;
				padding: 0.42rem 0.95rem;
				font-size: 0.84rem;
			}
			.nav-pills .nav-link:hover {
				color: #ffffff;
				background: rgba(255, 255, 255, 0.1);
			}
			.nav-pills .nav-link.active {
				background: linear-gradient(135deg, #f5b041 0%, #ea9c1b 100%) !important;
				color: #071428 !important;
				font-weight: 700;
				box-shadow: 0 3px 10px rgba(245, 176, 65, 0.35);
			}

			/* Calendario de 12 Meses en Tarjetas */
			.ts-cal-badge {
				white-space: normal !important;
				text-align: left;
				line-height: 1.35;
				max-width: 100%;
				overflow-wrap: anywhere;
				word-break: break-word;
				display: inline-block;
			}
			.ts-cal-grid {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: 3px;
				width: 100%;
			}
			@media (max-width: 575.98px) {
				.ts-cal-grid {
					grid-template-columns: repeat(6, minmax(0, 1fr));
					gap: 4px;
				}
			}
			.ts-cal-month {
				text-align: center;
				font-size: 0.65rem;
				font-weight: 600;
				padding: 3px 1px;
				border-radius: 4px;
				background: #f1f5f9;
				color: #64748b;
				border: 1px solid #cbd5e1;
				position: relative;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.ts-cal-month.optimal {
				background: #0d2647;
				color: #38bdf8;
				border-color: #1e40af;
			}
			.ts-cal-month.current {
				outline: 2px solid #f5b041;
				outline-offset: 0px;
				font-weight: 800;
				background: #fef3c7;
				color: #92400e;
			}
			.ts-cal-month.optimal.current {
				background: #f5b041;
				color: #071428;
			}

			/* Panel de Costos en Pesos Colombianos */
			.ts-cost-panel {
				background: linear-gradient(90deg, #f0f6ff 0%, #f8fafc 100%);
				border: 1px solid #bfdbfe;
				border-left: 4px solid #0d2647;
				border-radius: 0.6rem;
				padding: 0.6rem 0.8rem;
			}

			/* Conmutador de Idioma (ES | EN) en Navbar */
			.ts-lang-switch {
				display: inline-flex;
				align-items: center;
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(56, 189, 248, 0.45);
				border-radius: 999px;
				padding: 2px;
				cursor: pointer;
				user-select: none;
			}
			.ts-lang-opt {
				padding: 2px 9px;
				border-radius: 999px;
				font-size: 0.74rem;
				font-weight: 700;
				color: rgba(255, 255, 255, 0.72);
				transition: all 0.16s ease;
			}
			.ts-lang-opt.active {
				background: linear-gradient(135deg, #f5b041 0%, #ea9c1b 100%);
				color: #071428;
				box-shadow: 0 2px 8px rgba(245, 176, 65, 0.4);
			}
		</style>
	</head>
	<body class="min-vh-100 d-flex flex-column" data-i18n-dict={JSON.stringify(TERRASOFT_I18N)}>
		<nav class="navbar navbar-dark ts-navbar-space py-2 shadow-sm">
			<div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
				<a
					class="navbar-brand fw-bold d-flex align-items-center gap-2 mb-0"
					href="#inicio"
					id="brand-terrasoft-home"
					title="Volver a la portada principal"
				>
					<span class="fs-4">🌱</span>
					<span>TerraSoft</span>
					<span class="badge rounded-pill bg-info bg-opacity-25 text-info border border-info border-opacity-50 fw-semibold d-none d-sm-inline" style="font-size: 0.68rem;">
						NASA POWER + FAO
					</span>
				</a>

				<div class="d-flex align-items-center gap-2 flex-wrap">
					<!-- Conmutador Instantáneo Español (ES) ⇄ Inglés (EN) -->
					<button
						type="button"
						id="btn-toggle-lang"
						class="ts-lang-switch border-0"
						title="Cambiar idioma / Switch language (Español ⇄ English)"
						aria-label="Cambiar idioma"
					>
						<span class="ts-lang-opt active" id="lang-opt-es">🇨🇴 ES</span>
						<span class="ts-lang-opt" id="lang-opt-en">🇺🇸 EN</span>
					</button>

					<button
						type="button"
						id="btn-volver-portada-nav"
						class="btn btn-outline-light btn-sm rounded-pill fw-semibold px-3 d-none"
						style="font-size: 0.8rem;"
						data-i18n="navBackHome"
					>
						🏠 Volver a Portada
					</button>
					<button
						type="button"
						id="btn-abrir-tutorial-nav"
						class="btn btn-outline-info btn-sm rounded-pill fw-semibold px-3"
						style="font-size: 0.8rem;"
						data-i18n="navGuide"
					>
						🧑‍🌾 Guía Don Terra
					</button>
				</div>
			</div>
		</nav>

		<main class="flex-grow-1 d-flex flex-column">
			<slot />
		</main>

		<footer class="text-white-50 border-top border-info border-opacity-25 py-3 mt-4" style="background: linear-gradient(90deg, #061121 0%, #0b213f 100%);">
			<div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-2 small">
				<span>🌱 <strong class="text-white">TerraSoft</strong> &mdash; <span data-i18n="footerSub">Observación Satelital NASA POWER, FAO GAEZ v4 &amp; Suelos de Colombia</span></span>
				<span class="text-info" data-i18n="footerRight">Catálogo Regional (24 Cultivos · Calendario y Presupuesto COP)</span>
			</div>
		</footer>

		<!-- Controlador Global Bilingüe (ES ⇄ EN) -->
		<script is:inline>
			(function () {
				const dictRaw = document.body?.dataset?.i18nDict;
				window.TERRASOFT_I18N = dictRaw ? JSON.parse(dictRaw) : { es: { ui: {} }, en: { ui: {} } };
				window.terrasoftLang = localStorage.getItem('terrasoft_lang') === 'en' ? 'en' : 'es';

				window.getTerraSoftLang = function () {
					return window.terrasoftLang || 'es';
				};

				window.aplicarTraduccionDOM = function (lang) {
					const idioma = lang === 'en' ? 'en' : 'es';
					window.terrasoftLang = idioma;
					localStorage.setItem('terrasoft_lang', idioma);
					document.documentElement.lang = idioma;

					const t = window.TERRASOFT_I18N[idioma]?.ui || {};
					document.querySelectorAll('[data-i18n]').forEach((el) => {
						const key = el.getAttribute('data-i18n');
						if (key && t[key] !== undefined) {
							el.textContent = t[key];
						}
					});
					document.querySelectorAll('[data-i18n-html]').forEach((el) => {
						const key = el.getAttribute('data-i18n-html');
						if (key && t[key] !== undefined) {
							el.innerHTML = t[key];
						}
					});

					const optEs = document.getElementById('lang-opt-es');
					const optEn = document.getElementById('lang-opt-en');
					optEs?.classList.toggle('active', idioma === 'es');
					optEn?.classList.toggle('active', idioma === 'en');

					window.dispatchEvent(
						new CustomEvent('terrasoft:lang-change', {
							detail: { lang: idioma },
						})
					);
				};

				document.addEventListener('DOMContentLoaded', () => {
					const btnLang = document.getElementById('btn-toggle-lang');
					btnLang?.addEventListener('click', () => {
						const nuevo = window.getTerraSoftLang() === 'es' ? 'en' : 'es';
						window.aplicarTraduccionDOM(nuevo);
					});
					if (window.terrasoftLang === 'en') {
						window.aplicarTraduccionDOM('en');
					}
				});
			})();
		</script>

		<!-- Bootstrap 5.3 JS Bundle CDN -->
		<script
			src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
			integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
			crossorigin="anonymous"
		></script>
	</body>
</html>
